# Supabase 대시보드 → Project Settings → API (또는 Connect) 에서 복사해 넣으세요.
# 이 파일을 복사해 이름을 .env.local 로 바꾼 뒤 값을 채웁니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key(sb_publishable_ 로 시작) 또는 anon public key
# ※ secret / service_role 키는 절대 넣지 마세요.
NEXT_PUBLIC_SUPABASE_KEY=
# (선택) 인터넷에 올린 사이트 주소 — 카카오톡 링크 미리보기에 쓰임. Vercel 에 올리면 비워 둬도 돼요.
# NEXT_PUBLIC_SITE_URL=https://shrek-math-hub.vercel.app
