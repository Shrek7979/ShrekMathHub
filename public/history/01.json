[{"date":"01-01","slug":"Bose","kind":"born","year":"1894","life":"1894–1974","name":"Satyendranath Bose","nameKo":"사티엔드라나트 보스","title":"보손에 이름을 남긴 인도의 보스","body":"인도 콜카타 출신의 수학자이자 물리학자예요. 1924년 플랑크의 복사 법칙을 새로운 통계적 방법으로 이끌어 낸 4쪽짜리 논문을 아인슈타인에게 보냈고, 아인슈타인은 이를 직접 독일어로 번역해 학술지에 실어 주었어요. 이 통계를 따르는 입자를 그의 이름을 따 '보손'이라고 불러요.","unit":"고 확률과 통계","classroom":"편지 한 통으로 아인슈타인을 움직인 보스 이야기로, 확률과 통계가 물리학의 핵심 도구라는 점을 보여 주세요.","art":"dice","event":"1801년 오늘, 이탈리아 천문학자 주세페 피아치가 왜소행성 세레스를 발견했어요.","born":[{"year":"1802","name":"Guglielmo Libri","slug":"Libri"},{"year":"1878","name":"Agner Erlang","slug":"Erlang"},{"year":"1886","name":"Alexander Barrie Grieve","slug":"Grieve"},{"year":"1889","name":"Eric Harold Neville","slug":"Neville"},{"year":"1894","name":"Satyendranath Bose","slug":"Bose"},{"year":"1905","name":"Stanisław Mazur","slug":"Mazur"},{"year":"1912","name":"Boris Vladimirovich Gnedenko","slug":"Gnedenko"},{"year":"1914","name":"Manuela Garín","slug":"Garin"},{"year":"1923","name":"Daniel Gorenstein","slug":"Gorenstein"},{"year":"1931","name":"Sergei Ivanovich Adian","slug":"Adian"}],"died":[{"year":"1748","name":"Johann Bernoulli","slug":"Bernoulli_Johann"},{"year":"1787","name":"Anastácio da Cunha","slug":"Cunha"},{"year":"1796","name":"Alexandre-Theophile Vandermonde","slug":"Vandermonde"},{"year":"1862","name":"Mikhail Vasilevich Ostrogradski","slug":"Ostrogradski"},{"year":"1884","name":"Charles Merrifield","slug":"Merrifield"},{"year":"1894","name":"Heinrich Hertz","slug":"Hertz_Heinrich"},{"year":"1966","name":"Friedrich Levi","slug":"Levi_Friedrich"},{"year":"1968","name":"Ugo Morin","slug":"Morin_Ugo"},{"year":"1977","name":"Robert Gillespie","slug":"Gillespie"},{"year":"1992","name":"Grace Hopper","slug":"Hopper"},{"year":"1994","name":"Ivor Etherington","slug":"Etherington"},{"year":"1995","name":"Eugene Paul Wigner","slug":"Wigner"},{"year":"1996","name":"Gertrude Blanch","slug":"Blanch"},{"year":"2006","name":"George G Lorentz","slug":"Lorentz_George"},{"year":"2020","name":"Walter Hayman","slug":"Hayman"},{"year":"2020","name":"János Aczél","slug":"Aczel"},{"year":"2023","name":"Martin Davis","slug":"Davis"},{"year":"2026","name":"Vladimir Aleksandrovich Marchenko","slug":"Marchenko"}]},{"date":"01-02","slug":"Clausius","kind":"born","year":"1822","life":"1822–1888","name":"Rudolf Clausius","nameKo":"루돌프 클라우지우스","title":"열역학의 기초를 놓은 클라우지우스","body":"독일의 물리학자이자 수학자로, 1850년에 발표한 열의 역학적 이론에 관한 논문이 그의 가장 유명한 업적이에요. 박사 논문에서는 하늘이 왜 파랗고 노을은 왜 붉은지를 수학으로 설명하려 했는데, 물리적 가정은 틀렸지만 앞선 누구보다 수학을 깊이 활용했다는 평가를 받아요.","unit":"공통","classroom":"틀린 가정에서도 좋은 수학이 나올 수 있었던 클라우지우스의 하늘색 연구로 '수학적 모델링'의 의미를 이야기해 보세요.","art":"conic","event":"1851년 오늘, 조지 불이 자신의 논리와 확률 이론을 책으로 펴내겠다는 편지를 윌리엄 톰슨에게 썼어요.","born":[{"year":"1811","name":"Li Shanlan","slug":"Li_Shanlan"},{"year":"1822","name":"Rudolf Clausius","slug":"Clausius"},{"year":"1843","name":"James Stuart","slug":"Stuart"},{"year":"1896","name":"Leopold Pars","slug":"Pars"},{"year":"1905","name":"Lev Shnirelman","slug":"Shnirelman"},{"year":"1931","name":"James Murray","slug":"Murray"},{"year":"1938","name":"Anatoly Mykhailovych Samoilenko","slug":"Samoilenko"},{"year":"1940","name":"Srinivasa Varadhan","slug":"Varadhan"}],"died":[{"year":"1889","name":"Stephen Parkinson","slug":"Parkinson"},{"year":"1892","name":"George Airy","slug":"Airy"},{"year":"1930","name":"Charles Shirra Dougall","slug":"Dougall_Charles"},{"year":"1952","name":"Panagiotis Zervos","slug":"Zervos"},{"year":"1981","name":"Cora Ratto de Sadosky","slug":"Ratto_de_Sadosky"},{"year":"1992","name":"Brian Kuttner","slug":"Kuttner"},{"year":"1992","name":"Tibor Gallai","slug":"Gallai"}]},{"date":"01-03","slug":"Poinsot","kind":"born","year":"1777","life":"1777–1859","name":"Louis Poinsot","nameKo":"루이 푸앵소","title":"새로운 정다면체 넷을 찾은 푸앵소","body":"프랑스의 수학자로, 강체에 작용하는 여러 힘을 하나의 힘과 짝힘으로 정리하는 기하 역학을 만들었어요. 1809년 다면체 논문에서 새로운 정다면체 4개를 찾아냈는데, 그중 둘은 케플러가 1619년에 이미 다뤘다는 사실을 몰랐대요. 입학시험 대수 과목에서 낙제하고도 에콜 폴리테크니크에 들어간 일화도 있어요.","unit":"중1 입체도형","classroom":"정다면체가 다섯 가지뿐인 이유를 배운 뒤, '정다면체'의 정의를 조금 바꾸면 어떻게 될지 푸앵소의 발견으로 넓혀 보세요.","art":"euclid","event":"1657년 오늘, 페르마가 약수의 합에 관한 두 문제를 유럽과 영국의 수학자들에게 도전 과제로 냈어요.","born":[{"year":"1777","name":"Louis Poinsot","slug":"Poinsot"},{"year":"1788","name":"Enno Heeren Dirksen","slug":"Dirksen"},{"year":"1912","name":"Cora Ratto de Sadosky","slug":"Ratto_de_Sadosky"},{"year":"1917","name":"Yurii Alekseevich Mitropolskii","slug":"Mytropolsky"},{"year":"1921","name":"Jean-Louis Koszul","slug":"Koszul"},{"year":"1924","name":"Clive William Kilmister","slug":"Kilmister"},{"year":"1926","name":"David Spence","slug":"Spence_David"}],"died":[{"year":"1641","name":"Jeremiah Horrocks","slug":"Horrocks"},{"year":"1891","name":"John Casey","slug":"Casey"},{"year":"1892","name":"Heinrich Schröter","slug":"Schroeter"},{"year":"1912","name":"Jacob Amsler","slug":"Amsler"},{"year":"1920","name":"Zygmunt Janiszewski","slug":"Janiszewski"},{"year":"1927","name":"Carl Runge","slug":"Runge"},{"year":"1960","name":"Georges Darmois","slug":"Darmois"},{"year":"1972","name":"Władysław Ślebodziński","slug":"Slebodzinski"},{"year":"1989","name":"Sergei Sobolev","slug":"Sobolev"},{"year":"2004","name":"José Escobar","slug":"Escobar"},{"year":"2011","name":"Anatolii Volodymyrovych Skorokhod","slug":"Skorokhod"}]},{"date":"01-04","slug":"Newton","kind":"born","year":"1643","life":"1643–1727","name":"Isaac Newton","nameKo":"아이작 뉴턴","title":"미적분의 기초를 놓은 뉴턴","body":"미분과 적분의 기초를 놓았고, 광학과 만유인력 연구로 역사상 가장 위대한 과학자로 꼽히는 영국의 수학자예요. 태어날 때 영국에서 쓰던 달력으로는 1642년 크리스마스였지만, 지금 달력으로 고치면 1643년 1월 4일이에요. 학교 성적표에 '게으르고 산만하다'고 적힌 적도 있었대요.","unit":"고 미분","classroom":"달력에 따라 생일이 달라지는 뉴턴 이야기로 시작해, 미분이 '순간의 변화'를 다루는 도구임을 소개해 보세요.","art":"tangent","event":"1845년 오늘, 학위가 없던 벨라비티스가 경쟁 시험을 거쳐 파도바 대학 화법기하학 정교수가 되었어요.","born":[{"year":"1643","name":"Isaac Newton","slug":"Newton"},{"year":"1818","name":"Ole Jacob Broch","slug":"Broch"},{"year":"1848","name":"Heinrich Suter","slug":"Suter"},{"year":"1876","name":"Agnes Wells","slug":"Wells"},{"year":"1890","name":"Raymond Brink","slug":"Brink"},{"year":"1908","name":"Schieffelin Claytor","slug":"Claytor"},{"year":"1913","name":"Sixto Ríos","slug":"Rios"}],"died":[{"year":"1752","name":"Gabriel Cramer","slug":"Cramer"},{"year":"1826","name":"Nikolai Fuss","slug":"Fuss"},{"year":"1894","name":"William Oughter Lonie","slug":"Lonie"},{"year":"1904","name":"Anna Winlock","slug":"Winlock_Anna"},{"year":"1906","name":"Charles Joly","slug":"Joly"},{"year":"1950","name":"Virgil Snyder","slug":"Snyder"},{"year":"1958","name":"Archie Alexander","slug":"Alexander_Archie"},{"year":"1961","name":"Erwin Schrödinger","slug":"Schrodinger"},{"year":"1975","name":"Levan Gokieli","slug":"Gokieli"},{"year":"2005","name":"Frank Harary","slug":"Harary"},{"year":"2013","name":"James Ezeilo","slug":"Ezeilo"}]},{"date":"01-05","slug":"Lepaute","kind":"born","year":"1723","life":"1723–1788","name":"Nicole-Reine Lepaute","nameKo":"니콜레인 르포트","title":"핼리 혜성의 귀환을 계산한 르포트","body":"프랑스의 천문 계산가로, 1757년 랄랑드·클레로와 함께 핼리 혜성이 언제 돌아올지 계산했어요. 목성과 토성이 혜성을 끌어당기는 효과를 150년 치나 하나하나 따져야 해서, 여섯 달 동안 아침부터 밤까지 때로는 식사 중에도 계산했대요. 혜성은 예측 오차 범위 안인 1759년 4월에 근일점에 도달했어요.","unit":"공통","classroom":"컴퓨터가 없던 시절 손으로 혜성의 귀환을 계산한 르포트 이야기로, 정확한 계산이 예측을 가능하게 한다는 점을 보여 주세요.","art":"earth","event":"1874년 오늘, 칸토어가 데데킨트에게 정사각형과 선분의 점을 일대일로 대응시킬 수 있는지 물었어요.","born":[{"year":"1723","name":"Nicole-Reine Lepaute","slug":"Lepaute"},{"year":"1838","name":"Camille Jordan","slug":"Jordan"},{"year":"1865","name":"Julio Garavito","slug":"Garavito"},{"year":"1868","name":"Alice Bache Gould","slug":"Gould"},{"year":"1871","name":"Federigo Enriques","slug":"Enriques"},{"year":"1871","name":"Gino Fano","slug":"Fano"},{"year":"1884","name":"Arnaud Denjoy","slug":"Denjoy"},{"year":"1899","name":"György Alexits","slug":"Alexits"},{"year":"1909","name":"Stephen C Kleene","slug":"Kleene"},{"year":"1917","name":"Luna Isaac Mishoe","slug":"Mishoe"},{"year":"1942","name":"Alexandru Lupas","slug":"Lupas"},{"year":"1952","name":"Lai-Sang Young","slug":"Young_Lai-Sang"}],"died":[{"year":"1951","name":"Joseph Ritt","slug":"Ritt"},{"year":"1961","name":"Marília Peixoto","slug":"Peixoto_Marilia"},{"year":"1970","name":"Max Born","slug":"Born"},{"year":"1978","name":"Henry Jack","slug":"Jack_Henry"},{"year":"1987","name":"Josif Zakharovich Shtokalo","slug":"Shtokalo"},{"year":"1993","name":"Hanno Rund","slug":"Rund"},{"year":"1994","name":"David Bates","slug":"Bates"},{"year":"2013","name":"Marie-Hélène Schwartz","slug":"Schwartz_Marie-Helene"},{"year":"2024","name":"Bernard Malgrange","slug":"Malgrange"}]},{"date":"01-06","slug":"Bernoulli_Jacob","kind":"born","year":"1655","life":"1655–1705","name":"Jacob Bernoulli","nameKo":"야코프 베르누이","title":"'적분'이라는 말을 처음 쓴 베르누이","body":"스위스 바젤 출신의 수학자로 '적분'이라는 용어를 처음 사용했고, 매달린 줄이 이루는 곡선인 현수선과 극좌표를 연구했어요. 부모의 뜻에 따라 신학을 공부하면서도 몰래 수학과 천문학을 익혔어요. 동생 요한에게 수학을 가르쳤지만, 나중에는 서로 공개적으로 다투는 경쟁자가 되었어요.","unit":"고 적분","classroom":"정적분 단원을 열 때 '적분이라는 이름을 처음 붙인 사람은 누구일까?'라는 퀴즈로 야코프 베르누이를 소개해 보세요.","art":"riemann","event":"1699년 오늘, 뉴턴이 플램스티드에게 베르누이의 최단강하선 문제로 외국인에게 시달리기 싫다고 썼어요.","born":[{"year":"1561","name":"Thomas Fincke","slug":"Fincke"},{"year":"1655","name":"Jacob Bernoulli","slug":"Bernoulli_Jacob"},{"year":"1807","name":"Józeph Petzval","slug":"Petzval"},{"year":"1841","name":"Rudolf Sturm","slug":"Sturm_Rudolf"},{"year":"1883","name":"Francisco José Duarte","slug":"Duarte"},{"year":"1926","name":"Walter Hayman","slug":"Hayman"},{"year":"1934","name":"William Browder","slug":"Browder_William"},{"year":"1977","name":"Maria Chudnovsky","slug":"Chudnovsky"}],"died":[{"year":"1607","name":"Guidobaldo del Monte","slug":"Monte"},{"year":"1689","name":"Seth Ward","slug":"Ward_Seth"},{"year":"1826","name":"John Farey","slug":"Farey"},{"year":"1886","name":"Jean Claude Saint-Venant","slug":"Saint-Venant"},{"year":"1918","name":"Georg Cantor","slug":"Cantor"},{"year":"1920","name":"Hieronymus Georg Zeuthen","slug":"Zeuthen"},{"year":"1922","name":"Jakob Rosanes","slug":"Rosanes"},{"y