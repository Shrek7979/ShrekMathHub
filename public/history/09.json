[{"date":"09-01","slug":"Ceva_Giovanni","kind":"born","year":"1647","life":"1647–1734","name":"Giovanni Ceva","nameKo":"조반니 체바","title":"삼각형의 '체바 정리'를 남긴 체바","body":"조반니 체바는 평생 기하학을 연구한 이탈리아 밀라노 출신의 수학자예요. 1678년 책 『직선에 관하여』에서 삼각형의 세 꼭짓점과 마주 보는 변을 잇는 세 선분이 한 점에서 만날 조건을 밝혔어요. 각 변이 나뉜 비율을 모두 곱한 값이 1이면 세 선분이 한 점에서 만난다는 이 결과가 바로 '체바의 정리'예요.","unit":"중2 도형의 닮음","classroom":"삼각형의 세 중선이 한 점(무게중심)에서 만나는 까닭을 체바의 정리로 다시 확인해 보게 하세요.","art":"euclid","event":"1681년 오늘, 수학자 미켈란젤로 리치가 교황 인노첸시오 11세에게서 추기경으로 임명됐어요.","born":[{"year":"1647","name":"Giovanni Ceva","slug":"Ceva_Giovanni"},{"year":"1659","name":"Joseph Saurin","slug":"Saurin"},{"year":"1768","name":"Pietro Abbati Marescotti","slug":"Marescotti"},{"year":"1817","name":"Percival Frost","slug":"Frost"},{"year":"1835","name":"Stanley Jevons","slug":"Jevons"},{"year":"1882","name":"Henry Sheffer","slug":"Sheffer"},{"year":"1901","name":"George Temple","slug":"Temple"},{"year":"1906","name":"Ernst Peschl","slug":"Peschl"},{"year":"1910","name":"Pao Lu Hsu","slug":"Hsu"},{"year":"1932","name":"Jack van Lint","slug":"Van_Lint"}],"died":[{"year":"1648","name":"Marin Mersenne","slug":"Mersenne"},{"year":"1687","name":"Henry More","slug":"More_Henry"},{"year":"1716","name":"Heinrich Meissner","slug":"Meissner"},{"year":"1908","name":"Aleksandr Nikolaevich Korkin","slug":"Korkin"},{"year":"1927","name":"Emil Müller","slug":"Muller"},{"year":"1982","name":"Ludwig Bieberbach","slug":"Bieberbach"},{"year":"1982","name":"Haskell Curry","slug":"Curry"},{"year":"2008","name":"Oded Schramm","slug":"Schramm"}]},{"date":"09-02","slug":"McAfee","kind":"born","year":"1914","life":"1914–1995","name":"Walter Samuel McAfee","nameKo":"월터 맥아피","title":"달까지 레이더를 보낸 계산의 주인공","body":"월터 맥아피는 미국의 아프리카계 과학자이자 천문학자예요. 달에 레이더 신호를 튕겨 보내는 '다이애나 계획'에서 달까지의 거리와 돌아올 신호의 세기를 계산했어요. 1946년 1월 10일에 쏜 신호는 약 2.5초 뒤 메아리로 돌아왔지만, 공식 보고서에는 그의 이름조차 실리지 않았어요.","unit":"중1 문자와 식","classroom":"전파가 달까지 왕복하는 데 약 2.5초가 걸렸다는 사실과 빛의 속력으로 달까지의 거리를 어림해 보게 하세요.","art":"earth","event":"1752년 오늘 영국이 그레고리력을 도입해 다음 날이 9월 14일이 되자 '11일을 돌려 달라'는 소동이 벌어졌어요.","born":[{"year":"1841","name":"Hermann Laurent","slug":"Laurent_Hermann"},{"year":"1850","name":"Alfred Pringsheim","slug":"Pringsheim"},{"year":"1856","name":"Wilhelm Meyer","slug":"Meyer"},{"year":"1863","name":"Edvard Phragmén","slug":"Phragmen"},{"year":"1878","name":"Maurice Fréchet","slug":"Frechet"},{"year":"1903","name":"James Paton","slug":"Paton"},{"year":"1905","name":"William Guthrie","slug":"Guthrie"},{"year":"1909","name":"Deane Montgomery","slug":"Montgomery"},{"year":"1913","name":"Israil Gelfand","slug":"Gelfand"},{"year":"1914","name":"Walter Samuel McAfee","slug":"McAfee"},{"year":"1918","name":"Vincent McRae","slug":"McRae"},{"year":"1923","name":"René Thom","slug":"Thom"}],"died":[{"year":"1764","name":"Nathaniel Bliss","slug":"Bliss_Nathaniel"},{"year":"1768","name":"Antoine Deparcieux","slug":"Deparcieux"},{"year":"1854","name":"Pierre Laurent","slug":"Laurent_Pierre"},{"year":"1865","name":"William Rowan Hamilton","slug":"Hamilton"},{"year":"1915","name":"Elling Holst","slug":"Holst"},{"year":"1982","name":"Frederick Bath","slug":"Bath"},{"year":"2002","name":"Sheila Edmonds","slug":"Edmonds"}]},{"date":"09-03","slug":"Sylvester","kind":"born","year":"1814","life":"1814–1897","name":"James Joseph Sylvester","nameKo":"제임스 조지프 실베스터","title":"'판별식'이라는 이름을 붙인 실베스터","body":"제임스 조지프 실베스터는 행렬 이론에 중요한 업적을 남긴 영국의 수학자예요. 1851년 삼차방정식의 판별식을 발견했고, 더 높은 차수의 방정식에 '판별식'이라는 이름을 처음 썼어요. 1877년에는 미국 존스홉킨스 대학교로 건너가 미국 최초의 수학 학술지인 『미국 수학 저널』을 창간했어요.","unit":"중3 이차방정식","classroom":"이차방정식의 판별식 $b^2-4ac$를 배울 때, 이 이름을 처음 쓴 사람으로 실베스터를 소개해 보세요.","art":"algebra","event":"1457년 오늘, 포이어바흐가 월식을 관측해 그 중간 시각이 당시 천문표의 예측보다 8분 이르다는 것을 확인했어요.","born":[{"year":"1814","name":"James Joseph Sylvester","slug":"Sylvester"},{"year":"1868","name":"Charles Shirra Dougall","slug":"Dougall_Charles"},{"year":"1874","name":"Carl Størmer","slug":"Stormer"},{"year":"1884","name":"Solomon Lefschetz","slug":"Lefschetz"},{"year":"1908","name":"Lev Pontryagin","slug":"Pontryagin"}],"died":[{"year":"1967","name":"William Milne","slug":"Milne_William"},{"year":"1983","name":"Harold Sanders","slug":"Sanders_Harold"},{"year":"1984","name":"Wilhelm Winkler","slug":"Winkler"},{"year":"1996","name":"Bent Christiansen","slug":"Christiansen"},{"year":"2016","name":"Jean-Christophe Yoccoz","slug":"Yoccoz"},{"year":"2021","name":"David Borwein","slug":"Borwein"}]},{"date":"09-04","slug":"Menabrea","kind":"born","year":"1809","life":"1809–1896","name":"Luigi Menabrea","nameKo":"루이지 메나브레아","title":"배비지의 해석기관을 처음 글로 알린 공학자","body":"루이지 메나브레아는 탄성 이론에 기여한 군인이자 공학자로, 훗날 이탈리아 총리까지 지냈어요. 1840년 토리노에서 열린 배비지의 해석기관 강연을 정리해 1842년 논문으로 펴냈어요. 에이다 러브레이스가 이 논문을 번역하면서 긴 주석을 덧붙였고, 그 덕분에 해석기관의 작동 원리가 널리 알려졌어요.","unit":"공통","classroom":"수학자가 공학자, 총리로 살아간 이야기를 들려주며 수학이 다양한 진로로 이어진다는 점을 이야기해 보세요.","art":"turing","event":"1749년 오늘 볼테르는 편지에서, 뉴턴을 연구하던 에밀리 뒤 샤틀레가 책상에서 딸을 낳았다고 전했어요.","born":[{"year":"1809","name":"Luigi Menabrea","slug":"Menabrea"},{"year":"1848","name":"Heinrich Bruns","slug":"Bruns"},{"year":"1889","name":"Vyacheslaw Vassilievich Stepanov","slug":"Stepanov"},{"year":"1890","name":"Johannes van der Corput","slug":"Van_der_Corput"},{"year":"1899","name":"Hildegard Ille","slug":"Rothe-Ille"}],"died":[{"year":"1784","name":"César-François Cassini de Thury","slug":"Cassini_de_Thury"},{"year":"1969","name":"Marcel Riesz","slug":"Riesz_Marcel"},{"year":"1978","name":"Herbert Dingle","slug":"Dingle"},{"year":"1984","name":"Ernst Stueckelberg","slug":"Stueckelberg"},{"year":"1996","name":"Joan Clarke","slug":"Clarke_Joan"},{"year":"2011","name":"Hans Grauert","slug":"Grauert"}]},{"date":"09-05","slug":"Saccheri","kind":"born","year":"1667","life":"1667–1733","name":"Giovanni Saccheri","nameKo":"조반니 사케리","title":"평행선 공준을 증명하려 한 사케리","body":"조반니 사케리는 이탈리아의 예수회 신부이자 수학자예요. 1733년 『모든 흠에서 벗어난 유클리드』에서 평행선 공준을 증명하려 했는데, 그 과정에서 비유클리드 기하학의 초기 결과들을 얻었어요. 그는 사각형의 두 각이 직각·둔각·예각인 세 경우를 나눠 따졌지만, 자신이 새로운 기하학을 찾았다고는 생각하지 못했어요.","unit":"중1 기본 도형","classroom":"삼각형 내각의 합이 180°라는 사실이 평행선의 성질에 기대고 있음을 사케리의 시도와 함께 짚어 보세요.","art":"hyperbolic","event":"1938년 오늘, 유대계 사람들을 대학과 여러 기관에서 몰아낸 인종법이 통과되어 많은 수학자가 피해를 입었어요.","born":[{"year":"1667","name":"Giovanni Saccheri","slug":"Saccheri"},{"year":"1725","name":"Étienne Montucla","slug":"Montucla"},{"year":"1896","name":"Ivo Lah","slug":"Lah"},{"year":"1927","name":"William Moser","slug":"Moser_William"},{"year":"1932","name":"Donald Solitar","slug":"Solitar"}],"died":[{"year":"1575","name":"Frederico Commandino","slug":"Commandino"},{"year":"1906","name":"Ludwig Boltzmann","slug":"Boltzmann"},{"year":"1917","name":"Marian Smoluchowski","slug":"Smoluchowski"},{"year":"1921","name":"Alfonso Del Re","slug":"Del_Re"},{"year":"1959","name":"Kazimierz Zarankiewicz","slug":"Zarankiewicz"},{"year":"1972","name":"Tadeusz Ważewski","slug":"Wazewski"},{"year":"1982","name":"Edwin Beckenbach","slug":"Beckenbach"},{"year":"1994","name":"Shimshon Amitsur","slug":"Amitsur"},{"year":"2024","name":"Rhada Gupta","slug":"Gupta_Rhada"}]},{"date":"09-06","slug":"Kendall_Maurice","kind":"born","year":"1907","life":"1907–1983","name":"Maurice Kendall","nameKo":"모리스 켄들","title":"순위 상관을 연구한 통계학자 켄들","body":"모리스 켄들은 상관과 통계 이론에 크게 기여한 영국의 통계학자예요. 어릴 때 그래머스쿨 입학시험에 떨어지기도 했지만, 농림부에서 일하며 통계를 시작해 뛰어난 연구자가 되었어요. 1948년 펴낸 『순위 상관』은 1990년에 5판이 나올 만큼 오래 읽혔고, 『고급 통계 이론』도 그가 세상을 떠난 뒤까지 개정판이 이어졌어요.","unit":"중3 산점도와 상관관계","classroom":"반 학생들의 키 순위와 발 크기 순위를 비교해 보며 '순위로 보는 상관관계'를 체험하게 하세요.","art":"rose","event":"1822년 오늘, 야노시 보요이가 빈 공병학교를 뛰어난 성적으로 졸업했어요.","born":[{"year":"1859","name":"Boris Yakovlevic Bukreev","slug":"Bukreev"},{"year":"1863","name":"Dmitry Aleksandrovich Grave","slug":"Grave"},{"year":"1871","name":"Ernst Julius Amberg","slug":"Amberg"},{"year":"1902","name":"G Leslie Frewin","slug":"Frewin"},{"year":"1906","name":"Banesh Hoffmann","slug":"Hoffmann"},{"year":"1907","name":"Maurice Kendall","slug":"Kendall_Maurice"},{"year":"1920","name":"Sergei Stechkin","slug":"Stechkin"}],"died":[{"year":"1949","name":"James McBride","slug":"McBride"},{"year":"1951","name":"Winifred Edgerton Merrill","slug":"Merrill"},{"year":"1956","name":"Witold Hurewicz","slug":"Hurewicz"},{"year":"1967","name":"Albert Ingham","slug":"Ingham"},{"year":"1977","name":"J E Littlewood","slug":"Littlewood"},{"year":"2020","name":"Vaughan Jones","slug":"Jones_Vaughan"}]},{"date":"09-07","slug":"Buffon","kind":"born","year":"1707","life":"1707–1788","name":"Georges Buffon","nameKo":"조르주 뷔퐁","title":"바늘 던지기로 확률을 탐구한 뷔퐁","body":"조르주 뷔퐁은 박물학으로 이름난 프랑스의 과학자지만 수학에도 재능이 뛰어났어요. 막대를 어깨 너머로 던져 타일 바닥의 줄에 걸치는 횟수를 세는 실험으로 확률을 탐구했는데, 이것이 유명한 '뷔퐁의 바늘' 문제예요. 훗날 한 연구자는 이 실험을 2000번 되풀이해 원주율을 3.1430…으로 어림하기도 했어요.","unit":"중2 확률","classroom":"줄 간격이 일정한 종이 위에 이쑤시개를 여러 번 떨어뜨려 줄에 걸치는 비율을 구해 보는 실험을 해 보세요.","art":"dice","event":"1954년 오늘, 수학자 리 로치가 미 하원 비미활동위원회에 불려 가 공산당원인지 추궁받았어요.","born":[{"year":"1707","name":"Georges Buffon","slug":"Buffon"},{"year":"1819","name":"Jean-Claude Bouquet","slug":"Bouquet"},{"year":"1884","name":"Georges Valiron","slug":"Valiron"},{"year":"1901","name":"Richard Robb","slug":"Robb"},{"year":"1903","name":"Dudley Littlewood","slug":"Littlewood_Dudley"},{"year":"1915","name":"Kiyosi Ito","slug":"Ito"},{"year":"1924","name":"Nikolai Nikolaevich Krasovskii","slug":"Krasovskii"},{"year":"1948","name":"Cheryl Praeger","slug":"Praeger"},{"year":"1955","name":"Efim Zelmanov","slug":"Zelmanov"}],"died":[{"year":"1682","name":"Juan Caramuel","slug":"Caramuel"},{"year":"1918","name":"Ludwig Sylow","slug":"Sylow"},{"year":"1936","name":"Marcel Grossmann","slug":"Grossmann"},{"year":"1947","name":"Michele Cipolla","slug":"Cipolla"},{"year":"1951","name":"Harry Schmidt","slug":"Schmidt_Harry"},{"year":"1956","name":"Otto Yulyevich Schmidt","slug":"Schmidt_Otto"},{"year":"1985","name":"George Pólya","slug":"Polya"},{"year":"1994","name":"Abraham Gelbart","slug":"Gelbart"},{"year":"2003","name":"David Spence","slug":"Spence_David"},{"year":"2016","name":"Joseph Keller","slug":"Keller_Joseph"}]},{"date":"09-08","slug":"Mersenne","kind":"born","year":"1588","life":"1588–1648","name":"Marin Mersenne","nameKo":"마랭 메르센","title":"메르센 소수에 이름을 남긴 수도사","body":"마랭 메르센은 프랑스의 수도사로, 당대 학자들의 편지를 이어 준 '학문의 연락소' 역할로 유명해요. 오늘날에는 $2^p-1$ 꼴의 수인 메르센 소수로 더 널리 알려져 있어요. 1644년 그는 $p$가 257 이하일 때 이 수가 소수가 되는 경우를 제시했는데, 훗날 그중 다섯 군데가 틀렸다는 것이 밝혀졌어요.","unit":"중1 소인수분해","classroom":"$2^p-1$에 $p=2, 3, 5, 7, 11$을 넣어 소수인지 확인하며 규칙이 어디서 깨지는지 찾아보게 하세요.","art":"primes","event":"1965년 오늘, 세인트앤드루스 대학교 수학연구소 건물 공사가 첫 삽을 떴어요.","born":[{"year":"1584","name":"Gregory of Saint-Vincent","slug":"Saint-Vincent"},{"year":"1588","name":"Marin Mersenne","slug":"Mersenne"},{"year":"1634","name":"Hendrik van Heuraet","slug":"Heuraet"},{"year":"1799","name":"James Lindsay","slug":"Lindsay"},{"year":"1861","name":"P J Heawood","slug":"Heawood"},{"year":"1876","name":"Anderson McKendrick","slug":"McKendrick"},{"year":"1903","name":"C T Rajagopal","slug":"Rajagopal"},{"year":"1910","name":"Nathan Jacobson","slug":"Jacobson"},{"year":"1927","name":"Marguerite Straus Frank","slug":"Frank_Marguerite"}],"died":[{"year":"1882","name":"Joseph Liouville","slug":"Liouville"},{"year":"1894","name":"Hermann von Helmholtz","slug":"Helmholtz"},{"year":"1938","name":"Derrick Norman Lehmer","slug":"Lehmer_Derrick_N"},{"year":"1963","name":"Robert J T Bell","slug":"Bell_Robert"},{"year":"1969","name":"Gordon Whyburn","slug":"Whyburn"}]},{"date":"09-09","slug":"Browne","kind":"born","year":"1914","life":"1914–1979","name":"Marjorie Lee Browne","nameKo":"마저리 리 브라운","title":"흑인 여성 수학 박사의 길을 연 브라운","body":"마저리 리 브라운은 미국에서 수학 박사 학위를 받은 최초의 흑인 여성 가운데 한 명인 수학 교육자예요. 암산을 잘했던 아버지에게서 수학에 대한 사랑을 물려받았고, 1949년 미시간 대학교에서 박사 과정을 마쳤어요. 흑인과 여성에 대한 편견이 심하던 시대에도 최고 수준까지 수학을 공부하겠다는 꿈을 끝내 이뤘어요.","unit":"공통","classroom":"'수학자' 하면 떠오르는 모습을 그려 보게 한 뒤 브라운의 이야기를 들려주며 고정관념을 함께 생각해 보세요.","art":"letter","event":"1839년 오늘, 존 허셜이 처음으로 유리판 사진을 찍었어요.","born":[{"year":"1838","name":"Thomas Barker","slug":"Barker"},{"year":"1860","name":"Frank Morley","slug":"Morley"},{"year":"1914","name":"Marjorie Lee Browne","slug":"Browne"},{"year":"1956","name":"Avi Wigderson","slug":"Wigderson"}],"died":[{"year":"1883","name":"Victor Puiseux","slug":"Puiseux"},{"year":"1885","name":"Jean-Claude Bouquet","slug":"Bouquet"},{"year":"1973","name":"Giovanni Ricci","slug":"Ricci_Giovanni"},{"year":"2002","name":"José Luis Massera","slug":"Massera"},{"year":"2014","name":"Samuel Gitler","slug":"Gitler"},{"year":"2015","name":"Julián Adem","slug":"Adem_Julian"}]},{"date":"09-10","slug":"Rao","kind":"born","year":"1920","life":"1920–2023","name":"Calyampudi Radhakrishna Rao","nameKo":"C. R. 라오","title":"크라메르-라오 부등식의 통계학자","body":"C. R. 라오는 인도에서 태어나 생애 대부분을 미국에서 활동한 수학자이자 통계학자예요. 1945년 논문에서 추정값의 분산이 어느 한계보다 작아질 수 없음을 보여 주는 '크라메르-라오 부등식'을 제시했어요. 케임브리지에서 피셔의 지도를 받았고, 2002년 미국 국가과학훈장을 받았으며 102세까지 살았어요.","unit":"고 확률과 통계","classroom":"표본평균으로 모평균을 추정할 때 '얼마나 정확해질 수 있을까?'라는 질문을 라오의 연구와 연결해 보세요.","art":"rose","event":"2009년 오늘, 영국 총리가 앨런 튜링이 전쟁 뒤 받은 부당한 대우에 대해 정부를 대표해 공식 사과했어요.","born":[{"year":"1839","name":"Charles S Peirce","slug":"Peirce_Charles"},{"year":"1861","name":"Theodor Molien","slug":"Molin"},{"year":"1897","name":"William Greaves","slug":"Greaves"},{"year":"1900","name":"Frederick Bath","slug":"Bath"},{"year":"1903","name":"Georges de Rham","slug":"De_Rham"},{"year":"1920","name":"Calyampudi Radhakrishna Rao","slug":"Rao"},{"year":"1930","name":"Anatolii Volodymyrovych Skorokhod","slug":"Skorokhod"}],"died":[{"year":"1749","name":"Émilie du Châtelet","slug":"Chatelet"},{"year":"1915","name":"Howard Van Amringe","slug":"Amringe"},{"year":"1931","name":"Dimitri Fedorovich Egorov","slug":"Egorov"},{"year":"1936","name":"Kazimierz Abramowicz","slug":"Abramowicz"},{"year":"1941","name":"Fritz Noether","slug":"Noether_Fritz"},{"year":"1946","name":"Carruthers Beattie","slug":"Beattie"},{"year":"1946","name":"Georgii Vasilovich Pfeiffer","slug":"Pfeiffer"},{"year":"1966","name":"Emil Gumbel","slug":"Gumbel"},{"year":"1985","name":"Ernst Öpik","slug":"Opik"},{"year":"2005","name":"Hermann Bondi","slug":"Bondi"},{"year":"2014","name":"J Edward Nelson","slug":"Nelson_Edward"}]},{"date":"09-11","slug":"Sos","kind":"born","year":"1930","life":"1930–2023","name":"Vera Sós","nameKo":"베라 쇼시","title":"헝가리 조합론을 이끈 여성 수학자","body":"베라 쇼시는 정수론과 조합론을 연구한 헝가리의 수학자예요. 고등학교 시절 선생님 갈라이 덕분에 에르되시 같은 수학자들을 일찍 만났고, 대학 시절 스승이던 파울 투란과 결혼했어요. 투란 등과 함께 완전 이분 그래프를 그릴 때 생기는 선의 교차 횟수 문제를 연구해 큰 진전을 이뤘어요.","unit":"중2 경우의 수","classroom":"점 몇 개를 서로 선으로 이어 그려 보고, 선들이 가장 적게 교차하도록 배치하는 놀이로 조합론을 맛보게 하세요.","art":"graph","event":"1913년 오늘, 헨리 베이커가 영국과학진흥협회에서 '순수수학의 자리'를 주제로 강연했어요.","born":[{"year":"1798","name":"Franz Neumann","slug":"Neumann_Franz"},{"year":"1847","name":"Mary Whitney","slug":"Whitney_Mary"},{"year":"1877","name":"Luigi Brusotti","slug":"Brusotti"},{"year":"1877","name":"James Jeans","slug":"Jeans"},{"year":"1890","name":"Euphemia Lofton Haynes","slug":"Haynes"},{"year":"1916","name":"Zoltán Dienes","slug":"Dienes_Zoltan"},{"year":"1917","name":"Kenkichi Iwasawa","slug":"Iwasawa"},{"year":"1930","name":"Vera Sós","slug":"Sos"}],"died":[{"year":"1808","name":"José Mutis","slug":"Mutis"},{"year":"1843","name":"Jean-Nicolas Nicollet","slug":"Nicollet"},{"year":"1861","name":"Zacharias Dase","slug":"Dase"},{"year":"1890","name":"Felice Casorati","slug":"Casorati"},{"year":"1943","name":"Oswald Teichmüller","slug":"Teichmuller"},{"year":"1972","name":"Johannes de Groot","slug":"De_Groot"},{"year":"1995","name":"Margaret E Boyle","slug":"Boyle_Margaret"}]},{"date":"09-12","slug":"Wrinch","kind":"born","year":"1894","life":"1894–1976","name":"Dorothy Wrinch","nameKo":"도로시 린치","title":"수학으로 단백질 구조에 도전한 린치","body":"도로시 린치는 아르헨티나에서 태어나 영국과 미국에서 활동한 수학자이자 생화학자예요. 수학 기법으로 단백질의 구조를 밝히려 한 연구로 이름을 알렸어요. 1916년 케임브리지 거턴 칼리지의 유일한 수학 최우등 졸업생이 되었지만, 당시 신문은 최우등 졸업생 가운데 남성들의 약력만 실었어요.","unit":"공통","classroom":"수학이 생명과학 연구에 쓰인 예로 린치를 소개하고, 다른 과목에서 수학이 쓰이는 장면을 찾아보게 하세요.","art":"letter","event":"1859년 오늘, 르베리에가 수성 근일점 이동의 원인으로 미지의 행성 '불칸