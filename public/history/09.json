us"},{"year":"1877","name":"Urbain Le Verrier","slug":"Le_Verrier"},{"year":"1919","name":"Heinrich Bruns","slug":"Bruns"},{"year":"1938","name":"Maurice d'Ocagne","slug":"DOcagne"},{"year":"1971","name":"James Alexander","slug":"Alexander"},{"year":"1982","name":"Bella Abramovna Subbotovskaya","slug":"Subbotovskaya"},{"year":"1983","name":"Szolem Mandelbrojt","slug":"Mandelbrojt"},{"year":"1984","name":"Gheorghe Pic","slug":"Pic"}]},{"date":"09-24","slug":"Cardan","kind":"born","year":"1501","life":"1501–1576","name":"Girolamo Cardano","nameKo":"지롤라모 카르다노","title":"삼차방정식 해법을 세상에 알린 카르다노","body":"지롤라모 카르다노는 의사이자 수학자로, 대수학만 다룬 최초의 라틴어 책 『아르스 마그나』(1545)를 썼어요. 이 책에는 삼차방정식과 사차방정식의 풀이법이 실렸는데, 삼차방정식 해법은 그가 타르탈리아에게 발표하지 않겠다고 맹세하고 배운 것이었어요. 도박에 빠져 지내기도 했지만, 확률에 대한 이해 덕분에 지는 날보다 이기는 날이 많았다고 해요.","unit":"고 방정식","classroom":"이차방정식의 근의 공식처럼 삼차방정식에도 공식이 있을지 물으며 카르다노와 타르탈리아의 이야기를 들려주세요.","art":"cubic","event":"2017년 오늘, 마리나 비아조우스카가 8차원과 24차원 구 쌓기 문제를 풀어 클레이 연구상을 받았어요.","born":[{"year":"1501","name":"Girolamo Cardano","slug":"Cardan"},{"year":"1625","name":"Jan de Witt","slug":"De_Witt"},{"year":"1766","name":"John Farey","slug":"Farey"},{"year":"1801","name":"Mikhail Vasilevich Ostrogradski","slug":"Ostrogradski"},{"year":"1844","name":"Max Noether","slug":"Noether_Max"},{"year":"1861","name":"Robert Fricke","slug":"Fricke"},{"year":"1862","name":"Winifred Edgerton Merrill","slug":"Merrill"},{"year":"1894","name":"Werner Rogosinski","slug":"Rogosinski"},{"year":"1896","name":"Tadeusz Ważewski","slug":"Wazewski"},{"year":"1904","name":"Evan (Ianto) Davies","slug":"Davies"},{"year":"1911","name":"Menahem Schiffer","slug":"Schiffer"},{"year":"1923","name":"Raoul Bott","slug":"Bott"}],"died":[{"year":"1054","name":"Hermann of Reichenau","slug":"Hermann_of_Reichenau"},{"year":"1651","name":"Étienne Pascal","slug":"Pascal_Etienne"},{"year":"1938","name":"Lev Shnirelman","slug":"Shnirelman"},{"year":"1967","name":"Pauline Sperry","slug":"Sperry"},{"year":"1989","name":"Åke Pleijel","slug":"Pleijel"},{"year":"1999","name":"Anneli Lax","slug":"Lax_Anneli"}]},{"date":"09-25","slug":"Lambert","kind":"died","year":"1777","life":"1728–1777","name":"Johann Heinrich Lambert","nameKo":"요한 하인리히 람베르트","title":"π가 무리수임을 처음 엄밀히 증명하다","body":"요한 람베르트는 원주율 π가 무리수임을 처음으로 엄밀하게 증명한 수학자예요. 1768년 그는 $x$가 0이 아닌 유리수이면 $\\tan x$가 유리수일 수 없음을 보였고, $\\tan\\frac{\\pi}{4}=1$이므로 $\\frac{\\pi}{4}$가 무리수라는 결론을 이끌어 냈어요. 쌍곡선함수를 처음 체계적으로 다룬 사람이기도 해요.","unit":"중3 제곱근과 실수","classroom":"π의 소수점 아래 숫자를 길게 보여 주고 '언젠가 반복될까?'를 물은 뒤 람베르트의 증명을 소개해 보세요.","art":"pi-digits","event":"1988년 오늘, 수학자 파아 디 브루노가 교황 요한 바오로 2세에 의해 시복되었어요.","born":[{"year":"1819","name":"George Salmon","slug":"Salmon"},{"year":"1857","name":"Alexander Pell","slug":"Pell_Alexander"},{"year":"1888","name":"Stefan Mazurkiewicz","slug":"Mazurkiewicz"},{"year":"1893","name":"Harald Cramér","slug":"Cramer_Harald"},{"year":"1893","name":"Alexander Ostrowski","slug":"Ostrowski"},{"year":"1921","name":"John Quill Taylor King","slug":"King"},{"year":"1931","name":"Bryan Birch","slug":"Birch"}],"died":[{"year":"1777","name":"Johann Heinrich Lambert","slug":"Lambert"},{"year":"1828","name":"Barnabé Brisson","slug":"Brisson"},{"year":"1851","name":"Christoph Gudermann","slug":"Gudermann"},{"year":"1933","name":"Paul Ehrenfest","slug":"Ehrenfest"},{"year":"1955","name":"Franz Rellich","slug":"Rellich"},{"year":"2021","name":"Joachim Neubüser","slug":"Neubuser"}]},{"date":"09-26","slug":"Malfatti","kind":"born","year":"1731","life":"1731–1807","name":"Gianfrancesco Malfatti","nameKo":"잔프란체스코 말파티","title":"삼각형 속 세 원 문제의 말파티","body":"잔프란체스코 말파티는 기하, 확률, 역학을 연구하고 방정식 풀이에도 기여한 이탈리아의 수학자예요. 1802년 그는 삼각형 안에 서로 접하면서 각각 두 변에 접하는 세 원을 그리는 문제를 다루었는데, 이것이 '말파티 문제'예요. 1770년에는 오차방정식의 풀이 방법을 연구한 논문도 발표했어요.","unit":"중3 원의 성질","classroom":"삼각형 모양 종이 안에 동전 세 개를 서로 닿게 놓아 보며 말파티 문제를 직접 탐구하게 하세요.","art":"euclid","event":"1679년 오늘, 단치히에 있던 헤벨리우스 부부의 집과 천문대가 화재로 무너졌어요.","born":[{"year":"1688","name":"Willem 'sGravesande","slug":"SGravesande"},{"year":"1731