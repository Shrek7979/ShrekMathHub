[{"date":"07-01","slug":"Leibniz","kind":"born","year":"1646","life":"1646–1716","name":"Gottfried Leibniz","nameKo":"라이프니츠","title":"오늘날의 미적분 기호를 만든 라이프니츠","body":"독일의 라이프니츠는 철학자이자 수학자로, 지금 우리가 쓰는 미분과 적분의 기호를 만든 사람이에요. 다만 그는 도함수를 극한으로 생각하지는 않았어요. 14살에 라이프치히 대학에 들어갔고, 초기 계산 기계를 발명하기도 했어요.","unit":"고 미분","classroom":"미분 기호 dy/dx를 처음 쓸 때, 이 기호를 만든 사람이 라이프니츠라는 이야기를 곁들여 보세요.","art":"tangent","event":"1818년 오늘, 호너의 방정식 풀이법이 영국 왕립학회에 발표됐는데, 이 방법은 13세기 중국의 주세걸도 알고 있었어요.","born":[{"year":"1646","name":"Gottfried Leibniz","slug":"Leibniz"},{"year":"1788","name":"Jean-Victor Poncelet","slug":"Poncelet"},{"year":"1840","name":"Robert Ball","slug":"Ball_Robert"},{"year":"1906","name":"Jean Dieudonné","slug":"Dieudonne"},{"year":"1913","name":"Jack de Wet","slug":"De_Wet"},{"year":"1923","name":"Herman Chernoff","slug":"Chernoff"}],"died":[{"year":"1749","name":"William Jones","slug":"Jones"},{"year":"1872","name":"Fernando Pio Rosellini","slug":"Rosellini"},{"year":"1957","name":"Donald McIntosh","slug":"McIntosh"},{"year":"1963","name":"Bevan Braithwaite Baker","slug":"Bevan-Baker"},{"year":"1983","name":"R Buckminster Fuller","slug":"Fuller"},{"year":"2015","name":"Czesław Olech","slug":"Olech"}]},{"date":"07-02","slug":"Burnside","kind":"born","year":"1852","life":"1852–1927","name":"William Burnside","nameKo":"번사이드","title":"영어로 첫 군론 책을 쓴 번사이드","body":"영국의 번사이드는 영어로 된 최초의 군론 전문서를 쓰고, 군 이론을 현대적인 추상의 관점에서 처음 발전시킨 수학자예요. 여섯 살에 고아가 되었지만 장학금으로 케임브리지에 갔고, 조정 팀 1군에 들려고 칼리지를 옮겼다가 그곳의 응용수학 전통을 따라 연구의 방향이 정해졌어요. 1897년 『유한군론』을 펴냈어요.","unit":"공통","classroom":"정삼각형을 돌리거나 뒤집어 제자리에 놓는 방법이 몇 가지인지 세어 보며, 대칭을 다루는 군론과 번사이드를 소개해 보세요.","art":"symmetry","event":"1971년 오늘, 영국수학사학회가 템스 폴리테크닉(현 그리니치 대학)에서 첫 모임을 열었어요.","born":[{"year":"1622","name":"René de Sluze","slug":"Sluze"},{"year":"1646","name":"Choi Seok-jeong","slug":"Choi_Seok-jeong"},{"year":"1823","name":"Hugh Blackburn","slug":"Blackburn"},{"year":"1842","name":"George Thom","slug":"Thom_George"},{"year":"1847","name":"Andrew Gray","slug":"Gray_Andrew"},{"year":"1852","name":"William Burnside","slug":"Burnside"},{"year":"1889","name":"Doris Adams","slug":"Adams_Louise"},{"year":"1892","name":"Arnold Walfisz","slug":"Walfisz"},{"year":"1897","name":"Stanisława Nikodym","slug":"Nikodym_Stanislawa"},{"year":"1906","name":"Hans Bethe","slug":"Bethe"},{"year":"1914","name":"Mário Schenberg","slug":"Schenberg"},{"year":"1925","name":"Olga Arsenievna Oleinik","slug":"Oleinik"},{"year":"1926","name":"Rebeca Cherep de Guber","slug":"Guber"},{"year":"1927","name":"James Mackay","slug":"Mackay"}],"died":[{"year":"1613","name":"Bartholomeo Pitiscus","slug":"Pitiscus"},{"year":"1621","name":"Thomas Harriot","slug":"Harriot"},{"year":"1919","name":"Theodor Reye","slug":"Reye"},{"year":"1926","name":"Peter Ramsay","slug":"Ramsay"},{"year":"1947","name":"Nikolai Chebotaryov","slug":"Chebotaryov"},{"year":"2016","name":"Rudolf Kalman","slug":"Kalman"},{"year":"2021","name":"Dorothy Foster","slug":"Foster_Dorothy"}]},{"date":"07-03","slug":"Douglas","kind":"born","year":"1897","life":"1897–1965","name":"Jesse Douglas","nameKo":"제시 더글러스","title":"플라토 문제를 풀어 필즈상을 받은 더글러스","body":"미국의 더글러스는 주어진 경계로 둘러싸인 넓이가 가장 작은 곡면이 존재함을 보이는 '플라토 문제'를 완전히 풀었어요. 1760년 라그랑주가 제기한 뒤 리만, 바이어슈트라스 같은 대가들도 부분적으로만 풀었던 문제였어요. 이 업적으로 1936년 오슬로 국제수학자대회에서 필즈상을 받았어요.","unit":"고 미분","classroom":"철사 고리를 비눗물에 담갔다 빼면 생기는 막을 보여 주며 '넓이의 최솟값'이라는 생각과 연결해 보세요.","art":"medal","event":"1822년 오늘, 찰스 배비지가 영국 왕립학회에 차분기관에 대한 구상을 설명했어요.","born":[{"year":"1820","name":"Ernest de Jonquières","slug":"Jonquieres"},{"year":"1866","name":"Henry Baker","slug":"Baker"},{"year":"1897","name":"Jesse Douglas","slug":"Douglas"},{"year":"1908","name":"Archibald Macintyre","slug":"Macintyre_Archibald"},{"year":"1933","name":"Frederick Justin Almgren","slug":"Almgren"},{"year":"1934","name":"William Parry","slug":"Parry"},{"year":"1934","name":"Soraya Sherif","slug":"Sherif"},{"year":"1938","name":"Tom Blyth","slug":"Blyth"},{"year":"1945","name":"Saharon Shelah","slug":"Shelah"}],"died":[{"year":"1788","name":"François Jacquier","slug":"Jacquier"},{"year":"1970","name":"Samuel Beatty","slug":"Beatty"},{"year":"1984","name":"Raimundo Chela","slug":"Chela"},{"year":"1991","name":"Ernst Witt","slug":"Witt"},{"year":"1991","name":"Lê Văn Thiêm","slug":"Thiem"},{"year":"1999","name":"Pelageia Polubarinova Kochina","slug":"Kochina"},{"year":"2004","name":"Alberto Barajas","slug":"Barajas"}]},{"date":"07-04","slug":"Leavitt","kind":"born","year":"1868","life":"1868–1921","name":"Henrietta Swan Leavitt","nameKo":"헨리에타 레빗","title":"변광성으로 우주의 거리를 재게 한 레빗","body":"미국의 천문학자 레빗은 하버드 천문대에서 사진 건판을 분석하며 밝기가 변하는 별을 찾았어요. 그녀는 세페이드 변광성의 밝기가 변하는 주기와 밝기 사이의 관계를 발견했고, 이는 먼 은하까지의 거리를 재는 데 꼭 필요한 발판이 되었어요. 처음에는 보수 없이 천문대 일을 자원했어요.","unit":"중1 좌표평면과 그래프","classroom":"두 양 사이의 관계를 그래프로 나타내는 활동에서, 별의 주기와 밝기의 관계를 찾은 레빗을 예로 들어 보세요.","art":"earth","event":"1862년 오늘, 루이스 캐럴이 앨리스 리들 자매와 뱃놀이하며 들려준 이야기가 훗날 『이상한 나라의 앨리스』가 되었어요.","born":[{"year":"1788","name":"Fearon Fallows","slug":"Fallows"},{"year":"1868","name":"Henrietta Swan Leavitt","slug":"Leavitt"},{"year":"1906","name":"Daniel Rutherford","slug":"Rutherford"},{"year":"1917","name":"Moshe Livsic","slug":"Livsic"},{"year":"1923","name":"Dan Mostow","slug":"Mostow"},{"year":"1928","name":"Jürgen Moser","slug":"Moser_Jurgen"}],"died":[{"year":"1742","name":"Guido Grandi","slug":"Grandi"},{"year":"1901","name":"P G Tait","slug":"Tait"},{"year":"1954","name":"Eustachy Żyliński","slug":"Zylinski"},{"year":"1956","name":"Bernard Childs","slug":"Childs"},{"year":"1962","name":"T J J See","slug":"See"},{"year":"1981","name":"Niels Norlund","slug":"Norlund"},{"year":"1986","name":"Oscar Zariski","slug":"Zariski"},{"year":"1990","name":"Marshall Hall Jr","slug":"Hall_Marshall"},{"year":"1993","name":"Alston Householder","slug":"Householder"},{"year":"2002","name":"Laurent Schwartz","slug":"Schwartz"},{"year":"2006","name":"Nathan Mendelsohn","slug":"Mendelsohn"}]},{"date":"07-05","slug":"Rankine","kind":"born","year":"1820","life":"1820–1872","name":"William Rankine","nameKo":"랭킨","title":"역학과 열역학을 공학에 이은 랭킨","body":"스코틀랜드의 랭킨은 역학, 열역학, 파동 등 응용수학의 여러 분야를 연구한 공학자예요. 글래스고 대학의 토목공학·역학 교수로 이론과 실제의 조화를 강조했고, 『응용역학 편람』 같은 교재를 남겼어요. 미터법에 반대하는 유머러스한 시 「3피트 자」를 쓰기도 했어요.","unit":"공통","classroom":"단위 환산 문제를 풀 때, 미터법에 반대하는 시까지 쓴 공학자 랭킨 이야기로 단위 통일의 의미를 생각해 보게 하세요.","art":"conic","event":"1687년 오늘, 아이작 뉴턴의 『프린키피아』가 출판되었어요.","born":[{"year":"1787","name":"John Cruickshank","slug":"Cruickshank"},{"year":"1820","name":"William Rankine","slug":"Rankine"},{"year":"1865","name":"Benjamin Franklin Finkel","slug":"Finkel"},{"year":"1933","name":"Jean-Paul Pier","slug":"Pier"}],"died":[{"year":"1926","name":"Scott Lang","slug":"Scott_Lang"},{"year":"1932","name":"René Baire","slug":"Baire"},{"year":"1942","name":"Oskar Bolza","slug":"Bolza"},{"year":"1977","name":"Henry Scheffé","slug":"Scheffe"}]},{"date":"07-06","slug":"Collatz","kind":"born","year":"1910","life":"1910–1990","name":"Lothar Collatz","nameKo":"콜라츠","title":"풀리지 않은 3n+1 문제를 낸 콜라츠","body":"독일의 콜라츠는 수치해석을 주로 연구했지만, 1937년에 제안한 '콜라츠 문제'로 더 널리 알려졌어요. 홀수면 $3n+1$, 짝수면 $n/2$로 바꾸는 일을 되풀이하면 어떤 자연수에서 시작해도 결국 1에 이르는지 묻는 문제인데, 아주 큰 수까지 확인됐을 뿐 아직 풀리지 않았어요.","unit":"고 수열","classroom":"학생마다 다른 자연수로 시작해 3n+1 규칙을 적용하고, 1에 닿기까지 몇 단계 걸리는지 겨뤄 보게 하세요.","art":"sum","event":"1708년 오늘, 드무아브르가 요한 베르누이에게 원주율을 구하는 마친의 급수에 대한 편지를 썼어요.","born":[{"year":"1849","name":"Alfred Kempe","slug":"Kempe"},{"year":"1904","name":"Alexander Buchan","slug":"Buchan"},{"year":"1910","name":"Lothar Collatz","slug":"Collatz"},{"year":"1917","name":"Henry Jack","slug":"Jack_Henry"},{"year":"1928","name":"Bernard Malgrange","slug":"Malgrange"},{"year":"1929","name":"Jock Hoe","slug":"Hoe"},{"year":"1945","name":"Leon Simon","slug":"Simon"}],"died":[{"year":"1476","name":"Regiomontanus","slug":"Regiomontanus"},{"year":"1854","name":"Georg Simon Ohm","slug":"Ohm"},{"year":"1959","name":"Agnes Wells","slug":"Wells"},{"year":"2013","name":"Ismail Mohamed","slug":"Mohamed"},{"year":"2020","name":"Ronald Graham","slug":"Graham"}]},{"date":"07-07","slug":"Feller","kind":"born","year":"1906","life":"1906–1970","name":"William Feller","nameKo":"펠러","title":"확률론의 표준 교과서를 쓴 펠러","body":"크로아티아 자그레브에서 태어난 미국 수학자 펠러는 확률론을 연구했고, 이 분야의 표준이 된 책의 저자로 가장 잘 알려져 있어요. 괴팅겐에서 쿠란트의 지도로 겨우 스무 살에 박사 논문을 완성했어요. 나치 서약을 거부하고 독일을 떠나 코펜하겐과 스톡홀름에서 연구를 이어 갔어요.","unit":"고 확률과 통계","classroom":"확률 단원을 시작할 때, 교과서 한 권으로 한 분야의 기준을 세운 펠러를 소개하며 '좋은 책'의 힘을 이야기해 보세요.","art":"dice","event":"1887년 오늘, 마이컬슨과 몰리가 에테르를 검출하려는 간섭계 실험을 시작했고, 그 결과는 특수 상대성 이론을 뒷받침했어요.","born":[{"year":"1816","name":"Rudolf Wolf","slug":"Wolf"},{"year":"1845","name":"Eduard Gubler","slug":"Gubler"},{"year":"1883","name":"Margaret Barr Moir","slug":"Moir"},{"year":"1888","name":"Archibald Goldie","slug":"Goldie"},{"year":"1901","name":"Mary Simpson","slug":"Simpson_Mary"},{"year":"1905","name":"Marie-Louise Dubreil-Jacotin","slug":"Dubreil-Jacotin"},{"year":"1906","name":"William Feller","slug":"Feller"},{"year":"1906","name":"Gheorghe Mihoc","slug":"Mihoc"},{"year":"1922","name":"Vladimir Aleksandrovich Marchenko","slug":"Marchenko"}],"died":[{"year":"1900","name":"Eduard Wiltheiss","slug":"Wiltheiss"},{"year":"1922","name":"Jacques Bertillon","slug":"Bertillon"},{"year":"1927","name":"Gösta Mittag-Leffler","slug":"Mittag-Leffler"},{"year":"1942","name":"William Young","slug":"Young"},{"year":"1947","name":"Alfred Rosenblatt","slug":"Rosenblatt"},{"year":"1967","name":"Anatoly Malcev","slug":"Malcev"},{"year":"1975","name":"William Hodge","slug":"Hodge"},{"year":"1982","name":"Raymond Wilder","slug":"Wilder"},{"year":"2013","name":"Maria Steinberg","slug":"Steinberg_Maria"},{"year":"2014","name":"Lars Gårding","slug":"Garding"},{"year":"2017","name":"Marina Ratner","slug":"Ratner"},{"year":"2024","name":"Haïm Brezis","slug":"Brezis"},{"year":"2026","name":"James Mackay","slug":"Mackay"}]},{"date":"07-08","slug":"Kramp","kind":"born","year":"1760","life":"1760–1826","name":"Christian Kramp","nameKo":"크람프","title":"계승 기호 n!을 도입한 크람프","body":"프랑스 스트라스부르 출신의 크람프는 원래 의사였지만 점점 수학에 몰두해 해석학과 조합론을 연구했어요. 오늘날 $n!$로 쓰는 계승(팩토리얼) 기호를 처음 도입한 사람이에요. 의학 연구에도 수학을 활용해 사망률 표를 식으로 나타내려 했고, 1809년 고향 스트라스부르의 수학 교수가 되었어요.","unit":"고 확률과 통계","classroom":"순열에서 5×4×3×2×1을 길게 쓰다가 5!로 줄여 쓰는 순간, 이 기호를 만든 크람프를 소개해 보세요.","art":"algebra","event":"1835년 오늘, 에이다 바이런이 윌리엄 킹과 결혼했고, 3년 뒤 러브레이스 백작 부인이 되었어요.","born":[{"year":"1760","name":"Christian Kramp","slug":"Kramp"},{"year":"1777","name":"Daniel Hecht","slug":"Hecht"},{"year":"1829","name":"Robert Ferguson","slug":"Ferguson"},{"year":"1892","name":"Torsten Carleman","slug":"Carleman"},{"year":"1904","name":"Henri Cartan","slug":"Cartan_Henri"},{"year":"1915","name":"Kenneth May","slug":"May"}],"died":[{"year":"1390","name":"Albert of Saxony","slug":"Albert"},{"year":"1695","name":"Christiaan Huygens","slug":"Huygens"},{"year":"1934","name":"Édouard Benjamin Baillaud","slug":"Baillaud"},{"year":"1971","name":"Kurt Reidemeister","slug":"Reidemeister"},{"year":"1990","name":"Ottó Steinfeld","slug":"Steinfeld"},{"year":"1990","name":"David Widder","slug":"Widder"},{"year":"2008","name":"Sixto Ríos","slug":"Rios"},{"year":"2010","name":"David Blackwell","slug":"Blackwell"},{"year":"2010","name":"Gerhard Hochschild","slug":"Hochschild"}]},{"date":"07-09","slug":"Champernowne","kind":"born","year":"1912","life":"1912–2000","name":"David Champernowne","nameKo":"챔퍼나운","title":"0.123456789101112…를 만든 챔퍼나운","body":"영국의 챔퍼나운은 수학과 경제학 모두에서 활약했고, 앨런 튜링과 같은 해 케임브리지에 입학한 평생 친구였어요. 학부생 때 자연수를 차례로 이어 붙인 $0.123456789101112\\cdots$가 어떤 숫자 배열이든 고르게 나타나는 '정규수'임을 증명했어요. 이 수를 지금 챔퍼나운 상수라고 불러요.","unit":"중2 유리수와 순환소수","classroom":"순환소수를 배운 뒤, 규칙은 분명하지만 순환하지 않는 소수의 예로 챔퍼나운 상수를 보여 주세요.","art":"pi-digits","event":"1857년 오늘, 카를 바이어슈트라스가 베를린 아카데미에서 취임 연설을 했어요.","born":[{"year":"1801","name":"Henry Moseley","slug":"Moseley"},{"year":"1845","name":"George Darwin","slug":"Darwin"},{"year":"1912","name":"David Champernowne","slug":"Champernowne"},{"year":"1918","name":"Nicolaas de Bruijn","slug":"De_Bruijn"},{"year":"1922","name":"Kathleen Booth","slug":"Booth_Kathleen"},{"year":"1929","name":"Elon Lima","slug":"Lima"},{"year":"1931","name":"Valentina Mikhailovna Borok","slug":"Borok"}],"died":[{"year":"1941","name":"Robert d'Adhémar","slug":"DAdhemar"},{"year":"1947","name":"Beatrice Mabel Cave-Browne-Cave","slug":"Cave-Browne-Cave_Beatrice"},{"year":"1953","name":"Henri Padé","slug":"Pade"},{"year":"1968","name":"Giuseppe Pompilj","slug":"Pompilj"},{"year":"1980","name":"Tomás Rodríguez Bachiller","slug":"Bachiller"},{"year":"1980","name":"Arend Heyting","slug":"Heyting"},{"year":"1984","name":"Edna Kramer","slug":"Kramer"},{"year":"1986","name":"Ernst Peschl","slug":"Peschl"},{"year":"2002","name":"Laurence Raymond Harper","slug":"Harper"},{"year":"2014","name":"Alan Mercer","slug":"Mercer_Alan"}]},{"date":"07-10","slug":"Cotes","kind":"born","year":"1682","life":"1682–1716","name":"Roger Cotes","nameKo":"코츠","title":"『프린키피아』 2판을 편집한 코츠","body":"영국의 코츠는 23세에 케임브리지 대학의 첫 플룸 천문학 교수로 지명될 만큼 뛰어났어요. 뉴턴의 『프린키피아』 제2판을 편집했고, 로그 이론과 적분, 보간법 같은 수치 계산 방법을 발전시켰어요. 같은 세대 영국 수학자 가운데 뉴턴 다음가는 실력자로 평가받아요.","unit":"고 지수함수와 로그함수","classroom":"로그를 배울 때, 뉴턴의 책을 편집하며 로그 이론을 발전시킨 젊은 교수 코츠를 함께 소개해 보세요.","art":"log","event":"1349년 오늘, 토머스 브래드워딘이 캔터베리 대주교로 서임됐지만 런던에 돌아온 직후 흑사병으로 세상을 떠났어요.","born":[{"year":"1682","name":"Roger Cotes","slug":"Cotes"},{"year":"1824","name":"Wawrzyniec Żmurko","slug":"Zmurko"},{"year":"1878","name":"Oliver Kellogg","slug":"Kellogg"}],"died":[{"year":"1916","name":"Emory McClintock","slug":"McClintock"},{"year":"1936","name":"Salvatore Pincherle","slug":"Pincherle"},{"year":"2007","name":"Paulette Libermann","slug":"Libermann"}]},{"date":"07-11","slug":"Mosharrafa","kind":"born","year":"1898","life":"1898–1950","name":"Ali Moustafa Mosharrafa","nameKo":"무샤라파","title":"이집트 이론물리학의 선구자 무샤라파","body":"이집트의 무샤라파는 양자론과 상대성 이론의 발전에 기여한 이론물리학자예요. 열한 살에 아버지를 잃고 가족을 책임져야 했지만, 16살에 이집트 역대 최연소로 고교 졸업 자격을 얻었어요. 장학금으로 영국에 유학해 1923년 런던 킹스 칼리지에서 박사 학위를 받았어요.","unit":"공통","classroom":"어려운 형편에서도 공부를 이어 간 무샤라파를 소개하며, 수학과 과학이 세계 곳곳에서 발전해 왔음을 함께 이야기해 보세요.","art":"conic","event":"1731년 오늘, 알렉시 클레로가 18세의 나이로 프랑스 과학 아카데미 회원으로 선출되었어요.","born":[{"year":"1732","name":"Jérôme Lalande","slug":"Lalande"},{"year":"1857","name":"Joseph Larmor","slug":"Larmor"},{"year":"1888","name":"Yakov Davydovich Tamarkin","slug":"Tamarkin"},{"year":"1890","name":"Giacomo Albanese","slug":"Albanese"},{"year":"1898","name":"Ali Moustafa Mosharrafa","slug":"Mosharrafa"},{"year":"1904","name":"Helmut Grunsky","slug":"Grunsky"},{"year":"1908","name":"Alfred Hoblitzelle Clifford","slug":"Clifford_Alfred"},{"year":"1920","name":"Roman Sikorski","slug":"Sikorski"},{"year":"1922","name":"J W S Cassels","slug":"Cassels"}],"died":[{"year":"1382","name":"Nicholas Oresme","slug":"Oresme"},{"year":"1733","name":"Jakob Hermann","slug":"Hermann"},{"year":"1807","name":"George Atwood","slug":"Atwood"},{"year":"1909","name":"Simon Newcomb","slug":"Newcomb"},{"year":"1950","name":"Arthur Conway","slug":"Conway_Arthur"},{"year":"1955","name":"Gustave Dumas","slug":"Dumas"},{"year":"1995","name":"Andrzej Alexiewicz","slug":"Alexiewicz"}]},{"date":"07-12","slug":"Fuller","kind":"born","year":"1895","life":"1895–1983","name":"R Buckminster Fuller","nameKo":"버크민스터 풀러","title":"지오데식 돔을 발명한 버크민스터 풀러","body":"미국의 풀러는 건축가이자 공학자, 수학자로, 1947년 특허를 낸 지오데식 돔으로 가장 유명해요. 최소한의 구조로 최대의 강도를 내는 정사면체를 바탕으로 한 이 둥근 구조물은 20만 개 넘게 지어졌어요. 가장 유명한 예는 1967년 몬트리올 박람회의 미국관이에요.","unit":"중1 입체도형","classroom":"정다면체를 배운 뒤, 삼각형 면을 이어 둥근 지붕을 만든 풀러의 지오데식 돔 사진을 보여 주세요.","art":"spheres","event":"1925년 오늘, 베르너 하이젠베르크가 양자역학의 기본 원리에 대한 자신의 생각을 발표했어요.","born":[{"year":"1875","name":"Ernst Fischer","slug":"Fischer"},{"year":"1889","name":"Adolphe Rome","slug":"Rome"},{"year":"1895","name":"R Buckminster Fuller","slug":"Fuller"},{"year":"1926","name":"Calogero Vinti","slug":"Vinti"},{"year":"1928","name":"Louis Auslander","slug":"Auslander_Louis"},{"year":"1969","name":"David Cariolaro","slug":"Cariolaro"}],"died":[{"year":"1941","name":"Stanisław Leon Ruziewicz","slug":"Ruziewicz"},{"year":"1983","name":"Ernst Straus","slug":"Straus"},{"year":"1997","name":"Jane Wadsworth","slug":"Wadsworth"},{"year":"2011","name":"Roman Ingarden","slug":"Ingarden"}]},{"date":"07-13","slug":"Dee","kind":"born","year":"1527","life":"1527–1609","name":"John Dee","nameKo":"존 디","title":"유클리드 강의로 파리를 사로잡은 존 디","body":"영국의 학자 존 디는 삼각법, 달력 개혁, 항해술, 지리에 관한 글을 남겼어요. 케임브리지 시절 하루 18시간씩 공부했고, 1550년 파리에서 유클리드의 『원론』을 강의할 때는 청중이 강의실을 넘쳐 났다고 해요. 메리 여왕의 점성가가 되었지만 마법사라는 혐의로 감옥에 갇히기도 했어요.","unit":"중1 기본 도형","classroom":"도형 단원 첫 시간에, 『원론』 강의 하나로 파리 사람들을 끌어모은 존 디 이야기로 호기심을 열어 보세요.","art":"euclid","event":"1824년 오늘, 찰스 배비지가 왕립천문학회 금메달의 첫 수상자가 되었어요.","born":[{"year":"1527","name":"John Dee","slug":"Dee"},{"year":"1741","name":"Carl Friedrich Hindenburg","slug":"Hindenburg"},{"year":"1904","name":"Alfred Foster","slug":"Foster"}],"died":[{"year":"1321","name":"Ibn al-Banna","slug":"Al-Banna"},{"year":"1762","name":"James Bradley","slug":"Bradley"},{"year":"1807","name":"Johann(III) Bernoulli","slug":"Bernoulli_Johann(III)"},{"year":"1934","name":"Mary Byrd","slug":"Byrd"},{"year":"1941","name":"Ivan Ivanovich Privalov","slug":"Privalov"},{"year":"2016","name":"Ward Cheney","slug":"Cheney"}]},{"date":"07-14","slug":"Mirzakhani","kind":"died","year":"2017","life":"1977–2017","name":"Maryam Mirzakhani","nameKo":"미르자하니","title":"여성 최초의 필즈상 수상자 미르자하니","body":"이란 출신의 미르자하니는 리만 곡면의 기하를 연구했고, 여성 최초로 필즈상을 받았어요. 중학교 1학년 때 선생님에게 수학 재능이 없다는 말을 듣고 흥미를 잃었지만, 이듬해 격려해 준 선생님을 만나 재능을 꽃피웠어요. 국제수학올림피아드에서 42점 만점에 41점, 이듬해에는 만점을 받아 금메달을 두 번 땄어요.","unit":"공통","classroom":"'수학 머리는 타고난다'고 믿는 학생들에게, 선생님의 격려로 달라진 미르자하니 이야기를 들려주세요.","art":"medal","event":"1760년 오늘, 영국 왕립학회가 금성의 태양면 통과를 관측하도록 매스켈린을 세인트헬레나섬에 보내기로 했어요.","born":[{"year":"1793","name":"George Green","slug":"Green"},{"year":"1905","name":"Laurence Chisholm Young","slug":"Young_Laurence"},{"year":"1917","name":"Patrick Moran","slug":"Moran"},{"year":"1933","name":"Samuel Gitler","slug":"Gitler"},{"year":"1937","name":"David Hayes","slug":"Hayes_David"},{"year":"1952","name":"Emilio Cafaro","slug":"Cafaro"},{"year":"1955","name":"Gregory Lawler","slug":"Lawler"}],"died":[{"year":"1800","name":"Lorenzo Mascheroni","slug":"Mascheroni"},{"year":"1827","name":"Augustin Fresnel","slug":"Fresnel"},{"year":"1865","name":"Benjamin Gompertz","slug":"Gompertz"},{"year":"1943","name":"John McWhan","slug":"McWhan"},{"year":"1953","name":"Richard von Mises","slug":"Mises"},{"year":"1956","name":"John Miller","slug":"Miller_John"},{"year":"1956","name":"John Wishart","slug":"Wishart"},{"year":"1967","name":"Schieffelin Claytor","slug":"Claytor"},{"year":"1972","name":"Thomas Lancaster Wren","slug":"Wren_Thomas"},{"year":"2016","name":"John Carr","slug":"Carr"},{"year":"2017","name":"Maryam Mirzakhani","slug":"Mirzakhani"},{"year":"2019","name":"Hoàng Tụy","slug":"Tuy"}]},{"date":"07-15","slug":"Smale","kind":"born","year":"1930","life":"1930–","name":"Stephen Smale","nameKo":"스메일","title":"고차원 푸앵카레 추측을 증명한 스메일","body":"미국의 스메일은 대학에서 물리 과목에 낙제한 뒤 수학으로 방향을 바꿨어요. 1961년 5차원 이상에서 일반화된 푸앵카레 추측을 증명했고, 1966년 모스크바 국제수학자대회에서 필즈상을 받았어요. 혼돈 현상과 '이상한 끌개' 연구에도 큰 발자취를 남겼어요.","unit":"공통","classroom":"실패가 진로를 바꾼 예로, 물리에 낙제한 뒤 필즈상 수상자가 된 스메일 이야기를 들려주세요.","art":"torus","event":"1662년 오늘, 런던 왕립학회가 찰스 2세에게서 칙허장을 받았어요.","born":[{"year":"1865","name":"Wilhelm Wirtinger","slug":"Wirtinger"},{"year":"1897","name":"Letitia Chitty","slug":"Chitty"},{"year":"1898","name":"Mary Taylor","slug":"Taylor_Mary"},{"year":"1906","name":"Adolph Pavlovich Yushkevich","slug":"Yushkevich"},{"year":"1908","name":"Henryk Zygalski","slug":"Zygalski"},{"year":"1909","name":"William Cochran","slug":"Cochran"},{"year":"1912","name":"Tibor Gallai","slug":"Gallai"},{"year":"1923","name":"Kuo-Tsai Chen","slug":"Chen"},{"year":"1930","name":"Stephen Smale","slug":"Smale"}],"died":[{"year":"998","name":"Abu'l-Wafa","slug":"Abul-Wafa"},{"year":"1841","name":"Félix Savary","slug":"Savary"},{"year":"1931","name":"Ladislaus Bortkiewicz","slug":"Bortkiewicz"},{"year":"1961","name":"Nina Bari","slug":"Bari"},{"year":"1965","name":"Dudley Woodard","slug":"Woodard"},{"year":"1995","name":"Paul Kelly","slug":"Kelly"}]},{"date":"07-16","slug":"Piazzi","kind":"born","year":"1746","life":"1746–1826","name":"Giuseppe Piazzi","nameKo":"피아치","title":"화성과 목성 사이에서 세레스를 찾은 피아치","body":"이탈리아의 사제이자 천문학자 피아치는 화성과 목성 궤도 사이에서 세레스를 발견한 것으로 가장 유명해요. 팔레르모에서 훌륭한 수학 교사로 이름을 얻은 뒤 천문학 교수가 되었고, 별들의 고유 운동에 관한 중요한 연구도 남겼어요. 태어날 때 몸이 너무 약해 집에서 세례를 받았다고 해요.","unit":"공통","classroom":"행성 궤도 이야기를 할 때, 화성과 목성 사이의 빈자리에서 세레스를 찾아낸 피아치를 소개해 보세요.","art":"earth","event":"1611년 오늘, 마랭 메르센이 미니모회 수도회에 들어갔어요.","born":[{"year":"1678","name":"Jakob Hermann","slug":"Hermann"},{"year":"1746","name":"Giuseppe Piazzi","slug":"Piazzi"},{"year":"1801","name":"Julius Plücker","slug":"Plucker"},{"year":"1819","name":"Siegfried Aronhold","slug":"Aronhold"},{"year":"1862","name":"James Archibald","slug":"Archibald_James"},{"year":"1902","name":"Gheorghe  Calugăreănu","slug":"Calugareanu"},{"year":"1903","name":"Irmgard Flügge-Lotz","slug":"Flugge-Lotz"},{"year":"1932","name":"Stanisław Świerczkowski","slug":"Swierczkowski"}],"died":[{"year":"1850","name":"Enno Heeren Dirksen","slug":"Dirksen"},{"year":"1976","name":"Nikoloz Muskhelishvili","slug":"Muskhelishvili"},{"year":"1981","name":"Jacob Wolfowitz","slug":"Wolfowitz"},{"year":"1994","name":"Julian Schwinger","slug":"Schwinger"},{"year":"2005","name":"Magdalena Mouján","slug":"Moujan"},{"year":"2013","name":"Yurii Vasilevich Prokhorov","slug":"Prokhorov"}]},{"date":"07-17","slug":"Tao","kind":"born","year":"1975","life":"1975–","name":"Terence Tao","nameKo":"테런스 타오","title":"최연소 국제수학올림피아드 금메달리스트 타오","body":"오스트레일리아 출신의 타오는 두 살 때 텔레비전 「세서미 스트리트」를 보고 배운 덧셈을 다섯 살 아이들에게 가르쳤다고 해요. 열 살에 국제수학올림피아드에 나가 동·은·금메달을 차례로 받았고, 1988년 역대 최연소 금메달리스트가 되었어요. 2006년에는 편미분방정식, 조합론, 정수론 등의 업적으로 필즈상을 받았어요.","unit":"공통","classroom":"수학 경시 문제를 함께 풀어 보는 날, 열 살에 국제 대회에 나간 타오 이야기로 도전 의식을 북돋아 보세요.","art":"medal","ev