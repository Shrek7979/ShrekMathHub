[{"date":"04-01","slug":"Germain","kind":"born","year":"1776","life":"1776–1831","name":"Sophie Germain","nameKo":"소피 제르맹","title":"남자 이름으로 논문을 낸 소피 제르맹","body":"소피 제르맹은 정수론, 특히 소수 이론과 탄성 이론에 큰 공헌을 한 프랑스 수학자예요. 여성은 에콜 폴리테크니크에 입학할 수 없었지만 강의 노트를 구해 공부했고, '르블랑'이라는 남자 이름으로 라그랑주에게 보고서를 냈어요. 잉크가 얼 만큼 추운 서재에서도 공부를 멈추지 않았다고 해요.","unit":"중1 소인수분해","classroom":"소수를 배울 때, 이름을 숨기면서까지 수학을 공부한 제르맹의 이야기로 배움의 의미를 함께 나눠 보세요.","art":"letter","event":"1975년 오늘, 마틴 가드너가 라마누잔이 어떤 수가 정수라고 추측했다는 만우절 가짜 기사를 실었어요.","born":[{"year":"1617","name":"Seth Ward","slug":"Ward_Seth"},{"year":"1640","name":"Georg Mohr","slug":"Mohr"},{"year":"1776","name":"Sophie Germain","slug":"Germain"},{"year":"1801","name":"Henry Perigal","slug":"Perigal"},{"year":"1835","name":"James Moriarty","slug":"Moriarty"},{"year":"1874","name":"Ernest William Barnes","slug":"Barnes"},{"year":"1879","name":"Antoni Hoborski","slug":"Hoborski"},{"year":"1895","name":"Alec Aitken","slug":"Aitken"},{"year":"1916","name":"Sheila Edmonds","slug":"Edmonds"},{"year":"1935","name":"Bronius Grigelionis","slug":"Grigelionis"},{"year":"1947","name":"Alain Connes","slug":"Connes"}],"died":[{"year":"1863","name":"Jakob Steiner","slug":"Steiner"},{"year":"1872","name":"Martin Ohm","slug":"Ohm_Martin"},{"year":"1921","name":"Carl Johannes Thomae","slug":"Thomae"},{"year":"1930","name":"George Gibson","slug":"Gibson"},{"year":"1968","name":"Lev Landau","slug":"Landau_Lev"},{"year":"1998","name":"Mary Warner","slug":"Warner"},{"year":"2003","name":"Adriaan Cornelis Zaanen","slug":"Zaanen"}]},{"date":"04-02","slug":"Cohen","kind":"born","year":"1934","life":"1934–2007","name":"Paul Cohen","nameKo":"폴 코언","title":"연속체 가설의 독립성을 보인 코언","body":"코언은 '강제법'이라는 기법을 만들어, 선택 공리와 일반 연속체 가설이 집합론의 공리만으로는 증명도 반증도 할 수 없음을 보인 미국 수학자예요. 대학원에 논리학 강의가 없었지만 논리학자 친구들과 어울리며 자연스럽게 논리를 익혔어요. 1960년에는 리틀우드 추측 연구에서도 큰 돌파구를 열었어요.","unit":"고 집합","classroom":"'참인지 거짓인지 끝내 정할 수 없는 문장도 있을까?'라는 질문으로 집합과 명제 단원을 마무리해 보세요.","art":"infinity","event":"1948년 오늘, 쿠르트 괴델이 미국 시민이 