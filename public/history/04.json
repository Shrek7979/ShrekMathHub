ardt"},{"year":"1952","name":"Guido Castelnuovo","slug":"Castelnuovo"},{"year":"1957","name":"George Jeffery","slug":"Jeffery"},{"year":"1960","name":"Frank Jackson","slug":"Jackson_Frank"},{"year":"1978","name":"Guido Stampacchia","slug":"Stampacchia"},{"year":"1979","name":"Gheorghe Vrănceanu","slug":"Vranceanu"},{"year":"2013","name":"Norman Routledge","slug":"Routledge"}]},{"date":"04-28","slug":"Godel","kind":"born","year":"1906","life":"1906–1978","name":"Kurt Gödel","nameKo":"쿠르트 괴델","title":"불완전성 정리를 증명한 괴델","body":"괴델은 어떤 공리 체계 안에도 그 공리만으로는 증명도 반증도 할 수 없는 명제가 있음을 보인 수학자예요. 1931년 이 결과를 담은 논문을 발표했고, 이것이 유명한 '불완전성 정리'예요. 이 논문은 이듬해 빈 대학에서 교수 자격 논문으로도 인정받았어요.","unit":"고 명제","classroom":"'이 문장은 거짓이다'가 참인지 거짓인지 따져 보는 활동으로 괴델의 아이디어를 맛보게 하세요.","art":"godel","event":"1693년 오늘, 라이프니츠가 로피탈에게 행렬식의 발견을 알렸지만 그 내용은 1850년에야 출판되었어요.","born":[{"year":"1765","name":"Sylvestre Lacroix","slug":"Lacroix"},{"year":"1773","name":"Robert Woodhouse","slug":"Woodhouse"},{"year":"1831","name":"P G Tait","slug":"Tait"},{"year":"1838","name":"Jenő Hunyadi","slug":"Hunyadi"},{"year":"1854","name":"Hertha Marks Ayrton","slug":"Ayrton"},{"year":"1868","name":"Georgy Voronoy","slug":"Voronoy"},{"year":"1882","name":"Theodor Angheluță","slug":"Angheluta"},{"year":"1906","name":"Kurt Gödel","slug":"Godel"},{"year":"1906","name":"Richard Rado","slug":"Rado_Richard"},{"year":"1921","name":"Iacopo Barsotti","slug":"Barsotti"},{"year":"1923","name":"Fritz Ursell","slug":"Ursell"},{"year":"1925","name":"Gordon Preston","slug":"Preston"},{"year":"1937","name":"David Fowler","slug":"Fowler_David"}],"died":[{"year":"1843","name":"William Wallace","slug":"Wallace"},{"year":"1903","name":"J Willard Gibbs","slug":"Gibbs"},{"year":"1975","name":"Hans Heilbronn","slug":"Heilbronn"},{"year":"1986","name":"R H Bing","slug":"Bing"},{"year":"2006","name":"Fred Wright","slug":"Wright_Fred"},{"year":"2019","name":"Maurício Peixoto","slug":"Peixoto"},{"year":"2020","name":"Robert May","slug":"May_Robert"}]},{"dat