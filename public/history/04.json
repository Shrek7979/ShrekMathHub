":"Bertrand"},{"year":"1974","name":"Andor Kertész","slug":"Kertesz"},{"year":"1993","name":"Leopoldo Nachbin","slug":"Nachbin"},{"year":"1998","name":"Mary Cartwright","slug":"Cartwright"},{"year":"2018","name":"David Foulis","slug":"Foulis"}]},{"date":"04-04","slug":"Napier","kind":"died","year":"1617","life":"1550–1617","name":"John Napier","nameKo":"존 네이피어","title":"로그를 발명한 네이피어","body":"네이피어는 로그를 발명한 것으로 가장 잘 알려진 스코틀랜드 학자예요. 구면삼각형을 푸는 공식을 쉽게 외우는 요령과 '네이피어의 유추'라는 두 공식도 남겼어요. 또 곱셈과 나눗셈, 제곱근 계산을 기계적으로 해 주는 계산 도구 '네이피어의 막대'를 발명했어요.","unit":"고 지수와 로그","classroom":"종이로 네이피어의 막대를 만들어 큰 수의 곱셈을 해 보며, 계산을 쉽게 하려던 그의 아이디어를 느껴 보게 하세요.","art":"log","event":"1820년 오늘, 보여이 퍼르카시가 아들 야노시에게 평행선 공리 연구를 그만두라는 편지를 보냈어요.","born":[{"year":"1782","name":"Vincenzo Flauti","slug":"Flauti"},{"year":"1790","name":"Jean-Baptiste Bélanger","slug":"Belanger"},{"year":"1809","name":"Benjamin Peirce","slug":"Peirce_Benjamin"},{"year":"1842","name":"Édouard Lucas","slug":"Lucas"},{"year":"1863","name":"Jean-Marie Le Roux","slug":"Le_Roux"},{"year":"1868","name":"Philippa Fawcett","slug":"Fawcett"},{"year":"1884","name":"Thomas MacRobert","slug":"MacRobert"},{"year":"1902","name":"Eberhard Hopf","slug":"Hopf_Eberhard"},{"year":"1915","name":"René Taton","slug":"Taton"},{"year":"1939","name":"Mary Lee Wheat Gray","slug":"Gray"},{"year":"1949","name":"Shing-Tung Yau","slug":"Yau"},{"year":"1968","name":"Amie Wilkinson","slug":"Wilkinson_Amie"}],"died":[{"year":"1617","name":"John Napier","slug":"Napier"},{"year":"1807","name":"Jérôme Lalande","slug":"Lalande"},{"year":"1923","name":"John Venn","slug":"Venn"},{"year":"1925","name":"Walter Rouse Ball","slug":"Ball"},{"year":"1949","name":"William Threlfall","slug":"Threlfall"},{"year":"1961","name":"Simion Stoilow","slug":"Stoilow"},{"year":"1981","name":"Carl Siegel","slug":"Siegel"},{"year":"1991","name":"Hans Reichardt","slug":"Reichardt"},{"year":"2012","name":"Nikolai Nikolaevich Krasovskii","slug":"Krasovskii"},{"year":"2017","name":"Dan Mostow","slug":"Mostow"}]},{"date":"04-05","slug":"Hobbes","kind":"born","year":"1588","life":"1588–1679","name":"Thomas Hobbes","nameKo":"토머스 홉스","title":"마흔에 기하학에 반한 철학자 홉스","body":"홉스는 광학과 기하학에 관한 글을 쓴 영국의 학자이자 아마추어 수학자예요. 마흔 살이 되어서야 한 신사의 서재에 펼쳐져 있던 유클리드 『원론』 제1권 47번째 명제, 곧 피타고라스 정리를 보고 기하학에 빠져들었다고 해요. 뒷날에는 새로운 해석학 방법을 공격하기도 했어요.","unit":"중2 피타고라스 정리","classroom":"피타고라스 정리를 증명할 때, 마흔 살 철학자를 기하학에 빠지게 한 바로 그 명제라고 소개해 보세요.","art":"euclid","event":"1955년 오늘, 버트런드 러셀이 핵무기의 위험을 경고하는 선언문 초안을 아인슈타인에게 보냈어요.","born":[{"year":"1588","name":"Thomas Hobbes","slug":"Hobbes"},{"year":"1622","name":"Vincenzo Viviani","slug":"Viviani"},{"year":"1869","name":"Sergei Alekseevich Chaplygin","slug":"Chaplygin"},{"year":"1877","name":"Georg Faber","slug":"Faber"},{"year":"1901","name":"S S Pillai","slug":"Pillai_S_S"},{"year":"1911","name":"Warwick Sawyer","slug":"Sawyer"},{"year":"1918","name":"Wanda Szmielew","slug":"Szmielew"},{"year":"1936","name":"Roshdi Rashed","slug":"Rashed"}],"died":[{"year":"1678","name":"Claude Hardy","slug":"Hardy_Claude"},{"year":"1684","name":"William Brouncker","slug":"Brouncker"},{"year":"1827","name":"John Hellins","slug":"Hellins"},{"year":"1861","name":"Ferdinand Joachimsthal","slug":"Joachimsthal"},{"year":"1933","name":"Hjalmar Mellin","slug":"Mellin"},{"year":"1951","name":"Lawrence Crawford","slug":"Crawford"},{"year":"1955","name":"Tibor Szele","slug":"Szele"},{"year":"2009","name":"Irving John Good","slug":"Good"}]},{"date":"04-06","slug":"Vince","kind":"born","year":"1749","life":"1749–1821","name":"Samuel Vince","nameKo":"새뮤얼 빈스","title":"벽돌공 소년에서 천문학 교수가 된 빈스","body":"빈스는 벽돌공의 아들로 태어나 어려서 아버지 일을 도운 영국 수학자예요. 열두 살 무렵 사다리에 앉아 책을 읽다가 한 목사의 눈에 띄어 공부할 기회를 얻었고, 1775년 케임브리지 수학 시험에서 1등을 했어요. 25년 동안 케임브리지 천문학 교수로 일하며 많은 책을 썼어요.","unit":"공통","classroom":"책 한 권이 삶을 바꾼 사례로, 독서 활동이나 진로 수업을 시작할 때 빈스의 이야기를 들려주세요.","art":"textbook","event":"1846년 오늘, 열네 살 맥스웰의 타원형 곡선에 관한 논문이 에든버러 왕립학회에서 발표되었어요.","born":[{"year":"1732","name":"José Mutis","slug":"Mutis"},{"year":"1749","name":"Samuel Vince","slug":"Vince"},{"year":"1851","name":"Guillaume Bigourdan","slug":"Bigourdan"},{"year":"1875","name":"Michele de Franchis","slug":"De_Franchis"},{"year":"1934","name":"Iossif Vladimirovich Ostrovskii","slug":"Ostrovskii"},{"year":"1956","name":"María Esteban","slug":"Esteban"}],"died":[{"year":"1528","name":"Albrecht Dürer","slug":"Durer"},{"year":"1829","name":"Niels Abel","slug":"Abel"},{"year":"1938","name":"Aurel Angelescu","slug":"Angelescu"},{"year":"1993","name":"J C Burkill","slug":"Burkill"},{"year":"2025","name":"Victor Olunloyo","slug":"Olunloyo"}]},{"date":"04-07","slug":"Obi","kind":"born","year":"1921","life":"1921–2008","name":"Chike Obi","nameKo":"치케 오비","title":"나이지리아 첫 수학 박사 치케 오비","body":"치케 오비는 나이지리아 사람으로는 처음 수학 박사 학위를 받은 수학자이자 정치인이에요. 케임브리지에서 메리 카트라이트와 리틀우드의 지도로 비선형 미분방정식을 연구해 1950년 박사가 되었어요. 귀국 뒤에는 대학에서 연구하는 한편 나이지리아 독립을 위한 정치 활동도 펼쳤어요.","unit":"고 미분","classroom":"4월 3일의 카트라이트와 함께 소개하며, 스승과 제자로 이어지는 수학의 연결 고리를 보여 주세요.","art":"tangent","event":"1795년 오늘, 프랑스 국민공회가 미터법 도입 법을 통과시키고 르장드르에게 전환 작업을 맡겼어요.","born":[{"year":"1768","name":"François Français","slug":"Francais_Francois"},{"year":"1823","name":"Jules Hoüel","slug":"Houel"},{"year":"1866","name":"Ivar Fredholm","slug":"Fredholm"},{"year":"1877","name":"Carl Schoy","slug":"Schoy"},{"year":"1888","name":"William Brash","slug":"Brash"},{"year":"1897","name":"Tatsujiro Shimizu","slug":"Shimizu"},{"year":"1921","name":"Chike Obi","slug":"Obi"},{"year":"1923","name":"Peter Hilton","slug":"Hilton"},{"year":"1926","name":"Miroslav Fiedler","slug":"Fiedler"},{"year":"1935","name":"Graciela Salicrup","slug":"Salicrup"},{"year":"1959","name":"Leopoldo Franca","slug":"Franca"}],"died":[{"year":"1887","name":"John Hymers","slug":"Hymers"},{"year":"1889","name":"Paul du Bois-Reymond","slug":"Du_Bois-Reymond"},{"year":"1933","name":"Raymond Paley","slug":"Paley"},{"year":"1934","name":"Heinz Prüfer","slug":"Prufer"},{"year":"1986","name":"Leonid Vital'evich Kantorovich","slug":"Kantorovich"},{"year":"2006","name":"Zdzisław Pawlak","slug":"Pawlak"},{"year":"2009","name":"Leonard Gillman","slug":"Gillman"},{"year":"2014","name":"Sandy Green","slug":"Green_Sandy"}]},{"date":"04-08","slug":"Rittenhouse","kind":"born","year":"1732","life":"1732–1796","name":"David Rittenhouse","nameKo":"데이비드 리튼하우스","title":"독학으로 시계와 망원경을 만든 리튼하우스","body":"리튼하우스는 벤저민 프랭클린과 함께 18세기 미국을 대표하는 단 두 명의 수학자로 꼽혀요. 학교 교육을 거의 받지 못해 산수와 기하 책으로 독학했고, 열일곱 살에 나무 시계를 만들었어요. 1769년 금성이 태양 앞을 지나가는 현상을 관측해 금성에 대기가 있다는 것을 알아챘어요.","unit":"공통","classroom":"스스로 공부해 도구를 만들고 하늘을 관측한 리튼하우스 이야기로 자기주도 학습의 동기를 북돋아 보세요.","art":"earth","event":"1019년 오늘, 알비루니가 카불 북쪽 람간에서 일식을 관측했어요.","born":[{"year":"1608","name":"Honoré Fabri","slug":"Fabri"},{"year":"1732","name":"David Rittenhouse","slug":"Rittenhouse"},{"year":"1903","name":"Marshall Stone","slug":"Stone"},{"year":"1903","name":"Aurel Wintner","slug":"Wintner"},{"year":"1928","name":"Elizabeth Fennema","slug":"Fennema"},{"year":"1929","name":"François Bruhat","slug":"Bruhat"},{"year":"1944","name":"Michael Aschbacher","slug":"Aschbacher"},{"year":"1947","name":"David Eisenbud","slug":"Eisenbud"},{"year":"1949","name":"Qamil Haxhibeqiri","slug":"Haxhibeqiri"}],"died":[{"year":"1461","name":"Georg Peurbach","slug":"Peurbach"},{"year":"1913","name":"Gyula Kőnig","slug":"Konig_Julius"},{"year":"1919","name":"Loránd Eötvös","slug":"Eotvos"},{"year":"1925","name":"Frank Baldwin","slug":"Baldwin"},{"year":"1992","name":"G de B Robinson","slug":"Robinson_G_de_B"},{"year":"2005","name":"Douglas Northcott","slug":"Northcott"},{"year":"2008","name":"Graham Higman","slug":"Higman"}]},{"date":"04-09","slug":"Hironaka","kind":"born","year":"1931","life":"1931–2026","name":"Heisuke Hironaka","nameKo":"히로나카 헤이스케","title":"특이점 해소로 필즈상을 받은 히로나카","body":"히로나카 헤이스케는 대수기하학 업적으로 1970년 필즈상을 받은 일본 수학자예요. 학창 시절 학교에 찾아온 대학 교수의 강연을 듣고 수학에 빠져들었어요. 교토 대학을 찾은 자리스키의 권유로 하버드에 유학했고, 1964년 '특이점 해소' 문제를 모든 차원에서 해결했어요.","unit":"공통","classroom":"강연 한 번이 진로를 바꾼 예로, 진로 특강이나 수학 축제를 앞두고 히로나카의 이야기를 들려주세요.","art":"medal","event":"1673년 오늘, 라이프니츠가 영국 왕립학회 회원으로 선출되었어요.","born":[{"year":"1652","name":"Jean Le Fèvre","slug":"Le_Fevre"},{"year":"1791","name":"George Peacock","slug":"Peacock"},{"year":"1813","name":"Robert Anstice","slug":"Anstice"},{"year":"1816","name":"Charles Eugène Delaunay","slug":"Delaunay"},{"year":"1834","name":"Edmond Laguerre","slug":"Laguerre"},{"year":"1863","name":"Lászlo Rátz","slug":"Ratz"},{"year":"1869","name":"Élie Cartan","slug":"Cartan"},{"year":"1878","name":"Marcel Grossmann","slug":"Grossmann"},{"year":"1894","name":"Alfred Brauer","slug":"Brauer_Alfred"},{"year":"1894","name":"Cecilia Krieger","slug":"Krieger"},{"year":"1900","name":"Hendrik Kloosterman","slug":"Kloosterman"},{"year":"1919","name":"J Presper Eckert","slug":"Eckert_John"},{"year":"1931","name":"Heisuke Hironaka","slug":"Hironaka"}],"died":[{"year":"1348","name":"William of Ockham","slug":"Ockham"},{"year":"1643","name":"Benedetto Castelli","slug":"Castelli"},{"year":"1920","name":"Moritz Cantor","slug":"Cantor_Moritz"},{"year":"1951","name":"Vilhelm Bjerknes","slug":"Bjerknes_Vilhelm"},{"year":"1953","name":"Hans Reichenbach","slug":"Reichenbach"},{"year":"1971","name":"Adolphe Rome","slug":"Rome"},{"year":"1972","name":"George Forsythe","slug":"Forsythe"},{"year":"1982","name":"Maximilian Herzberger","slug":"Herzberger"},{"year":"1983","name":"Yozo Matsushima","slug":"Matsushima"},{"year":"1989","name":"Udita Narayana Singh","slug":"Singh"},{"year":"2001","name":"Ray Vanstone","slug":"Vanstone"},{"year":"2002","name":"Leopold Vietoris","slug":"Vietoris"}]},{"date":"04-10","slug":"Dudeney","kind":"born","year":"1857","life":"1857–1930","name":"Henry Ernest Dudeney","nameKo":"헨리 듀드니","title":"삼각형을 정사각형으로 바꾼 퍼즐 왕 듀드니","body":"듀드니는 수학 퍼즐과 놀이를 담은 책으로 유명한 영국의 퍼즐 작가예요. 아홉 살부터 퍼즐을 만들어 지역 신문에 실었어요. 대표작 '잡화상의 문제'는 정삼각형을 네 조각으로 잘라 정사각형으로 다시 맞추는 퍼즐로, 1905년 왕립학회 모임에서 직접 시연했어요.","unit":"중1 평면도형","classroom":"정삼각형을 오려 정사각형으로 다시 맞춰 보는 활동으로, 모양이 바뀌어도 넓이는 같다는 것을 체험하게 하세요.","art":"magic-square","event":"1661년 오늘, 가는 관일수록 물이 높이 올라간다는 로버트 훅의 첫 모세관 현상 논문이 발표되었어요.","born":[{"year":"1651","name":"Ehrenfried Walter von Tschirnhaus","slug":"Tschirnhaus"},{"year":"1756","name":"John West","slug":"West"},{"year":"1825","name":"Charles MacKenzie","slug":"MacKenzie_Charles"},{"year":"1832","name":"Georg Zehfuss","slug":"Zehfuss"},{"year":"1838","name":"Frank Baldwin","slug":"Baldwin"},{"year":"1857","name":"Henry Ernest Dudeney","slug":"Dudeney"},{"year":"1905","name":"Eižens Leimanis","slug":"Leimanis"}],"died":[{"year":"1813","name":"Joseph-Louis Lagrange","slug":"Lagrange"},{"year":"1911","name":"Samuel Loyd","slug":"Loyd"},{"year":"1930","name":"William Story","slug":"Story"},{"year":"1967","name":"Oscar Chisini","slug":"Chisini"},{"year":"1988","name":"Annie Hutton Numbers","slug":"Numbers"},{"year":"2011","name":"David Hayes","slug":"Hayes_David"}]},{"date":"04-11","slug":"Wiles","kind":"born","year":"1953","life":"1953–","name":"Andrew Wiles","nameKo":"앤드루 와일스","title":"페르마의 마지막 정리를 증명한 와일스","body":"와일스는 1995년 페르마의 마지막 정리를 증명한 것으로 유명한 영국 수학자예요. 열 살 때 동네 도서관에서, 300여 년 동안 누구도 증명을 본 적 없는 이 문제를 소개한 책을 읽고 마음을 빼앗겼어요. 이 업적으로 아벨상을 비롯한 많은 상을 받고 기사 작위도 받았어요.","unit":"중2 피타고라스 정리","classroom":"피타고라스 정리를 배운 뒤 $a^3+b^3=c^3$을 만족하는 자연수를 찾아보게 하며 와일스의 열 살 때 이야기를 들려주세요.","art":"fermat","event":"1936년 오늘, 콘라트 추제가 독일 첫 컴퓨터 Z-1으로 이어진 자동 계산 방식의 특허를 출원했어요.","born":[{"year":"1894","name":"Paul Finsler","slug":"Finsler"},{"year":"1896","name":"Robert Geary","slug":"Geary"},{"year":"1904","name":"Philip Hall","slug":"Hall"},{"year":"1904","name":"González Domínguez","slug":"Dominguez"},{"year":"1905","name":"Joseph Dennis","slug":"Dennis"},{"year":"1907","name":"Henry Scheffé","slug":"Scheffe"},{"year":"1908","name":"Brian Kuttner","slug":"Kuttner"},{"year":"1908","name":"Guacolda Lazzerini","slug":"Lazzerini"},{"year":"1914","name":"Dorothy Bernstein","slug":"Bernstein_Dorothy"},{"year":"1921","name":"Leo Moser","slug":"Moser_Leo"},{"year":"1953","name":"Andrew Wiles","slug":"Wiles"}],"died":[{"year":"1626","name":"Marino Ghetaldi","slug":"Ghetaldi"},{"year":"1711","name":"Louis Carré","slug":"Carre"},{"year":"1734","name":"Thomas Fantet de Lagny","slug":"Lagny"},{"year":"1908","name":"Christian Adolph Mayer","slug":"Mayer_Adolph"},{"year":"1974","name":"Abraham Robinson","slug":"Robinson"},{"year":"1977","name":"Mauro Picone","slug":"Picone"},{"year":"1989","name":"Emil Grosswald","slug":"Grosswald"},{"year":"2015","name":"Adelina Gutiérrez Moreno","slug":"Moreno"},{"year":"2020","name":"John Conway","slug":"Conway"}]},{"date":"04-12","slug":"Lindemann","kind":"born","year":"1852","life":"1852–1939","name":"Ferdinand von Lindemann","nameKo":"페르디난트 폰 린데만","title":"원주율이 초월수임을 증명한 린데만","body":"린데만은 1882년 π가 유리수 계수 방정식의 해가 될 수 없는 초월수임을 처음 증명한 독일 수학자예요. 이로써 자와 컴퍼스만으로 원과 넓이가 같은 정사각형을 그리는, 그리스 시대부터 내려온 '원적 문제'가 불가능하다는 것이 확정되었어요. 힐베르트가 그의 박사 제자예요.","unit":"중1 원과 부채꼴","classroom":"원주율을 배울 때, 원과 넓이가 같은 정사각형을 작도할 수 없다는 사실이 밝혀지기까지의 역사를 들려주세요.","art":"pi-digits","event":"1749년 오늘, 오일러가 골드바흐에게 두 제곱수의 합에 관한 페르마의 정리를 증명했다고 알렸어요.","born":[{"year":"1794","name":"Germinal Dandelin","slug":"Dandelin"},{"year":"1847","name":"Egor Ivanovich Zolotarev","slug":"Zolotarev"},{"year":"1852","name":"Ferdinand von Lindemann","slug":"Lindemann"},{"year":"1883","name":"Clarence Lewis","slug":"Lewis"},{"year":"1900","name":"William Youden","slug":"Youden"},{"year":"1903","name":"Jan Tinbergen","slug":"Tinbergen"}],"died":[{"year":"1919","name":"Rudolf Sturm","slug":"Sturm_Rudolf"},{"year":"1944","name":"John Raymond Wilton","slug":"Wilton"},{"year":"1971","name":"Wolfgang Krull","slug":"Krull"},{"year":"2000","name":"David Crighton","slug":"Crighton"},{"year":"2023","name":"Ivo Babuska","slug":"Babuska"}]},{"date":"04-13","slug":"Al-Karaji","kind":"born","year":"953","life":"953–c. 1029","name":"al-Karaji","nameKo":"알카라지","title":"대수를 기하에서 떼어 낸 알카라지","body":"알카라지는 바그다드에서 활동한 이슬람 수학자로, 대수를 기하학적 조작에서 벗어나 오늘날과 같은 연산 중심의 학문으로 바꾼 첫 인물로 평가돼요. 대표작 『알파흐리』에서 $x, x^2, x^3, \\dots$ 같은 거듭제곱 항을 정의했어요. 엄밀하지는 않지만 수학적 귀납법과 닮은 논증도 썼어요.","unit":"중1 문자와 식","classroom":"넓이 그림으로 식을 설명하는 방법과 문자로만 계산하는 방법을 비교하며 대수의 편리함을 느끼게 해 보세요.","art":"algebra","event":"1560년 오늘, 카르다노의 아들이 아내를 독살한 죄로 처형되어 카르다노는 깊은 슬픔에 빠졌어요.","born":[{"year":"953","name":"al-Karaji","slug":"Al-Karaji"},{"year":"1728","name":"Paolo Frisi","slug":"Frisi"},{"year":"1813","name":"Duncan Gregory","slug":"Gregory_Duncan"},{"year":"1823","name":"Oscar Schlömilch","slug":"Schlomilch"},{"year":"1850","name":"Arthur Downing","slug":"Downing"},{"year":"1869","name":"Isabel Maddison","slug":"Maddison"},{"year":"1879","name":"Francesco Severi","slug":"Severi"},{"year":"1909","name":"Stan Ulam","slug":"Ulam"},{"year":"1914","name":"Manuel Sadosky","slug":"Sadosky_Manuel"}],"died":[{"year":"1728","name":"Samuel Molyneux","slug":"Molyneux_Samuel"},{"year":"1890","name":"Andrew Hart","slug":"Hart"},{"year":"1906","name":"Raphael Weldon","slug":"Weldon"},{"year":"1941","name":"Annie Jump Cannon","slug":"Cannon"},{"year":"2004","name":"David Fowler","slug":"Fowler_David"},{"year":"2014","name":"Emma Castelnuovo","slug":"Castelnuovo_Emma"},{"year":"2017","name":"Komaravolu Chandrasekharan","slug":"Chandrasekharan"}]},{"date":"04-14","slug":"Huygens","kind":"born","year":"1629","life":"1629–1695","name":"Christiaan Huygens","nameKo":"크리스티안 하위헌스","title":"진자시계와 첫 확률책을 남긴 하위헌스","body":"하위헌스는 처음으로 진자시계 특허를 받아 시간 측정의 정확도를 크게 높인 네덜란드 수학자예요. 직접 만든 렌즈로 1655년 토성의 첫 위성을 찾았고, 토성 고리의 진짜 모양도 밝혔어요. 확률을 다룬 최초의 인쇄된 책 『주사위 놀이의 계산에 대하여』도 썼어요.","unit":"고 확률과 통계","classroom":"도중에 멈춘 주사위 게임의 판돈을 공정하게 나누는 문제를 풀어 보며 첫 확률책을 쓴 하위헌스를 소개해 보세요.","art":"dice","event":"1855년 오늘, 샘 로이드의 첫 체스 문제가 뉴욕의 한 신문에 실렸어요.","born":[{"year":"1629","name":"Christiaan Huygens","slug":"Huygens"},{"year":"1868","name":"Annie Scott Dill Maunder","slug":"Maunder"},{"year":"1917","name":"Nathan Mendelsohn","slug":"Mendelsohn"},{"year":"1920","name":"Donald Pack","slug":"Pack"},{"year":"1927","name":"John Amson","slug":"A