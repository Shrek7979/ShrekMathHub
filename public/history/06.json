:"Lois Griffiths","slug":"Griffiths_Lois"},{"year":"1915","name":"Aleksandr Yakovlevich Povzner","slug":"Povzner"},{"year":"1940","name":"Daniel Quillen","slug":"Quillen"}],"died":[{"year":"1831","name":"Sophie Germain","slug":"Germain"},{"year":"1880","name":"Carl Borchardt","slug":"Borchardt"},{"year":"1883","name":"William Spottiswoode","slug":"Spottiswoode"},{"year":"1952","name":"Max Dehn","slug":"Dehn"},{"year":"1975","name":"Geoffrey Taylor","slug":"Taylor_Geoffrey"},{"year":"1982","name":"Tadija Pejovic","slug":"Pejovic"},{"year":"1989","name":"Newby Curle","slug":"Curle"},{"year":"2023","name":"Evelyn Boyd Granville","slug":"Granville"}]},{"date":"06-28","slug":"Lebesgue","kind":"born","year":"1875","life":"1875–1941","name":"Henri Lebesgue","nameKo":"앙리 르베그","title":"적분의 개념을 넓힌 르베그","body":"앙리 르베그는 1901년 측도 이론을 세우고, 리만 적분을 일반화한 르베그 적분을 정의한 프랑스의 수학자예요. 곡선 아래 넓이라는 개념을 여러 불연속함수에까지 넓혀 적분학에 혁명을 일으켰어요. 인쇄공의 아들로, 낭시의 고등학교에서 수학을 가르치던 시기에 이 연구를 발표했어요.","unit":"고 적분","classroom":"정적분을 넓이로 이해한 뒤, 고등학교 교사 시절 적분을 새로 정의한 르베그를 소개해 보세요.","art":"riemann","event":"1884년 오늘, 소피야 코발렙스카야가 스톡홀름 대학교 교수로 정식 임명되었어요.","born":[{"year":"1858","name":"Alice Lee","slug":"Lee"},{"year":"1858","name":"Boleslav Mlodzeevsky","slug":"Mlodzeevsky"},{"year":"1875","name":"Henri Lebesgue","slug":"Lebesgue"},{"year":"1880","name":"Leo Harmaja","slug":"Harmaja"},{"year":"1888","name":"Bibhutibhushan Datta","slug":"Datta"},{"year":"1894","name":"Einar Carl Hille","slug":"Hille"},{"year":"1920","name":"Nicolaas Kuiper","slug":"Kuiper"},{"year":"1928","name":"Gordon Pask","slug":"Pask"},{"year":"1929","name":"Ward Cheney","slug":"Cheney"},{"year":"1934","name":"Michael Artin","slug":"Artin_Michael"}],"died":[{"year":"1796","name":"Antonio Mario Lorgna","slug":"Lorgna"},{"year":"1889","name":"Maria Mitchell","slug":"Mitchell_Maria"},{"year":"1930","name":"William J Greenstreet","slug":"Greenstreet"},{"year":"1944","name":"Alfreds Meders","slug":"Meders"},{"year":"1952","name":"William Watson","slug":"Watson_William"},{"year":"1972","name":"Prasanta Chandra Mahalanobis","slug":"Mahalanobis"},{"year":"1984","name":"Claude Chevalley","slug":"Chevalley"}]},{"date":"06-29","slug":"Mahalanobis","kind":"born","year":"1893","life":"1893–1972","name":"Prasanta Chandra Mahalanobis","nameKo":"프라산타 찬드라 마할라노비스","title":"인도 통계학의 기틀을 세운 마할라노비스","body":"프라산타 찬드라 마할라노비스는 통계학과 그 응용에 큰 업적을 남기고 인도 통계연구소를 세운 인도의 수학자예요. 영국 유학 중 케임브리지에 들렀다가 기차를 놓쳐 친구 집에 묵었는데, 그 인연으로 다음 날 면접을 보고 킹스 칼리지에 입학했어요. 그곳에서 라마누잔과 친구가 되었어요.","unit":"고 확률과 통계","classroom":"통계 단원에서 기차를 놓친 덕에 케임브리지에 간 마할라노비스 일화로 '우연'에 대해 이야기해 보세요.","art":"rose","event":"1552년 오늘, 카르다노가 세인트앤드루스 대주교를 치료하러 에든버러에 도착했어요.","born":[{"year":"1807","name":"Moritz Abraham Stern","slug":"Stern"},{"year":"1884","name":"Wilhelm Winkler","slug":"Winkler"},{"year":"1893","name":"Eduard Čech","slug":"Cech"},{"year":"1893","name":"Prasanta Chandra Mahalanobis","slug":"Mahalanobis"},{"year":"1893","name":"Mikhail Fedorovich Subbotin","slug":"Subbotin"},{"year":"1895","name":"Cyrus Colton MacDuffee","slug":"MacDuffee"},{"year":"1899","name":"Stanley Skewes","slug":"Skewes"},{"year":"1904","name":"Witold Hurewicz","slug":"Hurewicz"},{"year":"1972","name":"Edray Herber Goins","slug":"Goins"},{"year":"1979","name":"Artur Ávila","slug":"Avila"}],"died":[{"year":"1862","name":"James Lindsay","slug":"Lindsay"},{"year":"1924","name":"Robert Woodward","slug":"Woodward"},{"year":"1934","name":"Francesco Gerbaldi","slug":"Gerbaldi"},{"year":"1966","name":"D D Kosambi","slug":"Kosambi"}]},{"date":"06-30","slug":"Thompson_Abigail","kind":"born","year":"1958","life":"1958–","name":"Abigail Thompson","nameKo":"애비게일 톰프슨","title":"매듭 이론을 연구하는 애비게일 톰프슨","body":"애비게일 톰프슨은 3차원 위상수학을 조합적 방법으로 연구하는 미국의 수학자예요. 박사 논문에서 몇 가지 종류의 매듭이 특정한 성질을 가진다는 것을 증명했고, 2003년 미국수학회의 새터상을 받았어요. 대학생 강연에서는 '정말로 서로 다른 매듭은 몇 개일까?' 같은 자연스러운 질문도 아직 다 풀리지 않았다고 소개했어요.","unit":"공통","classroom":"끈으로 매듭을 만들어 '두 매듭이 같은지' 판단해 보는 활동으로 톰프슨의 매듭 이론을 맛보게 해 보세요.","art":"torus","event":"1742년 오늘, 오일러가 골드바흐에게