},{"year":"1855","name":"Eduard Wiltheiss","slug":"Wiltheiss"},{"year":"1888","name":"Zygmunt Janiszewski","slug":"Janiszewski"},{"year":"1904","name":"Adolf Lindenbaum","slug":"Lindenbaum"},{"year":"1914","name":"Wassily Hoeffding","slug":"Hoeffding"},{"year":"1937","name":"Vladimir Arnold","slug":"Arnold"}],"died":[{"year":"1835","name":"Edward Troughton","slug":"Troughton"},{"year":"1900","name":"Jean Frenet","slug":"Frenet"},{"year":"1929","name":"Henri Andoyer","slug":"Andoyer"},{"year":"1945","name":"Boris G Galerkin","slug":"Galerkin"},{"year":"1980","name":"Egon Pearson","slug":"Pearson_Egon"},{"year":"1985","name":"Hua Loo-Keng","slug":"Hua"}]},{"date":"06-13","slug":"Maxwell","kind":"born","year":"1831","life":"1831–1879","name":"James Clerk Maxwell","nameKo":"제임스 클러크 맥스웰","title":"14살에 타원을 일반화한 맥스웰","body":"제임스 클러크 맥스웰은 전기, 자기, 광학, 기체 분자 운동론에서 혁명적인 업적을 남긴 스코틀랜드의 과학자예요. 학교에서 처음엔 '멍청이'라는 별명으로 불렸지만, 14살에 타원의 정의를 일반화한 곡선에 관한 논문을 썼고 이 논문은 에든버러 왕립학회에서 발표되었어요.","unit":"고 기하","classroom":"타원의 정의를 배운 뒤 '두 거리에 서로 다른 배수를 곱하면?'이라는 14살 맥스웰의 질문을 탐구 과제로 내 보세요.","art":"conic","event":"1771년 오늘, 라그랑주가 '$p$가 소수일 필요충분조건은 $(p-1)!+1$이 $p$로 나누어떨어지는 것'이라는 윌슨 정리를 처음 증명했어요.","born":[{"year":"1555","name":"Giovanni Magini","slug":"Magini"},{"year":"1580","name":"Willebrord Snell","slug":"Snell"},{"year":"1773","name":"Thomas Young","slug":"Young_Thomas"},{"year":"1831","name":"James Clerk Maxwell","slug":"Maxwell"},{"year":"1839","name":"James Bolam","slug":"Bolam"},{"year":"1871","name":"Ernst Steinitz","slug":"Steinitz"},{"year":"1872","name":"Chrystal Macmillan","slug":"MacMillan_Chrystal"},{"year":"1876","name":"William Gosset","slug":"Gosset"},{"year":"1883","name":"Neil McArthur","slug":"McArthur"},{"year":"1891","name":"Pierre Humbert","slug":"Humbert_Pierre"},{"year":"1902","name":"Carolyn Eisele","slug":"Eisele"},{"year":"1906","name":"Bruno de Finetti","slug":"De_Finetti"},{"year":"1928","name":"John F Nash","slug":"Nash"},{"year":"1931","name":"Herbert Wilf","slug":"Wilf"},{"year":"1931","name":"Bogdan Bojarski","slug":"Bojarski"},{"year":"1957","name":"Alexander Beilinson","slug":"Beilinson"},{"year":"1966","name":"Grigori Yakovlevich Perelman","slug":"Perelman"}],"died":[{"year":"1660","name":"William Oughtred","slug":"Oughtred"},{"year":"1882","name":"William Shanks","slug":"Shanks"},{"year":"1909","name":"Albin Herzog","slug":"Herzog"},{"year":"1939","name":"Hermann Wiener","slug":"Wiener_Hermann"},{"year":"1991","name":"Marek Kuczma","slug":"Kuczma"},{"year":"1994","name":"John Britton","slug":"Britton"}]},{"date":"06-14","slug":"Nilakantha","kind":"born","year":"1444","life":"1444–1501 이후","name":"Nilakantha","nameKo":"닐라칸타 소마야지","title":"원주율 무한급수를 다룬 인도의 닐라칸타","body":"닐라칸타는 남인도 케랄라의 수학자이자 천문학자로, 천문학과 무한급수에 관한 책을 남겼어요. 1501년의 대표작 『탄트라상그라하』는 432개의 산스크리트 시구로 이루어져 있어요. 마다바가 발견한 결과를 이어받아 넓혔고, $\\frac{\\pi}{4}=1-\\frac{1}{3}+\\frac{1}{5}-\\cdots$ 같은 급수와 관련된 업적으로 알려져 있어요.","unit":"고 수열","classroom":"계산기로 $1-\\frac{1}{3}+\\frac{1}{5}-\\cdots$를 여러 항 더한 뒤 4를 곱해 원주율에 다가가 보세요.","art":"pi-digits","event":"1822년 오늘, 배비지가 오늘날 컴퓨터의 선구자인 차분기관을 완성했다고 런던 천문학회에서 발표했어요.","born":[{"year":"1444","name":"Nilakantha","slug":"Nilakantha"},{"year":"1736","name":"Charles Augustin Coulomb","slug":"Coulomb"},{"year":"1796","name":"Nikolai Dmetrievich Brashman","slug":"Brashman"},{"year":"1856","name":"Andrei Andreyevich Markov","slug":"Markov"},{"year":"1860","name":"Frank Carey","slug":"Carey"},{"year":"1868","name":"Gilbert Walker","slug":"Walker_Gilbert"},{"year":"1903","name":"Alonzo Church","slug":"Church"},{"year":"1910","name":"Fritz John","slug":"John"},{"year":"1913","name":"Adriaan Cornelis Zaanen","slug":"Zaanen"},{"year":"1917","name":"Atle Selberg","slug":"Selberg"},{"year":"1935","name":"Louise Szmir Hay","slug":"Hay"}],"died":[{"year":"1746","name":"Colin Maclaurin","slug":"Maclaurin"},{"year":"1886","name":"Jules Hoüel","slug":"Houel"},{"year":"1946","name":"Federigo Enriques","slug":"Enriques"},{"year":"1957","name":"Theodoros Varopoulos","slug":"Varopoulos"},{"year":"1969","name":"Ottó Varga","slug":"Varga_Otto"},{"year":"2008","name":"Yurii Alekseevich Mitropolskii","slug":"Mytropolsky"},{"year":"2023","name":"K R Parthasarathy","slug":"Parthasarathy"}]},{"date":"06-15","slug":"Chebotaryov","kind":"born","year":"1894","life":"1894–1947","name":"Nikolai Chebotaryov","nameKo":"니콜라이 체보타료프","title":"등차수열 속 소수를 파고든 체보타료프","body":"니콜라이 체보타료프는 우크라이나 출신의 소련 수학자로, 1922년 '밀도 정리'를 증명했어요. 이 정리는 등차수열 속 소수에 관한 디리클레의 정리를 일반화한 것이에요. 15살 무렵부터 수학을 사랑했고, 생계를 위해 개인 교습과 학교 수업을 하며 연구를 이어 갔어요.","unit":"고 수열","classroom":"등차수열 1, 5, 9, 13, 17, …에서 소수를 찾아보게 한 뒤 체보타료프와 디리클레의 정리를 소개해 보세요.","art":"primes","event":"1641년 오늘, 페르마가 $4n+1$ 꼴의 소수는 두 제곱수의 합이라는 정리를 증명했다고 편지에 썼어요.","born":[{"year":"1640","name":"Bernard Lamy","slug":"Lamy"},{"year":"1884","name":"William Watson","slug":"Watson_William"},{"year":"1894","name":"Nikolai Chebotaryov","slug":"Chebotaryov"},{"year":"1906","name":"Gordon Welchman","slug":"Welchman"},{"year":"1933","name":"Moshe Carmeli","slug":"Carmeli"}],"died":[{"year":"1938","name":"Hans Fitting","slug":"Fitting"}]},{"date":"06-16","slug":"Tukey","kind":"born","year":"1915","life":"1915–2000","name":"John Tukey","nameKo":"존 튜키","title":"고속 푸리에 변환을 도입한 통계학자 튜키","body":"존 튜키는 고속 푸리에 변환을 도입하고 통계학의 여러 분야를 개척한 미국의 수학자예요. 고등학교 교사였던 부모에게 집에서 교육을 받았는데, 부모는 질문에 바로 답하지 않고 단서와 되묻기로 스스로 찾게 했어요. 화학을 공부하다 수학으로 옮겼고, 제2차 세계대전 때 포병 연구를 하며 통계에 빠져들었어요.","unit":"고 확률과 통계","classroom":"질문에 답 대신 단서를 주는 튜키 부모의 방식을 소개하며 통계 탐구 활동을 시작해 보세요.","art":"rose","event":"1902년 오늘, 러셀이 프레게에게 편지를 보내 그의 산술 체계에 모순이 있음을 알렸어요.","born":[{"year":"1640","name":"Jacques Ozanam","slug":"Ozanam"},{"year":"1839","name":"Julius Petersen","slug":"Petersen"},{"year":"1866","name":"James Pierpont","slug":"Pierpont"},{"year":"1888","name":"Alexander Friedmann","slug":"Friedmann"},{"year":"1915","name":"John Tukey","slug":"Tukey"}],"died":[{"year":"1902","name":"Ernst Schröder","slug":"Schroder"},{"year":"1910","name":"Julius Weingarten","slug":"Weingarten"},{"year":"1948","name":"Marcel Brillouin","slug":"Brillouin"},{"year":"1970","name":"Sydney Chapman","slug":"Chapman"},{"year":"1975","name":"Karl Dörge","slug":"Dorge"},{"year":"1990","name":"Tom Cowling","slug":"Cowling"},{"year":"2001","name":"Alessandro Faedo","slug":"Faedo"},{"year":"2004","name":"Herman Goldstine","slug":"Goldstine"}]},{"date":"06-17","slug":"Escher","kind":"born","year":"1898","life":"1898–1972","name":"Maurits Escher","nameKo":"마우리츠 코르넬리스 에셔","title":"평면 채우기 판화로 수학을 그린 에셔","body":"마우리츠 에셔는 작품 속에 수학이 가득 담긴 네덜란드의 판화가예요. 학교에서는 산수와 대수를 무척 어려워했지만, 어릴 때 치즈 조각을 빵 위에 빈틈없이 맞춰 덮을 만큼 '평면 채우기'에 관심이 많았대요. 스페인 알람브라 궁전의 타일 무늬에 감명받아 같은 모양이 빈틈없이 반복되는 작품을 만들었어요.","unit":"중1 평면도형","classroom":"합동인 도형으로 평면을 빈틈없이 채우는 테셀레이션 활동에 에셔의 작품을 함께 보여 주세요.","art":"symmetry","event":"1870년 오늘, 벤저민 퍼스가 논리학을 공부하는 아들 찰스 퍼스를 드모르간에게 소개하는 편지를 보냈어요.","born":[{"year":"1714","name":"César-François Cassini de Thury","slug":"Cassini_de_Thury"},{"year":"1898","name":"Maurits Escher","slug":"Escher"},{"year":"1903","name":"William Hodge","slug":"Hodge"},{"year":"1906","name":"Tom Cowling","slug":"Cowling"},{"year":"1906","name":"Samuel Wilks","slug":"Wilks"},{"year":"1928","name":"Iain Adamson","slug":"Adamson"},{"year":"1939","name":"Carlo Cercignani","slug":"Cercignani"},{"year":"1947","name":"Wolfgang Alt","slug":"Alt"}],"died":[{"year":"1918","name":"Johann Heinrich Graf","slug":"Graf"},{"year":"1956","name":"David Picken","slug":"Picken"},{"year":"1994","name":"Frank Yates","slug":"Yates"},{"year":"2012","name":"Nathan Divinsky","slug":"Divinsky"}]},{"date":"06-18","slug":"Schafer","kind":"born","year":"1915","life":"1915–2009","name":"Alice T Schafer","nameKo":"앨리스 셰이퍼","title":"여성수학자협회를 세운 앨리스 셰이퍼","body":"앨리스 셰이퍼는 여성수학자협회의 창립 회원 중 한 명인 미국의 수학자예요. 초등학생 때 선생님이 '너는 긴 나눗셈을 절대 못 할 것'이라고 하자 오히려 그 도전에 빠져들었대요. 고등학교 교장은 수학은 여자의 과목이 아니라며 반대했지만, 리치먼드 대학교에서 수학을 공부해 실해석학 상까지 받았어요.","unit":"공통","classroom":"'넌 못 할 거야'라는 말을 도전으로 바꾼 셰이퍼 이야기로 어려운 단원 앞에서 학생들을 격려해 보세요.","art":"letter","event":"1864년 오늘, 루이스 캐럴이 『이상한 나라의 앨리스』를 글로 정리하기로 마음먹었어요.","born":[{"year":"1858","name":"Andrew Forsyth","slug":"Forsyth"},{"year":"1872","name":"George Moffat","slug":"Moffat"},{"year":"1884","name":"Frieda Nugel","slug":"Nugel"},{"year":"1884","name":"Charles Weatherburn","slug":"Weatherburn"},{"year":"1909","name":"Feodor Theilheimer","slug":"Theilheimer"},{"year":"1910","name":"Maurice Bartlett","slug":"Bartlett"},{"year":"1913","name":"Oswald Teichmüller","slug":"Teichmuller"},{"year":"1915","name":"Alice T Schafer","slug":"Schafer"},{"year":"1930","name":"Newby Curle","slug":"Curle"},{"year":"1932","name":"Joachim Neubüser","slug":"Neubuser"}],"died":[{"year":"1883","name":"John Waterston","slug":"Waterston"},{"year":"1974","name":"Júlio Mello e Souza","slug":"Souza"},{"year":"1978","name":"Peter Stefan","slug":"Stefan_Peter"},{"year":"1980","name":"Kazimierz Kuratowski","slug":"Kuratowski"},{"year":"2005","name":"Manuel Sadosky","slug":"Sadosky_Manuel"},{"year":"2016","name":"George Butcher","slug":"Butcher"}]},{"date":"06-19","slug":"Pascal","kind":"born","year":"1623","life":"1623–1662","name":"Blaise Pascal","nameKo":"블레즈 파스칼","title":"페르마와 함께 확률론의 기초를 놓은 파스칼","body":"블레즈 파스칼은 원뿔곡선과 사영기하학을 연구하고, 페르마와 편지를 주고받으며 확률론의 기초를 놓은 프랑스의 수학자이자 철학자예요. 아버지가 15살 전에는 수학을 못 하게 책을 치웠지만, 12살에 혼자서 삼각형의 세 각의 합이 두 직각과 같다는 사실을 알아냈어요. 세금을 걷는 아버지를 돕기 위해 계산기도 발명했어요.","unit":"고 확률과 통계","classroom":"확률 단원 도입에서 파스칼과 페르마가 편지로 확률의 기초를 놓은 이야기를 들려주세요.","art":"dice","event":"325년 오늘, 니케아 공의회가 열려 부활절을 '춘분 뒤 첫 보름달 다음 일요일'로 정하는 규칙을 마련했어요.","born":[{"year":"1623","name":"Blaise Pascal","slug":"Pascal"},{"year":"1771","name":"Joseph Gergonne","slug":"Gergonne"},{"year":"1851","name":"James Taylor","slug":"Taylor_James"},{"year":"1854","name":"Hjalmar Mellin","slug":"Mellin"},{"year":"1901","name":"Raj Chandra Bose","slug":"Bose_Raj"},{"year":"1902","name":"Wallace J Eckert","slug":"Eckert_Wallace"},{"year":"1907","name":"Børge Jessen","slug":"Jessen"},{"year":"1927","name":"Frank Levin","slug":"Levin_Frank"},{"year":"1941","name":"Derek Waller","slug":"Waller"}],"died":[{"year":"1932","name":"William Briggs","slug":"Briggs_William"},{"year":"1945","name":"Stefan Mazurkiewicz","slug":"Mazurkiewicz"},{"year":"2002","name":"Zoltán Balogh","slug":"Balogh"}]},{"date":"06-20","slug":"Rasiowa","kind":"born","year":"1917","life":"1917–1994","name":"Helena Rasiowa","nameKo":"헬레나 라시오바","title":"대수 논리학으로 컴퓨터의 기초를 다진 라시오바","body":"헬레나 라시오바는 대수 논리학과 컴퓨터 과학의 수학적 기초를 연구한 폴란드의 수학자예요. 나치 점령 아래 비밀리에 운영된 지하 대학에서 위험을 무릅쓰고 수학을 공부했어요. 1944년 바르샤바 봉기 때 석사 논문이 집과 함께 불탔지만, 전쟁이 끝난 뒤 다시 논문을 써서 학위를 받았어요.","unit":"고 명제","classroom":"명제와 논리 단원에서 불타 버린 논문을 다시 쓴 라시오바 이야기로 끈기의 의미를 나눠 보세요.","art":"godel","event":"1877년 오늘, 칸토어가 데데킨트에게 정사각형 안의 점과 선분 위의 점을 일대일로 대응시킬 수 있다는 증명을 알렸어요.","born":[{"year":"1775","name":"Jacques Français","slug":"Francais_Jacques"},{"year":"1838","name":"Theodor Reye","slug":"Reye"},{"year":"1873","name":"Alfred Loewy","slug":"Loewy"},{"year":"1880","name":"George Carse","slug":"Carse"},{"year":"1885","name":"F F P Bisacre","slug":"Bisacre"},{"year":"1907","name":"John Womersley","slug":"Womersley"},{"year":"1917","name":"Helena Rasiowa","slug":"Rasiowa"},{"year":"1942","name":"Neil Trudinger","slug":"Trudinger"},{"year":"1946","name":"Nigel Kalton","slug":"Kalton"},{"year":"1946","name":"David Kazhdan","slug":"Kazhdan"}],"died":[{"year":"1800","name":"Abraham Kästner","slug":"Kaestner"},{"year":"1863","name":"Vincenzo Flauti","slug":"Flauti"},{"year":"1963","name":"Raphaël Salem","slug":"Salem"},{"year":"1966","name":"Georges Lemaître","slug":"Lemaitre"},{"year":"1990","name":"Kosaku Yosida","slug":"Yosida"},{"year":"2012","name":"William Wager Cooper","slug":"Cooper_William"}]},{"date":"06-21","slug":"Poisson","kind":"born","year":"1781","life":"1781–1840","name":"Siméon-Denis Poisson","nameKo":"시메옹 드니 푸아송","title":"정적분과 푸리에 급수를 연구한 푸아송","body":"시메옹 드니 푸아송은 정적분과 푸리에 급수를 연구해 디리클레와 리만의 후속 연구에 바탕을 놓은 프랑스의 수학자예요. 처음엔 외과 의사 견습생이 되었지만 손이 서툴러 그만두었고, 수학 그림조차 잘 그리지 못했대요. 대신 스승 라플라스와 라그랑주가 일찍 그 재능을 알아보았고 평생 친구가 되었어요.","unit":"고 적분","classroom":"손재주가 없어 의사의 길을 접고 수학에서 빛난 푸아송 이야기로 '나에게 맞는 길'을 함께 생각해 보세요.","art":"riemann","event":"1976년 오늘, 아펠과 하켄이 컴퓨터를 이용해 4색 정리를 증명했다고 발표했어요.","born":[{"year":"1781","name":"Siméon-Denis Poisson","slug":"Poisson"},{"year":"1802","name":"Jean-Baptiste Brasseur","slug":"Brasseur"},{"year":"1828","name":"Giuseppe Bruno","slug":"Bruno"},{"year":"1868","name":"James Macdonald","slug":"Macdonald_James"},{"year":"1872","name":"Onorato Nicoletti","slug":"Nicoletti"},{"year":"1894","name":"Harry Schmidt","slug":"Schmidt_Harry"},{"year":"1918","name":"Tibor Szele","slug":"Szele"},{"year":"1928","name":"Chukwuka Okonjo","slug":"Okonjo"},{"year":"1954","name":"Pavel Krejčí","slug":"Krejci"},{"year":"1964","name":"Haim Nessyahu","slug":"Nessyahu"}],"died":[{"year":"1820","name":"Alexis Petit","slug":"Petit"},{"year":"1824","name":"Nicola Fergola","slug":"Fergola"},{"year":"1913","name":"Gaston Tarry","slug":"Tarry"},{"year":"1929","name":"Ferdinand Rudio","slug":"Rudio"},{"year":"1940","name":"Wolfgang Doeblin","slug":"Doeblin"},{"year":"1947","name":"Nikolai Sergeevitch Krylov","slug":"Krylov_Nikolai_S"},{"year":"1948","name":"D'Arcy Thompson","slug":"Thompson_DArcy"},{"year":"1957","name":"Maurice Audin","slug":"Audin"},{"year":"1999","name":"Edwin Hewitt","slug":"Hewitt_Edwin"},{"year":"2007","name":"Jack Todd","slug":"Todd_John"},{"year":"2017","name":"Jean-Pierre Kahane","slug":"Kahane"}]},{"date":"06-22","slug":"Minkowski","kind":"born","year":"1864","life":"1864–1909","name":"Hermann Minkowski","nameKo":"헤르만 민코프스키","title":"상대성이론의 수학적 기초를 놓은 민코프스키","body":"헤르만 민코프스키는 공간과 시간을 새롭게 바라보는 관점을 세워 상대성이론의 수학적 기초를 놓은 독일의 수학자예요. 대학 시절 힐베르트와 가까운 친구가 되었어요. 18살 때는 정수를 다섯 제곱수의 합으로 나타내는 방법의 수를 묻는 파리 과학아카데미 대상 문제에 도전해 아이젠슈타인의 이론을 재구성해 냈어요.","unit":"고 기하","classroom":"좌표에 시간 축을 하나 더 붙이면 어떻게 될지 물으며 '시공간'을 생각한 민코프스키를 소개해 보세요.","art":"coordinates","event":"1633년 오늘, 갈릴레오가 종교재판에서 지동설을 철회하도록 강요받고 종신형을 선고받았어요.","born":[{"year":"1837","name":"Paul Bachmann","slug":"Bachmann"},{"year":"1852","name":"Eduard Weyr","slug":"Weyr_Eduard"},{"year":"1857","name":"Adolf Kiefer","slug":"Kiefer_Adolf"},{"year":"1860","name":"Mario Pieri","slug":"Pieri"},{"year":"1864","name":"Hermann Minkowski","slug":"Minkowski"},{"year":"1866","name":"Kazimierz Żorawski","slug":"Zorawski"},{"year":"1906","name":"Ott-Heinrich Keller","slug":"Keller"},{"year":"1910","name":"Konrad Zuse","slug":"Zuse"},{"year":"1913","name":"Levan Magnaradze","slug":"Magnaradze"},{"year":"1921","name":"Ronald Mitchell","slug":"Mitchell"},{"year":"1932","name":"Mary Warner","slug":"Warner"},{"year":"1943","name":"Menso Folkerts","slug":"Folkerts"}],"died":[{"year":"1450","name":"al-Kashi","slug":"Al-Kashi"},{"year":"1825","name":"Johann Karl Burckhardt","slug":"Burckhardt"},{"year":"1892","name":"Pierre Bonnet","slug":"Bonnet"},{"year":"1925","name":"Felix Klein","slug":"Klein"},{"year":"1977","name":"Marston Morse","slug":"Morse"}]},{"date":"06-23","slug":"Turing","kind":"born","year":"1912","life":"1912–1954","name":"Alan Turing","nameKo":"앨런 튜링","title":"컴퓨터 과학의 이론적 토대를 세운 튜링","body":"앨런 튜링은 컴퓨터 과학의 이론적 토대를 세운 영국의 수학자예요. 학창 시절 배운 방법 대신 자기 방식으로 풀어 선생님들의 눈총을 받았지만, 수학 상은 거의 다 받았어요. 케임브리지 연구원 논문에서는 이미 알려진 줄 모르고 중심극한정리를 혼자 다시 발견했고, 이후 '알고리즘으로 판정할 수 없는 문제'를 파고들었어요.","unit":"공통","classroom":"알고리즘 활동 전에 '어떤 문제는 기계로 판정할 수 없을까?'라는 튜링의 질문을 던져 보세요.","art":"turing","event":"1783년 오늘, 에든버러 왕립학회가 에든버러 대학교 옛 도서관에서 첫 모임을 열었어요.","born":[{"year":"1612","name":"Andrea Tacquet","slug":"Tacquet"},{"year":"1746","name":"William Trail","slug":"Trail"},{"year":"1824","name":"Zacharias Dase","slug":"Dase"},{"year":"1841","name":"Woolsey Johnson","slug":"Johnson_Woolsey"},{"year":"1858","name":"William Johnson","slug":"Johnson"},{"year":"1871","name":"John Turner","slug":"Turner_John"},{"year":"1895","name":"Bernard Childs","slug":"Childs"},{"year":"1912","name":"Alan Turing","slug":"Turing"},{"year":"1914","name":"Colin Cherry","slug":"Cherry_Colin"},{"year":"1941","name":"Ivor Grattan-Guinness","slug":"Grattan-Guinness"},{"year":"1944","name":"Richard Stanley","slug":"Stanley"},{"year":"1959","name":"Benoît Perthame","slug":"Perthame"}],"died":[{"year":"1891","name":"Wilhelm Weber","slug":"Weber"},{"year":"1978","name":"Derek Waller","slug":"Waller"}]},{"date":"06-24","slug":"Clarke_Joan","kind":"born","year":"1917","life":"1917–1996","name":"Joan Clarke","nameKo":"조앤 클라크","title":"튜링과 함께 에니그마 암호를 푼 클라크","body":"조앤 클라크는 제2차 세계대전 때 블레츨리 파크에서 앨런 튜링과 함께 독일의 에니그마 암호를 해독한 영국의 수학자예요. 케임브리지에서 수학 최우등 성적을 받았지만, 당시 여성은 대학의 정식 구성원이 될 수 없었어요. 그녀에게 기하학을 가르친 고든 웰치먼이 실력을 알아보고 암호 해독 팀에 데려왔어요.","unit":"중2 확률","classroom":"경우의 수를 배울 때 설정이 매일 바뀌는 에니그마의 엄청난 경우의 수와 클라크의 해독 이야기를 들려주세요.","art":"letter","event":"1634년 오늘, 로베르발이 라무스 교수직 경쟁에서 이겼고, 자리를 지키려고 이후 자기 발견을 비밀로 했어요.","born":[{"year":"1877","name":"Thomas Havelock","slug":"Havelock"},{"year":"1880","name":"Oswald Veblen","slug":"Veblen"},{"year":"1888","name":"Georges Darmois","slug":"Darmois"},{"year":"1900","name":"Wilhelm Cauer","slug":"Cauer"},{"year":"1909","name":"Bill Penney","slug":"Penney"},{"year":"1915","name":"Fred Hoyle","slug":"Hoyle"},{"year":"1917","name":"Joan Clarke","slug":"Clarke_Joan"},{"year":"1924","name":"László Fuchs","slug":"Fuchs_Laszlo"},{"year":"1927","name":"Slamet Dajono","slug":"Dajono"},{"year":"1930","name":"Satoshi Suzuki","slug":"Suzuki_Satoshi"}],"died":[{"year":"1832","name":"Timofei Fedorovic Osipovsky","slug":"Osipovsky"},{"year":"1880","name":"Jules Lissajous","slug":"Lissajous"},{"year":"1978","name":"Mstislav Vsevolodovich Keldysh","slug":"Keldysh_Mstislav"},{"year":"2005","name":"Günter Lumer","slug":"Lumer"},{"year":"2009","name":"Elena Moldovan Popoviciu","slug":"Popoviciu_Elena"}]},{"date":"06-25","slug":"Quine","kind":"born","year":"1908","life":"1908–2000","name":"Willard Van Quine","nameKo":"윌러드 밴 오먼 콰인","title":"수학과 철학을 이은 논리학자 콰인","body":"윌러드 밴 오먼 콰인은 미국의 철학자이자 논리학자예요. 대학 시절 러셀과 화이트헤드의 『수학 원리』를 읽고 수학을 전공으로 정했고, 하버드에서 화이트헤드의 지도로 2년 만에 박사 학위를 받았어요. 유럽 여행에서 괴델, 타르스키, 카르나프를 만났는데, 돌아올 때 남은 돈이 딱 7달러였대요.","unit":"고 명제","classroom":"명제의 참·거짓을 따지는 수업에서 수학과 철학을 잇는 논리학자로 콰인을 소개해 보세요.","art":"godel","event":"1649년 오늘, 크리스토퍼 렌이 옥스퍼드의 워덤 칼리지에 입학했어요.","born":[{"year":"1734","name":"Monteiro da Rocha","slug":"Rocha"},{"year":"1866","name":"Ralph Sampson","slug":"Sampson"},{"year":"1888","name":"William Threlfall","slug":"Threlfall"},{"year":"1906","name":"Samuel Verblunsky","slug":"Verblunsky"},{"year":"1908","name":"Gustav Elfving","slug":"Elfving"},{"year":"1908","name":"Willard Van Quine","slug":"Quine"},{"year":"1931","name":"Anatoli Georgievich Vitushkin","slug":"Vitushkin"},{"year":"1936","name":"K R Parthasarathy","slug":"Parthasarathy"}],"died":[{"year":"1671","name":"Giovanni Battista Riccioli","slug":"Riccioli"},{"year":"1936","name":"Stefan Cohn-Vossen","slug":"Cohn-Vossen"},{"year":"1941","name":"Alfred Pringsheim","slug":"Pringsheim"},{"year":"1948","name":"Bento Caraça","slug":"Caraca"},{"year":"1974","name":"Cornelius Lanczos","slug":"Lanczos"},{"year":"1978","name":"Hsien C Wang","slug":"Wang"},{"year":"1989","name":"Udo Wegner","slug":"Wegner"},{"year":"1995","name":"Ernest Walton","slug":"Walton"},{"year":"2006","name":"Irving Kaplansky","slug":"Kaplansky"},{"year":"2014","name":"Abdulalim Shabazz","slug":"Shabazz"}]},{"date":"06-26","slug":"Thomson","kind":"born","year":"1824","life":"1824–1907","name":"William Thomson","nameKo":"윌리엄 톰슨(켈빈 경)","title":"열역학과 해저 전신을 이끈 켈빈 경","body":"켈빈 경으로 더 잘 알려진 윌리엄 톰슨은 전기, 자기, 열역학 등 물리학 여러 분야에 큰 업적을 남긴 과학자예요. 10살에 글래스고 대학교에 다니기 시작했고, 15살에 쓴 지구의 모양에 관한 논문으로 금메달을 받았어요. 푸리에의 열 이론 책을 두 주 만에 독파했고, 첫 대서양 횡단 전신 케이블 일로 큰 재산을 모았어요.","unit":"공통","classroom":"푸리에의 책을 두 주 만에 읽은 15살 톰슨 이야기로 '어려운 책에 도전하기' 독서 활동을 열어 보세요.","art":"conic","event":"1927년 오늘, 네이만이 바르샤바 대학교에서 교수 자격을 얻었고, 이듬해 생물측정 연구실을 세웠어요.","born":[{"year":"1824","name":"William Thomson","slug":"Thomson"},{"year":"1878","name":"Leopold Löwenheim","slug":"Lowenheim"},{"year":"1896","name":"Vernon Morton","slug":"Morton_V