[{"date":"06-01","slug":"Robertson_Edmund","kind":"born","year":"1943","life":"1943–","name":"Edmund Robertson","nameKo":"에드먼드 로버트슨","title":"맥튜터 수학사 아카이브를 만든 로버트슨","body":"에드먼드 로버트슨은 스코틀랜드 세인트앤드루스에서 태어난 수학자예요. 동료와 함께 세계적인 수학사 자료실인 '맥튜터 수학사 아카이브'를 만들고 가꾸어 왔고, 4년마다 열리는 세인트앤드루스 군론 학회도 함께 시작했어요. 우리가 보는 '오늘의 수학사'도 그가 만든 맥튜터 자료를 바탕으로 해요.","unit":"공통","classroom":"수학자 조사 과제를 낼 때 맥튜터 아카이브를 소개하고, 그것을 만든 사람의 생일을 함께 알려 주세요.","art":"textbook","event":"2003년 오늘, 장피에르 세르가 첫 아벨상 수상자가 되었어요.","born":[{"year":"1796","name":"Sadi Carnot","slug":"Carnot_Sadi"},{"year":"1815","name":"Osip Somov","slug":"Somov"},{"year":"1849","name":"Gustav von Escherich","slug":"Escherich"},{"year":"1851","name":"Edwin Elliott","slug":"Elliott"},{"year":"1868","name":"Annie Fitch MacKinnon","slug":"MacKinnon"},{"year":"1884","name":"Eduard Helly","slug":"Helly"},{"year":"1899","name":"Edward Titchmarsh","slug":"Titchmarsh"},{"year":"1943","name":"Edmund Robertson","slug":"Robertson_Edmund"},{"year":"1944","name":"Haïm Brezis","slug":"Brezis"}],"died":[{"year":"1864","name":"Joaquim Gomes de Souza","slug":"Souza_Gomes"},{"year":"1867","name":"Karl von Staudt","slug":"Von_Staudt"},{"year":"1941","name":"Kurt Hensel","slug":"Hensel"},{"year":"1947","name":"David Enskog","slug":"Enskog"},{"year":"1974","name":"Haroutune Dadourian","slug":"Dadourian"},{"year":"1989","name":"Edward McShane","slug":"McShane"},{"year":"1996","name":"Gaetano Fichera","slug":"Fichera"},{"year":"1998","name":"Mikhail Moiseevich Lesokhin","slug":"Lesokhin"},{"year":"1998","name":"Jerzy Łoś","slug":"Los"},{"year":"2000","name":"Aubrey Ingleton","slug":"Ingleton"},{"year":"2006","name":"Shokichi Iyanaga","slug":"Iyanaga"}]},{"date":"06-02","slug":"Rado","kind":"born","year":"1895","life":"1895–1965","name":"Tibor Radó","nameKo":"티보르 라도","title":"플라토 문제를 해결한 라도","body":"티보르 라도는 1930년 플라토 문제를 해결한 것으로 가장 유명한 헝가리 출신의 수학자예요. 제1차 세계대전 때 러시아군의 포로가 되어 시베리아 수용소에서 여러 해를 보냈는데, 그곳에서 함께 갇힌 수학자 헬리에게 수학을 배우고 수학책을 읽었어요. 전쟁이 대학 공부를 막았지만 수학의 길은 수용소에서 열린 셈이에요.","unit":"공통","classroom":"철사 고리를 비눗물에 담가 생기는 막을 보여 주며 '넓이가 가장 작은 곡면' 문제와 라도를 소개해 보세요.","art":"torus","event":"1686년 오늘, 영국 왕립학회가 뉴턴의 『프린키피아』 출판을 결정했고 핼리가 자기 돈으로 인쇄를 맡기로 했어요.","born":[{"year":"1867","name":"John Dougall","slug":"Dougall"},{"year":"1884","name":"H T H Piaggio","slug":"Piaggio"},{"year":"1895","name":"Tibor Radó","slug":"Rado"},{"year":"1916","name":"Abraham Seidenberg","slug":"Seidenberg"},{"year":"1932","name":"Taira Honda","slug":"Honda"}],"died":[{"year":"1929","name":"Otto Schreier","slug":"Schreier"},{"year":"1942","name":"Andrew Forsyth","slug":"Forsyth"},{"year":"1943","name":"Edward Van Vleck","slug":"Van_Vleck"},{"year":"1946","name":"William Peddie","slug":"Peddie"},{"year":"2000","name":"Gerald Whitrow","slug":"Whitrow"}]},{"date":"06-03","slug":"Gregory_David","kind":"born","year":"1659","life":"1659–1708","name":"David Gregory","nameKo":"데이비드 그레고리","title":"급수를 연구하며 뉴턴을 지지한 그레고리","body":"데이비드 그레고리는 수학자 제임스 그레고리의 조카로, 급수와 광학 연구에 업적을 남긴 스코틀랜드의 수학자예요. 12살에 대학에 들어갔고, 삼촌이 남긴 원고를 꼼꼼히 공부한 끝에 24살에 삼촌이 맡았던 에든버러 대학교 수학 교수 자리에 올랐어요. 미적분 발견을 둘러싼 논쟁에서는 뉴턴을 강하게 지지했어요.","unit":"고 수열","classroom":"무한급수를 다룰 때 삼촌의 원고로 공부해 교수가 된 그레고리 집안 이야기를 곁들여 보세요.","art":"sum","event":"1663년 오늘, 로버트 훅이 회비를 내지 않아도 되는 조건으로 왕립학회 회원이 되었어요.","born":[{"year":"1659","name":"David Gregory","slug":"Gregory_David"},{"year":"1726","name":"James Hutton","slug":"Hutton_James"},{"year":"1844","name":"Paul Mansion","slug":"Mansion"},{"year":"1885","name":"Salvatore Cherubino","slug":"Cherubino"},{"year":"1906","name":"G de B Robinson","slug":"Robinson_G_de_B"},{"year":"1914","name":"Harry Pitt","slug":"Pitt"},{"year":"1923","name":"Igor Rostislavovich Shafarevich","slug":"Shafarevich"},{"year":"1928","name":"Karl Gruenberg","slug":"Gruenberg"}],"died":[{"year":"1903","name":"Leopold Gegenbauer","slug":"Gegenbauer"},{"year":"1971","name":"Heinz Hopf","slug":"Hopf"},{"year":"1980","name":"Naum Il'ich Akhiezer","slug":"Akhiezer"},{"year":"1994","name":"Roberto Vázquez","slug":"Vazquez"},{"year":"1995","name":"J Presper Eckert","slug":"Eckert_John"},{"year":"2003","name":"John Hildebrant","slug":"Hildebrant"},{"year":"2010","name":"Vladimir Arnold","slug":"Arnold"}]},{"date":"06-04","slug":"Cofman","kind":"born","year":"1936","life":"1936–2001","name":"Judita Cofman","nameKo":"유디타 코프만","title":"작도와 수학 교육에 힘쓴 코프만","body":"유디타 코프만은 노비사드 대학교에서 처음으로 수학 박사 학위를 받은 유고슬라비아 출신 수학자로, 유한기하학과 수학 교육을 연구했어요. 대학 조교 시절 자와 컴퍼스 작도를 가르치며 쓴 강의록은 그 학부 최초의 수학 출판물이 되었어요. 경력 후반에는 런던에서 학교 교사로 일했어요.","unit":"중1 작도","classroom":"작도 단원에서 작도 강의록을 쓴 코프만을 소개하고, 학생들이 직접 작도 안내서를 만들어 보게 하세요.","art":"euclid","event":"1925년 오늘, 힐베르트가 '칸토어가 만든 낙원에서 아무도 우리를 쫓아낼 수 없다'고 연설했어요.","born":[{"year":"1809","name":"John Pratt","slug":"Pratt"},{"year":"1891","name":"Leopold Vietoris","slug":"Vietoris"},{"year":"1902","name":"Udo Wegner","slug":"Wegner"},{"year":"1933","name":"Richard Askey","slug":"Askey"},{"year":"1936","name":"Judita Cofman","slug":"Cofman"},{"year":"1966","name":"Svetlana Jitomirskaya","slug":"Jitomirskaya"},{"year":"1966","name":"Vladimir Voevodsky","slug":"Voevodsky"},{"year":"1984","name":"Qëndrim Gashi","slug":"Gashi"}],"died":[{"year":"1946","name":"Ernst Lindelöf","slug":"Lindelof"},{"year":"1973","name":"Maurice Fréchet","slug":"Frechet"},{"year":"2000","name":"Cyril Offord","slug":"Offord"},{"year":"2008","name":"Brian Griffiths","slug":"Griffiths_Brian"}]},{"date":"06-05","slug":"Keynes","kind":"born","year":"1883","life":"1883–1946","name":"John Maynard Keynes","nameKo":"존 메이너드 케인스","title":"확률론 책을 쓴 경제학자 케인스","body":"존 메이너드 케인스는 경제학자로 가장 유명하지만, 확률에 관한 책도 펴낸 영국의 학자예요. 인도청에서 일하던 시절 남는 시간을 모두 확률론 연구에 쏟았고, 그 논문을 고쳐 가며 케임브리지 킹스 칼리지의 연구원 자리에 도전했어요. 학창 시절 이튼에서 수학 상을 두 번 받았고, 12살 때부터 옛 책을 모았어요.","unit":"고 확률과 통계","classroom":"확률의 뜻을 배울 때 '경제학자 케인스도 확률을 연구했다'는 사실로 수학과 사회의 연결을 보여 주세요.","art":"dice","event":"1833년 오늘, 에이다 러브레이스가 메리 서머빌의 집에서 찰스 배비지를 처음 만났어요.","born":[{"year":"1814","name":"Pierre Wantzel","slug":"Wantzel"},{"year":"1819","name":"John Couch Adams","slug":"Adams"},{"year":"1883","name":"John Maynard Keynes","slug":"Keynes"},{"year":"1904","name":"George McVittie","slug":"McVittie"},{"year":"1907","name":"Rudolf Peierls","slug":"Peierls"},{"year":"1926","name":"Claude Berge","slug":"Berge"},{"year":"1930","name":"Gregory Maxwell Kelly","slug":"Kelly_Max"}],"died":[{"year":"1716","name":"Roger Cotes","slug":"Cotes"},{"year":"1898","name":"Percival Frost","slug":"Frost"},{"year":"1940","name":"Augustus Love","slug":"Love"},{"year":"1964","name":"Tadashi Nakayama","slug":"Nakayama"},{"year":"1985","name":"Sree Pillai","slug":"Pillai"},{"year":"1986","name":"Helmut Grunsky","slug":"Grunsky"},{"year":"2009","name":"Rajeev Motwani","slug":"Motwani"}]},{"date":"06-06","slug":"Regiomontanus","kind":"born","year":"1436","life":"1436–1476","name":"Regiomontanus","nameKo":"레기오몬타누스","title":"삼각법에 큰 업적을 남긴 레기오몬타누스","body":"레기오몬타누스는 본명이 요한 뮐러인 독일의 학자로, 삼각법과 천문학에 중요한 업적을 남겼어요. 방앗간 주인의 아들로 태어나 11살에 대학에 들어갔고, 스승 포이어바흐와 함께 화성의 위치와 월식을 관측해 당시 천문표가 틀렸음을 확인했어요. 그의 이름은 고향 쾨니히스베르크('왕의 산')의 라틴어 표기에서 나왔어요.","unit":"중3 삼각비","classroom":"삼각비 단원 도입에서 정확한 천문 계산을 위해 삼각법을 다듬은 레기오몬타누스를 소개해 보세요.","art":"unit-circle","event":"1659년 오늘, 하위헌스가 월리스에게 편지를 보내 '우리 세기만큼 수학자가 넘쳐 난 때는 없다'며 얀 더빗을 칭찬했어요.","born":[{"year":"1436","name":"Regiomontanus","slug":"Regiomontanus"},{"year":"1842","name":"Henry Taylor","slug":"Taylor_Henry"},{"year":"1857","name":"Aleksandr Mikhailovich Lyapunov","slug":"Lyapunov"},{"year":"1882","name":"Clement Durell","slug":"Durell"},{"year":"1906","name":"Max Zorn","slug":"Zorn"},{"year":"1920","name":"Jeremiah Certaine","slug":"Certaine"},{"year":"1933","name":"Víctor Neumann-Lara","slug":"Neumann-Lara"}],"died":[{"year":"1888","name":"Erastus De Forest","slug":"De_Forest"},{"year":"1898","name":"Henry Perigal","slug":"Perigal"},{"year":"1928","name":"Luigi Bianchi","slug":"Bianchi"},{"year":"1943","name":"Guido Fubini","slug":"Fubini"},{"year":"1972","name":"A Adrian Albert","slug":"Albert_Abraham"},{"year":"1977","name":"Stefan Bergman","slug":"Bergman"},{"year":"1985","name":"András Huhn","slug":"Huhn"},{"year":"1998","name":"G Leslie Frewin","slug":"Frewin"},{"year":"2012","name":"Jean-Louis Loday","slug":"Loday"},{"year":"2024","name":"Sergei Novikov","slug":"Novikov_Sergi"}]},{"date":"06-07","slug":"Davies_Donald","kind":"born","year":"1924","life":"1924–2000","name":"Donald Davies","nameKo":"도널드 데이비스","title":"인터넷의 바탕 '패킷 교환'을 고안한 데이비스","body":"도널드 데이비스는 초기 컴퓨터와 통신망 개발에 힘쓴 영국의 물리학자이자 수학자예요. 그가 고안한 '패킷 교환'은 인터넷과 월드와이드웹을 가능하게 했어요. 쌍둥이로 몹시 약하게 태어나 의사가 포기할 뻔했지만 할머니 덕분에 살아났고, 어머니가 우체국에서 일한 덕에 어려서부터 전화망에 관심을 가졌대요.","unit":"공통","classroom":"메시지를 작은 조각으로 나눠 보내고 다시 맞추는 놀이로 패킷 교환을 체험하며 데이비스를 소개해 보세요.","art":"turing","event":"1886년 오늘, 위니프리드 에저턴이 미국 여성 최초로 수학 박사 학위를 받았어요.","born":[{"year":"1711","name":"François Jacquier","slug":"Jacquier"},{"year":"1863","name":"Edward Van Vleck","slug":"Van_Vleck"},{"year":"1877","name":"Charles Glover Barkla","slug":"Barkla"},{"year":"1924","name":"Donald Davies","slug":"Davies_Donald"},{"year":"1926","name":"John Shepherdson","slug":"Shepherdson"},{"year":"1932","name":"M S Narasimhan","slug":"Narasimhan_M_S"},{"year":"1956","name":"János Kollár","slug":"Kollar"}],"died":[{"year":"1624","name":"Giuseppe Biancani","slug":"Biancani"},{"year":"1843","name":"Alexis Bouvard","slug":"Bouvard"},{"year":"1847","name":"Adolph Göpel","slug":"Gopel"},{"year":"1907","name":"Edward Routh","slug":"Routh"},{"year":"1937","name":"James Macdonald","slug":"Macdonald_James"},{"year":"1954","name":"Alan Turing","slug":"Turing"},{"year":"2004","name":"Joseph Doob","slug":"Doob"}]},{"date":"06-08","slug":"Cassini","kind":"born","year":"1625","life":"1625–1712","name":"Giovanni Cassini","nameKo":"조반니 도메니코 카시니","title":"카시니 곡선을 연구한 천문학자 카시니","body":"조반니 도메니코 카시니는 이탈리아에서 태어나 프랑스에서 활동한 수학자이자 천문학자예요. 두 정점에서의 거리의 곱이 일정한 점의 자취인 곡선을 연구했어요. 1664년에는 목성의 자전 주기를 재고 목성의 띠와 반점을 발견했으며, 목성이 극 쪽으로 납작하다는 것도 알아냈어요.","unit":"고 기하","classroom":"타원이 '거리의 합이 일정한 점의 자취'임을 배운 뒤, 합 대신 곱이 일정하면 어떤 모양일지 탐구해 보세요.","art":"conic","event":"1637년 오늘, 좌표계를 소개한 부록 『기하학』이 실린 데카르트의 『방법서설』 인쇄가 끝났어요.","born":[{"year":"1625","name":"Giovanni Cassini","slug":"Cassini"},{"year":"1745","name":"Caspar Wessel","slug":"Wessel"},{"year":"1858","name":"Charlotte Angas Scott","slug":"Scott"},{"year":"1860","name":"Alicia Boole Stott","slug":"Stott"},{"year":"1870","name":"Peter Pinkerton","slug":"Pinkerton"},{"year":"1896","name":"Eleanor Pairman","slug":"Pairman"},{"year":"1903","name":"Evan James Williams","slug":"Williams_Evan"},{"year":"1905","name":"Hubert Linfoot","slug":"Linfoot"},{"year":"1915","name":"José Luis Massera","slug":"Massera"},{"year":"1923","name":"Gloria Olive","slug":"Olive"},{"year":"1924","name":"Samuel Karlin","slug":"Karlin"},{"year":"1925","name":"Guri Ivanovich Marchuk","slug":"Marchuk"}],"died":[{"year":"1882","name":"John Scott Russell","slug":"Russell_Scott"},{"year":"1893","name":"Joel E Hendricks","slug":"Hendricks"},{"year":"1935","name":"Alexander von Brill","slug":"Brill"},{"year":"1943","name":"Mihailo Petrović","slug":"Petrovic"},{"year":"1948","name":"Giacomo Albanese","slug":"Albanese"},{"year":"1966","name":"Paddy Kennedy","slug":"Kennedy"},{"year":"1988","name":"Roger Lyndon","slug":"Lyndon"},{"year":"2001","name":"May Hickey Maria","slug":"Hickey"}]},{"date":"06-09","slug":"Littlewood","kind":"born","year":"1885","life":"1885–1977","name":"J E Littlewood","nameKo":"존 이든저 리틀우드","title":"하디와 함께 해석학을 이끈 리틀우드","body":"존 이든저 리틀우드는 하디와 오랫동안 함께 연구하며 급수, 리만 제타 함수, 부등식, 함수론에 업적을 남긴 영국의 수학자예요. 어린 시절 남아프리카에서 학교 수학 수업에 혼란을 느껴 산수 시험에 떨어지기도 했어요. 15살에 영국으로 돌아와 훌륭한 수학 선생님을 만나며 실력이 꽃피었어요.","unit":"고 수열","classroom":"시험 성적에 실망한 학생들에게 산수 시험에 떨어졌던 리틀우드의 이야기를 들려주세요.","art":"riemann","event":"1905년 오늘, 아인슈타인이 빛의 양자론에 관한 논문을 발표했고, 이 연구로 1921년 노벨 물리학상을 받았어요.","born":[{"year":"1669","name":"Leonty Filippovich Magnitsky","slug":"Magnitsky"},{"year":"1786","name":"William Horner","slug":"Horner"},{"year":"1885","name":"J E Littlewood","slug":"Littlewood"},{"year":"1906","