ug":"Borchardt"},{"year":"1849","name":"Nikolay Sonin","slug":"Sonin"},{"year":"1856","name":"Micaiah Hill","slug":"Hill_Micaiah"},{"year":"1857","name":"Heinrich Hertz","slug":"Hertz_Heinrich"},{"year":"1862","name":"Ruth Gentry","slug":"Gentry"},{"year":"1903","name":"Frank Ramsey","slug":"Ramsey"},{"year":"1933","name":"Harvey Greenspan","slug":"Greenspan_Harvey"}],"died":[{"year":"1940","name":"Beulah Russell","slug":"Russell_Beulah"},{"year":"1975","name":"Oskar Perron","slug":"Perron"},{"year":"1979","name":"William Arthur","slug":"Arthur"},{"year":"1984","name":"Max Newman","slug":"Newman"},{"year":"1985","name":"Ernests Fogels","slug":"Fogels"},{"year":"1989","name":"Gladys Mackenzie","slug":"Mackenzie"},{"year":"2011","name":"Frank Bonsall","slug":"Bonsall"}]},{"date":"02-23","slug":"Shimura","kind":"born","year":"1930","life":"1930–2019","name":"Goro Shimura","nameKo":"시무라 고로","title":"페르마 정리 증명의 열쇠를 남긴 시무라","body":"대수기하학을 연구한 일본의 수학자예요. 다니야마 유타카와 함께 이름이 붙은 시무라-다니야마 추측은 수학 발전에 큰 영향을 주었고, 페르마의 마지막 정리를 증명하는 데 핵심이 되었어요. 중학생 시절에는 대수를 쓰지 말고 풀라는 인위적인 문장제가 전혀 재미없었다고 회상했어요.","unit":"중1 일차방정식","classroom":"같은 문장제를 산수로 한 번, 방정식으로 한 번 풀어 보며 대수의 편리함을 강조한 시무라의 회상을 소개해 보세요.","art":"fermat","event":"1828년 오늘, 오거스터스 드모르간이 런던 대학의 첫 수학 교수가 되었어요.","born":[{"year":"1583","name":"Jean-Baptiste Morin","slug":"Morin_Jean-Baptiste"},{"year":"1723","name":"Richard Price","slug":"Price"},{"year":"1756","name":"František Josef Gerstner","slug":"Gerstner"},{"year":"1861","name":"George Mathews","slug":"Mathews"},{"year":"1905","name":"Derrick Henry Lehmer","slug":"Lehmer_Derrick"},{"year":"1917","name":"Erling Sverdrup","slug":"Sverdrup"},{"year":"1922","name":"Anneli Lax","slug":"Lax_Anneli"},{"year":"1930","name":"Goro Shimura","slug":"Shimura"},{"year":"1947","name":"Robert Edward Bowen","slug":"Bowen"},{"year":"1951","name":"Shigefumi Mori","slug":"Mori"}],"died":[{"year":"1560","name":"Gaspar Lax","slug":"Lax"},{"year":"1844","name":"Duncan Gregory","slug":"Gregory_Duncan"},{"ye