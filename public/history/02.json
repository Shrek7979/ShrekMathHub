[{"date":"02-01","slug":"Heisenberg","kind":"died","year":"1976","life":"1901–1976","name":"Werner Heisenberg","nameKo":"베르너 하이젠베르크","title":"양자역학을 연 물리학자 하이젠베르크","body":"양자역학과 핵물리학에서 중요한 업적을 남긴 독일의 물리학자예요. 김나지움 시절 수학·물리·종교 성적이 가장 좋았고, 1917년에는 대학생에게 미적분을 가르칠 정도였어요. 농장 봉사를 떠날 때도 수학책을 챙겨 가 크로네커의 책을 읽고 페르마의 마지막 정리를 증명해 보려 했대요.","unit":"공통","classroom":"고등학생 하이젠베르크가 대학생에게 미적분을 가르친 이야기로, 친구를 가르치며 배우는 힘을 이야기해 보세요.","art":"conic","event":"1673년 오늘, 라이프니츠가 런던 왕립학회에서 자신이 만든 계산기를 선보였어요.","born":[{"year":"1840","name":"Allen Whitworth","slug":"Whitworth"},{"year":"1888","name":"Hermann Kober","slug":"Kober"},{"year":"1900","name":"J C Burkill","slug":"Burkill"},{"year":"1902","name":"Jovan Karamata","slug":"Karamata"},{"year":"1905","name":"Ernst Stueckelberg","slug":"Stueckelberg"},{"year":"1913","name":"Ernest Corominas","slug":"Corominas"},{"year":"1916","name":"George Mackey","slug":"Mackey"},{"year":"1926","name":"Chaim Samuel Hönig","slug":"Honig"}],"died":[{"year":"1869","name":"Theodore Strong","slug":"Strong"},{"year":"1903","name":"George Stokes","slug":"Stokes"},{"year":"1942","name":"Arnold Scholz","slug":"Scholz_Arnold"},{"year":"1970","name":"Alfréd Rényi","slug":"Renyi"},{"year":"1976","name":"Werner Heisenberg","slug":"Heisenberg"},{"year":"1986","name":"Ida Rhodes","slug":"Rhodes"}]},{"date":"02-02","slug":"Russell","kind":"died","year":"1970","life":"1872–1970","name":"Bertrand Russell","nameKo":"버트런드 러셀","title":"'러셀의 역설'을 발견한 논리학자","body":"20세기의 가장 중요한 논리학자 가운데 한 사람이에요. 1901년 '자기 자신을 원소로 갖지 않는 집합들의 집합'을 생각하다가, 그 집합이 자신의 원소이면 원소가 아니고 원소가 아니면 원소가 되는 모순을 발견했어요. 이것이 러셀의 역설이에요. 화이트헤드와 함께 『수학 원리』를 써서 수학을 논리 위에 세우려 했어요.","unit":"고 집합과 명제","classroom":"집합을 배울 때 '모든 집합을 모은 집합'이 가능한지 물으며 러셀의 역설을 토론 주제로 던져 보세요.","art":"infinity","event":"1883년 오늘, 에든버러 수학회를 세우기 위한 준비 모임이 열렸어요.","born":[{"year":"1522","name":"Lodovico Ferrari","slug":"Ferrari"},{"year":"1765","name":"Timofei Fedorovic Osipovsky","slug":"Osipovsky"},{"year":"1786","name":"Jacques Binet","slug":"Binet"},