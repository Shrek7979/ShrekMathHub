otin","slug":"Subbotin"},{"year":"1973","name":"Harold Hotelling","slug":"Hotelling"},{"year":"1977","name":"Walter R Talbot","slug":"Talbot_Walter"},{"year":"1979","name":"Helmut Hasse","slug":"Hasse"},{"year":"1992","name":"John Kemeny","slug":"Kemeny"},{"year":"1997","name":"Cahit Arf","slug":"Arf"},{"year":"2002","name":"Enriqueta González Baz","slug":"Baz"},{"year":"2006","name":"Martin Kruskal","slug":"Kruskal_Martin"},{"year":"2011","name":"John Howie","slug":"Howie"},{"year":"2018","name":"Peter Swinnerton-Dyer","slug":"Swinnerton-Dyer"}]},{"date":"12-27","slug":"Kepler","kind":"born","year":"1571","life":"1571–1630","name":"Johannes Kepler","nameKo":"요하네스 케플러","title":"행성 운동의 세 법칙을 발견한 케플러","body":"요하네스 케플러는 지구와 행성이 태양 둘레를 타원 궤도로 돈다는 것을 밝힌 독일의 수학자이자 천문학자예요. 행성 운동의 세 법칙 외에도 별 모양의 새 정다면체 두 가지를 찾았고, 벌집 모양을 같은 크기 구 쌓기로 설명했으며, 로그가 왜 성립하는지 처음 증명했어요.","unit":"고 기하","classroom":"실과 압정 두 개로 타원을 그려 보며 두 초점까지 거리의 합이 일정하다는 성질과 행성 궤도를 연결해 보세요.","art":"conic","event":"1725년 오늘, 골드바흐가 상트페테르부르크 학술원 개원 회의에서 기록을 맡은 서기로 일했어요.","born":[{"year":"1571","name":"Johannes Kepler","slug":"Kepler"},{"year":"1851","name":"Adolf Weiler","slug":"Weiler"},{"year":"1915","name":"Lionel Cooper","slug":"Cooper"},{"year":"1924","name":"Jean Bartik","slug":"Bartik"}],"died":[{"year":"1867","name":"Miles Bland","slug":"Bland"},{"year":"1909","name":"Hugh MacColl","slug":"MacColl"},{"year":"1930","name":"Gyula Farkas","slug":"Farkas"},{"year":"1946","name":"Amy Rayson","slug":"Rayson"},{"year":"1967","name":"Ferran Sunyer","slug":"Sunyer"},{"year":"1973","name":"Raymond Brink","slug":"Brink"},{"year":"1974","name":"Vladimir Aleksandrovich Fock","slug":"Fock"},{"year":"1988","name":"Ida Busbridge","slug":"Busbridge"},{"year":"1992","name":"Alfred Hoblitzelle Clifford","slug":"Clifford_Alfred"},{"year":"1995","name":"Boris Vladimirovich Gnedenko","slug":"Gnedenko"},{"year":"1996","name":"Mary Fasenmyer","slug":"Fasenmyer"},{"year":"2006","name":"Peter Ladislaw Hammer","slug":"Hammer"}]},{"date":"12-28","slug":"Von_Neumann","kind":"born","year":"1903","life":"1903–1957","name":"John von Neumann","nameKo":"존 폰 노이만","title":"양자역학·게임 이론·컴퓨터의 폰 노이만","body":"존 폰 노이만은 양자역학의 수학적 틀을 세우고 게임 이론을 연구했으며, 컴퓨터 과학을 개척한 헝가리 출신 수학자예요. 어릴 때 기억력이 놀라워, 손님이 전화번호부의 아무 쪽을 고르면 그 내용을 외워 보이곤 했어요. 여섯 살에 아버지와 고대 그리스어로 농담을 주고받았다고 해요.","unit":"공통","classroom":"가위바위보에서 늘 이기는 전략이 있을지 토론하며 게임 이론의 첫 질문을 던져 보세요.","art":"turing","event":"1612년 오늘, 갈릴레이가 해왕성을 관측했지만 행성인 줄 알아차리지 못했어요.","born":[{"year":"1798","name":"Thomas Henderson","slug":"Henderson"},{"year":"1808","name":"Athanase Dupré","slug":"Dupre"},{"year":"1877","name":"David Drysdale","slug":"Drysdale"},{"year":"1882","name":"Arthur Eddington","slug":"Eddington"},{"year":"1903","name":"John von Neumann","slug":"Von_Neumann"},{"year":"1930","name":"Bruce Kellogg","slug":"Kellogg_Bruce"},{"year":"1940","name":"Peter Neumann","slug":"Neumann_Peter"}],"died":[{"year":"1663","name":"Francesco Grimaldi","slug":"Grimaldi"},{"year":"1827","name":"Robert Woodhouse","slug":"Woodhouse"},{"year":"1871","name":"John Pratt","slug":"Pratt"},{"year":"1919","name":"Johannes Robert Rydberg","slug":"Rydberg"},{"year":"1935","name":"Ellice Horsburgh","slug":"Horsburgh"},{"year":"1935","name":"David Johnstone","slug":"Johnstone"},{"year":"1944","name":"Richard Fuchs","slug":"Fuchs_Richard"},{"year":"1951","name":"Neil McArthur","slug":"McArthur"},{"year":"1964","name":"Edwin Wilson","slug":"Wilson_Edwin"},{"year":"2020","name":"Helge Tverberg","slug":"Tverberg"}]},{"date":"12-29","slug":"Al-Banna","kind":"born","year":"1256","life":"1256–1321","name":"Ibn al-Banna","nameKo":"이븐 알반나","title":"분수를 두 수의 비로 본 이븐 알반나","body":"이븐 알반나는 모로코 마라케시 출신의 이슬람 수학자예요. 유클리드 『원론』 입문서와 대수 책, 천문학 책 등을 썼고, 페스의 대학에서 산술·대수·기하·천문을 가르쳤어요. 분수를 두 수의 비로 처음 생각한 사람으로 보이며, 대표작 『산술 연산 요약』에는 연분수로 제곱근의 근삿값을 구하는 방법이 나와요.","unit":"중1 정수와 유리수","classroom":"분수 $\\frac{3}{4}$을 '3 대 4의 비'로 다시 읽어 보며 분수와 비의 관계를 정리해 보세요.","art":"algebra","event":"1566년 오늘, 튀코 브라헤가 수학 문제를 둘러싼 결투에서 코의 일부를 잃어 금과 은으로 코를 만들어 달았어요.","born":[{"year":"1256","name":"Ibn al-Banna","slug":"Al-Banna"},{"year":"1751","name":"John Bonnycastle","slug":"Bonnycastle"},{"year":"1856","name":"Thomas Stieltjes","slug":"Stieltjes"},{"year":"1861","name":"Kurt Hensel","slug":"Hensel"},{"year":"1911","name":"Klaus Fuchs","slug":"Fuchs_Klaus"},{"year":"1923","name":"Yvonne Bruhat","slug":"Choquet-Bruhat"},{"year":"1939","name":"Calixto Calderón","slug":"Calderon_Calixto"}],"died":[{"year":"1720","name":"Maria Winckelmann","slug":"Kirch"},{"year":"1731","name":"Brook Taylor","slug":"Taylor"},{"year":"1737","name":"Joseph Saurin","slug":"Saurin"},{"year":"1758","name":"Jean-Louis Calandrini","slug":"Calandrini"},{"year":"1891","name":"Leopold Kronecker","slug":"Kronecker"},{"year":"1937","name":"Louis N G Filon","slug":"Filon"},{"year":"1939","name":"Kelly Miller","slug":"Miller_Kelly"},{"year":"1941","name":"Tullio Levi-Civita","slug":"Levi-Civita"},{"year":"1941","name":"William James Macdonald","slug":"Macdonald_William"},{"year":"2014","name":"John Frankland Rigby","slug":"Rigby"}]},{"date":"12-30","slug":"Boyle","kind":"died","year":"1691","life":"1627–1691","name":"Robert Boyle","nameKo":"로버트 보일","title":"화학을 수학적 과학으로 만들려 한 보일","body":"로버트 보일은 아일랜드에서 태어난 과학자로, 왕립학회의 창립 회원이에요. 화학을 물질에 대한 역학적 이론 위에 세운 수학적 과학으로 만들고자 했어요. 열네 살 무렵 피렌체에 머물 때 갈릴레이가 세상을 떠났는데, 이를 계기로 갈릴레이의 책을 깊이 공부하며 수학과 역학으로 자연을 탐구하는 길에 들어섰어요.","unit":"공통","classroom":"실험 결과를 표와 그래프로 정리해 규칙을 찾게 하며, 과학을 수학으로 설명하려 한 보일의 생각을 소개해 보세요.","art":"conic","event":"1902년 오늘, 딕슨이 결혼했는데, 신혼여행에서 '논문을 두 편밖에 못 썼다'고 농담했어요.","born":[{"year":"1869","name":"Emilie Martin","slug":"Martin_Emilie"},{"year":"1888","name":"Joseph Proudman","slug":"Proudman"},{"year":"1897","name":"Stanisław Saks","slug":"Saks"},{"year":"1935","name":"Rolando Chuaqui","slug":"Chuaqui"},{"year":"1947","name":"Georgia Benkart","slug":"Benkart"},{"year":"1948","name":"Andrew Ranicki","slug":"Ranicki"}],"died":[{"year":"1691","name":"Robert Boyle","slug":"Boyle"},{"year":"1932","name":"Eliakim Moore","slug":"Moore_Eliakim"},{"year":"1947","name":"Alfred North Whitehead","slug":"Whitehead"},{"year":"1956","name":"Heinrich Scholz","slug":"Scholz"},{"year":"1978","name":"Mark Aronovich Naimark","slug":"Naimark"},{"year":"1982","name":"Philip Hall","slug":"Hall"}]},{"date":"12-31","slug":"Escalante","kind":"born","year":"1930","life":"1930–2010","name":"Jaime Escalante","nameKo":"하이메 에스칼란테","title":"영화의 주인공이 된 수학 교사 에스칼란테","body":"하이메 에스칼란테는 볼리비아와 미국에서 고등학교 수학을 가르친 교사예요. 부모님도 교사였고, 어머니는 오렌지를 예로 들어 기하를 가르쳐 주었어요. 미국에서 가르친 학생들이 너무 좋은 성적을 내자 부정행위를 의심받기까지 했는데, 이 이야기가 1988년 영화 「스탠드 앤드 딜리버」로 만들어졌어요.","unit":"공통","classroom":"학생들의 가능성을 끝까지 믿어 준 에스칼란테 이야기로, 어려운 단원 앞에서 도전 의식을 북돋워 보세요.","art":"textbook","event":"1915년 오늘, 미국수학협회(MAA)가 오하이오주 콜럼버스에서 창립되었어요.","born":[{"year":"1856","name":"William Thomson","slug":"Thomson_William"},{"year":"1872","name":"Volodymyr Levytsky","slug":"Levytsky"},{"year":"1878","name":"Ethel Elderton","slug":"Elderton"},{"year":"1896","name":"Carl Siegel","slug":"Siegel"},{"year":"1913","name":"Cândido Silva Dias","slug":"Silva_Dias"},{"year":"1916","name":"Douglas Northcott","slug":"Northcott"},{"year":"1930","name":"Jaime Escalante","slug":"Escalante"},{"year":"1937","name":"Vladimir Maz'ya","slug":"Mazya"},{"year":"1945","name":"Leonard Adleman","slug":"Adleman"},{"year":"1952","name":"Vaughan Jones","slug":"Jones_Vaughan"}],"died":[{"year":"1610","name":"Ludolph Van Ceulen","slug":"Van_Ceulen"},{"year":"1659","name":"János Apáczai","slug":"Apaczai"},{"year":"1679","name":"Giovanni Alfonso Borelli","slug":"Borelli"},{"year":"1719","name":"John Flamsteed","slug":"Flamsteed"},{"year":"1894","name":"Thomas Stieltjes","slug":"Stieltjes"},{"year":"1912","name":"Robert Ferguson","slug":"Ferguson"},{"year":"1929","name":"Onorato Nicoletti","slug":"Nicoletti"},{"year":"1944","name":"Nikolai Evgrafovich Kochin","slug":"Kochin"},{"year":"1956","name":"Edwin P Adams","slug":"Adams_Edwin"},{"year":"1960","name":"Florence Allen","slug":"Alle