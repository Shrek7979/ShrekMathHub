[{"date":"08-01","slug":"Mitchell_Maria","kind":"born","year":"1818","life":"1818–1889","name":"Maria Mitchell","nameKo":"마리아 미첼","title":"망원경으로 새 혜성을 찾은 마리아 미첼","body":"미국의 천문학자 마리아 미첼은 망원경으로만 보이는 새 혜성을 처음 관측해 1847년 덴마크의 메달을 받았어요. 1848년 미국 예술과학아카데미 최초의 여성 회원이 되었고, 배서 칼리지의 첫 천문학 교수로 일하며 미국여성진보협회를 세우는 데도 앞장섰어요.","unit":"공통","classroom":"진로 이야기를 나눌 때, 혜성 발견으로 '최초의 여성' 기록을 여럿 세운 마리아 미첼을 소개해 보세요.","art":"earth","event":"1786년 오늘, 캐롤라인 허셜이 자신의 첫 혜성을 발견했어요.","born":[{"year":"1818","name":"Maria Mitchell","slug":"Mitchell_Maria"},{"year":"1823","name":"Stephen Parkinson","slug":"Parkinson"},{"year":"1861","name":"Ivar Bendixson","slug":"Bendixson"},{"year":"1881","name":"Otto Toeplitz","slug":"Toeplitz"},{"year":"1913","name":"Mischa Cotlar","slug":"Cotlar"},{"year":"1937","name":"Barry Johnson","slug":"Johnson_Barry"},{"year":"1955","name":"Bernadette Perrin-Riou","slug":"Perrin-Riou"}],"died":[{"year":"1968","name":"Thomas Havelock","slug":"Havelock"},{"year":"1987","name":"Evelyn Nelson","slug":"Nelson"},{"year":"1992","name":"Leslie Fox","slug":"Fox_Leslie"},{"year":"1999","name":"Paris Pishmish","slug":"Pishmish"}]},{"date":"08-02","slug":"Swinnerton-Dyer","kind":"born","year":"1927","life":"1927–2018","name":"Peter Swinnerton-Dyer","nameKo":"스위너턴다이어","title":"버치–스위너턴다이어 추측의 스위너턴다이어","body":"영국의 스위너턴다이어는 정수론의 큰 난제인 '버치–스위너턴다이어 추측'으로 가장 잘 알려진 수학자예요. 연구뿐 아니라 케임브리지 대학 부총장, 대학보조금위원회 의장 등을 맡아 대학 행정에서도 큰 역할을 했어요. 케임브리지 대학 체스 클럽의 1번 주자로 뛸 만큼 체스와 브리지 실력도 뛰어났어요.","unit":"공통","classroom":"아직 풀리지 않은 수학 난제가 많다는 이야기를 할 때, 이름이 붙은 추측의 주인공 스위너턴다이어를 소개해 보세요.","art":"primes","event":"1784년 오늘, 라자르 카르노가 『보방 찬사』로 파리 과학 아카데미에서 금메달 두 개와 상을 받았어요.","born":[{"year":"1856","name":"Ferdinand Rudio","slug":"Rudio"},{"year":"1887","name":"Oskar Anderson","slug":"Anderson"},{"year":"1890","name":"Herbert Dingle","slug":"Dingle"},{"year":"1902","name":"Mina Rees","slug":"Rees"},{"year":"1927","name":"Peter Swinnerton-Dyer","slug":"Swinnerton-Dyer"},{"year":"1942","name":"Patrick Keast","slug":"Keast"},{"year":"1946","name":"Nigel Hitchin","slug":"Hitchin"}],"died":[{"year":"1823","name":"Lazare Carnot","slug":"Carnot"},{"year":"1962","name":"John Smith","slug":"Smith_John"},{"year":"1970","name":"Salvatore Cherubino","slug":"Cherubino"},{"year":"1976","name":"László Kalmár","slug":"Kalmar"},{"year":"2016","name":"Jonathan Borwein","slug":"Borwein_Jonathan"}]},{"date":"08-03","slug":"Saitoti","kind":"born","year":"1945","life":"1945–2012","name":"George Saitoti","nameKo":"사이토티","title":"위상수학자에서 케냐 정치가가 된 사이토티","body":"케냐의 사이토티는 위상수학을 연구한 수학자이자 경제학자로, 뒤에 케냐 국회의원이 되었고 세계은행과 국제통화기금의 의장직도 맡았어요. 마우마우 봉기 때 가족이 마사이 지역으로 피신해 그곳에서 자랐고, 장학금으로 미국 브랜다이스 대학에서 경제학과 수학을 공부했어요. 2012년 의문의 헬리콥터 사고로 세상을 떠났어요.","unit":"공통","classroom":"수학 공부가 경제·정치 등 다양한 진로로 이어진다는 예로 사이토티의 삶을 소개해 보세요.","art":"torus","event":"1944년 오늘, 독일 슈바르츠발트에 오버볼파흐 연구소 설립이 승인됐고, 이곳은 지금도 국제 수학 연구의 중심지예요.","born":[{"year":"1835","name":"Artemas Martin","slug":"Martin"},{"year":"1851","name":"George FitzGerald","slug":"FitzGerald"},{"year":"1890","name":"Martha Betz Shapley","slug":"Shapley_Martha"},{"year":"1914","name":"Mark Kac","slug":"Kac"},{"year":"1926","name":"Maurice Auslander","slug":"Auslander"},{"year":"1943","name":"Béla Bollobás","slug":"Bollobas"},{"year":"1945","name":"George Saitoti","slug":"Saitoti"}],"died":[{"year":"1914","name":"Louis Couturat","slug":"Couturat"},{"year":"1917","name":"Georg Frobenius","slug":"Frobenius"},{"year":"1922","name":"Matyáš Lerch","slug":"Lerch"},{"year":"1959","name":"Jakob Nielsen","slug":"Nielsen_Jakob"},{"year":"2011","name":"John Quill Taylor King","slug":"King"},{"year":"2016","name":"Geoffrey Shephard","slug":"Shephard"}]},{"date":"08-04","slug":"Hamilton","kind":"born","year":"1805","life":"1805–1865","name":"William Rowan Hamilton","nameKo":"해밀턴","title":"사원수를 발견한 해밀턴","body":"아일랜드의 해밀턴은 천문학자이자 수학자로, '사원수'라는 새로운 수 체계를 발견했어요. 어려서부터 여러 언어를 익혔고 13살에 클레로의 『대수학』으로 수학에 입문했어요. 1822년 라플라스의 『천체역학』에서 오류를 찾아냈고, 아직 대학생이던 21살에 트리니티 칼리지 천문학 교수 겸 아일랜드 왕립 천문학자가 되었어요.","unit":"고 복소수","classroom":"실수에서 복소수로 수를 넓힌 뒤, '그다음 수 체계는 없을까?'라는 질문으로 해밀턴의 사원수를 소개해 보세요.","art":"algebra","event":"1539년 오늘, 카르다노가 음수의 제곱근이 들어간 계산이 왜 맞는 답을 주는지 묻는 편지를 타르탈리아에게 보냈어요.","born":[{"year":"1805","name":"William Rowan Hamilton","slug":"Hamilton"},{"year":"1834","name":"John Venn","slug":"Venn"},{"year":"1843","name":"Mauritz Dahlin","slug":"Dahlin"},{"year":"1893","name":"Francis Murnaghan","slug":"Murnaghan"},{"year":"1909","name":"Saunders Mac Lane","slug":"MacLane"},{"year":"1912","name":"Aleksandr Aleksandrov","slug":"Aleksandrov_Aleksandr"},{"year":"1939","name":"Brian Sleeman","slug":"Sleeman"}],"died":[{"year":"1812","name":"Georg Klügel","slug":"Klugel"},{"year":"1874","name":"Otto Hesse","slug":"Hesse"},{"year":"1906","name":"Joseph Tilly","slug":"Tilly"},{"year":"1920","name":"Karl Rohn","slug":"Rohn"},{"year":"1945","name":"Gerhard Gentzen","slug":"Gentzen"},{"year":"1967","name":"Archibald Macintyre","slug":"Macintyre_Archibald"},{"year":"2009","name":"James Wiegold","slug":"Wiegold"}]},{"date":"08-05","slug":"Abel","kind":"born","year":"1802","life":"1802–1829","name":"Niels Abel","nameKo":"아벨","title":"5차방정식에 근의 공식이 없음을 보인 아벨","body":"노르웨이의 아벨은 일반적인 5차방정식은 대수적인 방법으로 풀 수 없다는 것, 즉 근의 공식이 없음을 증명했어요. 평생 가난에 시달렸지만, 학교에 새로 온 수학 교사 홀름보에가 재능을 알아보고 오일러와 라그랑주의 책을 읽게 했으며, 동료들에게 돈을 모아 대학 학비까지 마련해 주었어요.","unit":"중3 이차방정식","classroom":"근의 공식을 배운 뒤 '5차방정식에도 공식이 있을까?'라고 물으며 아벨과 그의 선생님 홀름보에를 소개해 보세요.","art":"galois","event":"1900년 오늘, 기술자 프랭크 볼드윈이 기계식 계산기로 미국 특허를 받았어요.","born":[{"year":"1802","name":"Niels Abel","slug":"Abel"},{"year":"1855","name":"Alfredo Capelli","slug":"Capelli"},{"year":"1878","name":"Louis Karpinski","slug":"Karpinski"},{"year":"1889","name":"Hans Hamburger","slug":"Hamburger"},{"year":"1936","name":"Ki Hang Kim","slug":"Kim"}],"died":[{"year":"1853","name":"Théodore Olivier","slug":"Olivier"},{"year":"1872","name":"Charles Eugène Delaunay","slug":"Delaunay"},{"year":"1910","name":"Julius Petersen","slug":"Petersen"},{"year":"1976","name":"Charles Racine","slug":"Racine"},{"year":"1981","name":"Jerzy Neyman","slug":"Neyman"},{"year":"1986","name":"Banesh Hoffmann","slug":"Hoffmann"}]},{"date":"08-06","slug":"Wilson_John","kind":"born","year":"1741","life":"1741–1793","name":"John Wilson","nameKo":"존 윌슨","title":"소수와 계승을 잇는 정리를 남긴 윌슨","body":"영국의 존 윌슨은 케임브리지를 수석으로 졸업한 뒤 법조인으로 크게 성공해 기사 작위까지 받았어요. 수학자들에게는 '$p$가 소수이면 $1+(p-1)!$은 $p$로 나누어떨어진다'는 윌슨의 정리로 기억돼요. 그는 여러 사례를 보고 추측했을 뿐 증명은 하지 못했고, 1773년 라그랑주가 처음 증명했어요.","unit":"중1 소인수분해","classroom":"p=5, 7일 때 1+(p−1)!을 직접 계산해 p로 나누어떨어지는지 확인하게 하며 윌슨의 정리를 소개해 보세요.","art":"primes","event":"1763년 오늘, 알렉산더 윌슨이 세인트앤드루스 대학에서 명예 학위를 받았어요.","born":[{"year":"1638","name":"Nicolas Malebranche","slug":"Malebranche"},{"year":"1741","name":"John Wilson","slug":"Wilson_John"}],"died":[{"year":"1694","name":"Antoine Arnauld","slug":"Arnauld"},{"year":"1925","name":"Gregorio Ricci-Curbastro","slug":"Ricci-Curbastro"},{"year":"1929","name":"Emil Hilb","slug":"Hilb"},{"year":"1939","name":"Gaetano Scorza","slug":"Scorza"},{"year":"1945","name":"Paul Koebe","slug":"Koebe"},{"year":"1947","name":"William Thomson","slug":"Thomson_William"},{"year":"1970","name":"Zyoiti Suetuna","slug":"Suetuna"},{"year":"1970","name":"Jan Popken","slug":"Popken"},{"year":"1998","name":"André Weil","slug":"Weil"},{"year":"2002","name":"Edsger Dijkstra","slug":"Dijkstra"},{"year":"2007","name":"Atle Selberg","slug":"Selberg"}]},{"date":"08-07","slug":"Bortkiewicz","kind":"born","year":"1868","life":"1868–1931","name":"Ladislaus Bortkiewicz","nameKo":"보르트키에비치","title":"말에 차인 병사 수를 분석한 보르트키에비치","body":"러시아 출신의 경제학자이자 통계학자 보르트키에비치는 1898년 『작은 수의 법칙』을 펴냈어요. 큰 집단에서 드물게 일어나는 사건의 수가 푸아송 분포를 따른다는 점을 처음 지적했는데, 프로이센 군단마다 한 해에 말에 차여 숨진 병사 수가 이 분포에 놀랍도록 잘 맞는다는 예로 유명해요.","unit":"고 확률과 통계","classroom":"드물게 일어나는 사건의 횟수를 표로 정리해 보며, 말에 차인 병사 수를 분석한 보르트키에비치를 소개해 보세요.","art":"rose","event":"1620년 오늘, 요하네스 케플러의 어머니가 마녀 혐의로 체포되었어요.","born":[{"year":"1868","name":"Ladislaus Bortkiewicz","slug":"Bortkiewicz"},{"year":"1869",