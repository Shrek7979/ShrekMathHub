,{"year":"1927","name":"Abdulalim Shabazz","slug":"Shabazz"},{"year":"1931","name":"Czesław Olech","slug":"Olech"},{"year":"1933","name":"Chen Jingrun","slug":"Chen_Jingrun"}],"died":[{"year":"1815","name":"William Spence","slug":"Spence"},{"year":"1868","name":"Julius Plücker","slug":"Plucker"},{"year":"1935","name":"Sotero Prieto","slug":"Prieto"},{"year":"1967","name":"Josip Plemelj","slug":"Plemelj"},{"year":"1974","name":"Irmgard Flügge-Lotz","slug":"Flugge-Lotz"},{"year":"1991","name":"Derrick Henry Lehmer","slug":"Lehmer_Derrick"},{"year":"2009","name":"Walter Ledermann","slug":"Ledermann"},{"year":"2010","name":"Martin Gardner","slug":"Gardner"}]},{"date":"05-23","slug":"Nash","kind":"died","year":"2015","life":"1928–2015","name":"John F Nash","nameKo":"존 내시","title":"게임 이론으로 노벨상을 받은 내시","body":"존 내시는 게임 이론 연구로 노벨 경제학상을 받은 미국의 수학자로, 영화 「뷰티풀 마인드」로 널리 알려졌어요. 학교 수학에는 흥미를 느끼지 못했지만, 14살 무렵 벨의 책 『수학을 만든 사람들』을 읽고 책에 나온 페르마의 결과를 스스로 증명해 내며 수학에 빠져들었어요.","unit":"고 확률과 통계","classroom":"가위바위보 같은 게임에서 가장 좋은 전략이 무엇인지 토론하며 게임 이론의 내시를 소개해 보세요.","art":"dice","event":"1576년 오늘, 티코 브라헤가 벤섬을 받아 그곳에 우라니보르와 스티에르네보르 두 천문대를 지었어요.","born":[{"year":"1606","name":"Juan Caramuel","slug":"Caramuel"},{"year":"1884","name":"Corrado Gini","slug":"Gini"},{"year":"1886","name":"Luigi Amoroso","slug":"Amoroso"},{"year":"1887","name":"Thoralf Skolem","slug":"Skolem"},{"year":"1901","name":"John Williamson","slug":"Williamson"},{"year":"1903","name":"William Prager","slug":"Prager"},{"year":"1914","name":"Lipman Bers","slug":"Bers"},{"year":"1917","name":"Edward Lorenz","slug":"Lorenz_Edward"},{"year":"1928","name":"Ioan James","slug":"James"},{"year":"1936","name":"John Howie","slug":"Howie"},{"year":"1940","name":"Cora Sadosky","slug":"Sadosky"}],"died":[{"year":"1691","name":"Adrien Auzout","slug":"Auzout"},{"year":"1857","name":"Augustin-Louis Cauchy","slug":"Cauchy"},{"year":"1885","name":"Thomas Clausen","slug":"Clausen"},{"year":"1889","name":"George-Henri Halphen","slug":"Halphen"},{"year":"1895","name":"Franz Neumann","slug":"Neumann_Franz"},{"year":"2005","name":"Umirzak Sultangazin","slug":"Sultangazin"},{"year":"2014","name":"Bronius Grigelionis","slug":"Grigelionis"},{"year":"2015","name":"John F Nash","slug":"Nash"}]},{"date":"05-24","slug":"Whewell","kind":"born","year":"1794","life":"1794–1866","name":"William Whewell","nameKo":"윌리엄 휴얼","title":"대륙식 기호로 역학 교과서를 쓴 휴얼","body":"윌리엄 휴얼은 과학철학과 과학사로 이름난 영국의 학자예요. 목수의 아들이었지만 교장의 도움으로 공부를 이어 갔고, 앞을 보지 못하는 수학자 존 고프에게 원뿔곡선과 역학을 배웠어요. 1819년에 펴낸 역학 교과서는 유럽 대륙식 수학 기호를 받아들인 영어권 최초의 응용수학 책이었어요.","unit":"공통","classroom":"교과서 속 기호가 어떻게 정해졌는지 이야기할 때 대륙식 기호를 들여온 휴얼의 교과서를 소개해 보세요.","art":"textbook","event":"997년 오늘, 알비루니와 아불 와파가 서로 다른 도시에서 같은 월식을 관측해 두 도시의 경도 차이를 구했어요.","born":[{"year":"1794","name":"William Whewell","slug":"Whewell"},{"year":"1820","name":"William Chauvenet","slug":"Chauvenet"},{"year":"1859","name":"Giulio Vivanti","slug":"Vivanti"},{"year":"1888","name":"Giovanni Sansone","slug":"Sansone"},{"year":"1903","name":"Władysław Orlicz","slug":"Orlicz"},{"year":"1909","name":"Karl Heinrich Weise","slug":"Weise"},{"year":"1914","name":"Federico Cafiero","slug":"Cafiero"},{"year":"1924","name":"Jacques Dixmier","slug":"Dixmier"},{"year":"1932","name":"Gilberto Loibel","slug":"Loibel"}],"died":[{"year":"1543","name":"Nicolaus Copernicus","slug":"Copernicus"},{"year":"1843","name":"Sylvestre Lacroix","slug":"Lacroix"},{"year":"1896","name":"Luigi Menabrea","slug":"Menabrea"},{"year":"1912","name":"Heinrich Friedrich Weber","slug":"Weber_Heinrich_F"},{"year":"1976","name":"John Evelyn","slug":"Evelyn"}]},{"date":"05-25","slug":"Smullyan","kind":"born","year":"1919","life":"1919–2017","name":"Raymond Smullyan","nameKo":"레이먼드 스멀리언","title":"논리 퍼즐 책으로 사랑받은 스멀리언","body":"레이먼드 스멀리언은 수학자이자 논리학자, 마술사, 피아니스트였고 무엇보다 논리 퍼즐 책으로 유명해요. 여섯 살 만우절에 형이 '오늘 제대로 속여 주겠다'고 해 놓고 하루 종일 아무 일도 하지 않자, 정말 속은 건지 밤늦게까지 고민했대요. 거꾸로 추리하는 체스 문제도 즐겨 만들었어요.","unit":"고 명제","classroom":"명제 단원에서 스멀리언의 만우절 일화를 들려주고 '나는 속은 걸까?'를 논리적으로 따져 보게 하세요.","art":"godel","event":"1842년 오늘, 도플러가 왕립 보헤미아 학회에서 도플러 효과에 관한 강연을 했어요.","born":[{"year":"1828","name":"Karl Peterson","slug":"Peterson"},{"year":"1903","name":"Leifur Ásgeirsson","slug":"Asgeirsson"},{"year":"1919","name":"Raymond Smullyan","slug":"Smullyan"},{"year":"1922","name":"Robert Steinberg","slug":"Steinberg"}],"died":[{"year":"1555","name":"Gemma Frisius","slug":"Gemma_Frisius"},{"year":"1676","name":"Johann Rahn","slug":"Rahn"},{"year":"1807","name":"Nicolas Vilant","slug":"Vilant"},{"year":"1946","name":"Percy Daniell","slug":"Daniell"},{"year":"1956","name":"Johann Radon","slug":"Radon"},{"year":"1963","name":"Tommaso Boggio","slug":"Boggio"},{"year":"1972","name":"José Sebastiao e Silva","slug":"Silva"},{"year":"2014","name":"Robert Steinberg","slug":"Steinberg"}]},{"date":"05-26","slug":"De_Moivre","kind":"born","year":"1667","life":"1667–1754","name":"Abraham de Moivre","nameKo":"아브라암 드무아브르","title":"확률론을 개척한 망명 수학자 드무아브르","body":"아브라암 드무아브르는 종교 박해를 피해 영국으로 건너간 프랑스 출신 수학자로, 해석기하학과 확률론을 개척했어요. 런던에서 가정교사로 학생들 집을 오가며 생계를 꾸렸는데, 뉴턴의 『프린키피아』를 사서 몇 쪽씩 뜯어 들고 다니며 이동 중에 읽었대요. 나중에는 뉴턴과도 친구가 되었어요.","unit":"고 확률과 통계","classroom":"확률 단원 도입에서 하위헌스의 도박 책을 읽고 확률에 빠진 드무아브르 이야기를 들려주세요.","art":"dice","event":"1798년 오늘, 몽주가 푸리에, 말뤼스와 함께 나폴레옹의 이집트 원정대를 따라 이탈리아를 떠났어요.","born":[{"year":"1667","name":"Abraham de Moivre","slug":"De_Moivre"},{"year":"1750","name":"William Morgan","slug":"Morgan_William"},{"year":"1885","name":"William B Coutts","slug":"Coutts"},{"year":"1896","name":"Yurii Sokolov","slug":"Sokolov"},{"year":"1899","name":"Otto Neugebauer","slug":"Neugebauer"}],"died":[{"year":"1926","name":"Frank Cole","slug":"Cole"},{"year":"1977","name":"Oliver Sutton","slug":"Sutton"},{"year":"1984","name":"Mary Taylor","slug":"Taylor_Mary"}]},{"date":"05-27","slug":"Moreno","kind":"born","year":"1925","life":"1925–2015","name":"Adelina Gutiérrez Moreno","nameKo":"아델리나 구티에레스","title":"칠레 최초의 천체물리학 박사 구티에레스","body":"아델리나 구티에레스는 칠레 최초로 천체물리학 박사 학위를 받은 과학자예요. 수학·물리 교사 자격을 얻어 고등학교에서 잠시 가르친 뒤 국립천문대에서 일하기 시작했어요. 칠레 최초의 천문학 학사·석사 과정을 만드는 데 앞장섰고, 칠레 과학아카데미 최초의 여성 회원이 되었어요.","unit":"공통","classroom":"수학 교사에서 천문학자로 나아간 구티에레스의 길을 진로 탐색 수업의 사례로 활용해 보세요.","art":"earth","event":"1849년 오늘, 체비쇼프가 상트페테르부르크 대학교에서 정수론 박사 논문 『합동의 이론』을 심사받았어요.","born":[{"year":"1862","name":"John Campbell","slug":"Campbell"},{"year":"1907","name":"Herbert Seifert","slug":"Seifert"},{"year":"1919","name":"Erwin Hiebert","slug":"Hiebert"},{"year":"1925","name":"Adelina Gutiérrez Moreno","slug":"Moreno"},{"year":"1928","name":"Charles Costley","slug":"Costley"}],"died":[{"year":"1928","name":"Arthur Schönflies","slug":"Schonflies"},{"year":"1958","name":"Anton Davidoglu","slug":"Davidoglu"},{"year":"1962","name":"Felix Behrend","slug":"Behrend"},{"year":"1964","name":"Brian Haselgrove","slug":"Haselgrove"},{"year":"2004","name":"Mikhail Mikhailovich Postnikov","slug":"Postnikov"},{"year":"2012","name":"Friedrich Hirzebruch","slug":"Hirzebruch"}]},{"date":"05-28","slug":"Riccati","kind":"born","year":"1676","life":"1676–1754","name":"Jacopo Riccati","nameKo":"야코포 리카티","title":"리카티 미분방정식의 주인공 리카티","body":"야코포 리카티는 '리카티 미분방정식'으로 잘 알려진 이탈리아의 수학자예요. 파도바 대학교에서 법학을 공부하던 중 천문학 교수에게서 뉴턴의 『프린키피아』를 받은 것을 계기로 수학에 빠졌고, 거의 혼자 힘으로 수학을 익혔어요. 9년 동안 시장으로 일했고 18명의 자녀를 두었어요.","unit":"고 미분","classroom":"미분 단원을 마무리하며 '변화율로 세운 방정식'인 미분방정식의 예로 리카티를 소개해 보세요.","art":"tangent","event":"1555년 오늘, 수학을 마술처럼 여기던 영국에서 존 디가 '계산을 했다'는 혐의로 체포되었어요.","born":[{"year":"1676","name":"Jacopo Riccati","slug":"Riccati"},{"year":"1710","name":"Johann (II) Bernoulli","slug":"Bernoulli_Johann(II)"},{"year":"1871","name":"James Mitchell","slug":"Mitchell_James"},{"year":"1872","name":"Marian Smoluchowski","slug":"Smoluchowski"},{"year":"1881","name":"Lajos Dávid","slug":"David_Lajos"},{"year":"1902","name":"Stefan Cohn-Vossen","slug":"Cohn-Vossen"},{"year":"1908","name":"Egbert van Kampen","slug":"Van_Kampen"},{"year":"1912","name":"Hans Zassenhaus","slug":"Zassenhaus"},{"year":"1920","name":"George Butcher","slug":"Butcher"},{"year":"1930","name":"Bill Morton","slug":"Morton"}],"died":[{"year":"1968","name":"Karel Rychlik","slug":"Rychlik"},{"year":"1980","name":"Rolf Nevanlinna","slug":"Nevanlinna"},{"year":"1982","name":"Carlo Miranda","slug":"Miranda"},{"year":"1997","name":"Ron Book","slug":"Book"},{"year":"2000","name":"Donald Davies","slug":"Davies_Donald"}]},{"date":"05-29","slug":"Szekeres","kind":"born","year":"1911","life":"1911–2005","name":"George Szekeres","nameKo":"조지 세케레시","title":"'해피엔딩 문제'의 주인공 세케레시","body":"조지 세케레시는 헝가리에서 태어나 오스트레일리아에서 기하학과 조합론을 연구한 수학자예요. 친구 에스테르 클라인이 '어느 세 점도 한 직선 위에 있지 않은 다섯 점 중 네 점은 볼록사각형을 이룬다'는 문제를 냈고, 그는 에르되시와 함께 이를 일반화했어요. 그가 에스테르와 결혼하자 에르되시가 '해피엔딩 문제'라는 이름을 붙였어요.","unit":"중2 사각형의 성질","classroom":"종이에 점 다섯 개를 찍어 볼록사각형을 찾아보는 활동으로 '해피엔딩 문제'를 직접 확인해 보세요.","art":"graph","event":"1919년 오늘, 에딩턴이 개기일식을 관측해 빛이 태양의 중력 때문에 휜다는 아인슈타인의 예측을 확인했어요.","born":[{"year":"1834","name":"William Jack","slug":"Jack_William"},{"year":"1882","name":"Harry Bateman","slug":"Bateman"},{"year":"1885","name":"Finlay Freundlich","slug":"Freundlich"},{"year":"1893","name":"Charles Loewner","slug":"Loewner"},{"year":"1911","name":"George Szekeres","slug":"Szekeres"},{"year":"1918","name":"David Rees","slug":"Rees_David"},{"year":"1929","name":"Günter Lumer","slug":"Lumer"},{"year":"1957","name":"Jean-Christophe Yoccoz","slug":"Yoccoz"}],"died":[{"year":"1660","name":"Frans van Schooten","slug":"Schooten"},{"year":"1917","name":"William Niven","slug":"Niven"},{"year":"1962","name":"Arnold Walfisz","slug":"Walfisz"},{"year":"1978","name":"Guglielmo Righini","slug":"Righini"},{"year":"1999","name":"John Knopfmacher","slug":"Knopfmacher"},{"year":"2005","name":"Kazimierz Urbanik","slug":"Urbanik"}]},{"date":"05-30","slug":"Feuerbach","kind":"born","year":"1800","life":"1800–1834","name":"Karl Feuerbach","nameKo":"카를 포이어바흐","title":"삼각형의 구점원을 발견한 포이어바흐","body":"카를 포이어바흐는 삼각형의 구점원을 발견한 독일의 기하학자예요. 구점원은 세 변의 중점과 세 꼭짓점에서 대변에 내린 수선의 발 등 아홉 개의 점을 한꺼번에 지나는 원이에요. 형제 다섯이 박사가 될 만큼 학구적인 집안이었고, 동생은 유명한 철학자 루트비히 포이어바흐예요.","unit":"중2 삼각형의 성질","classroom":"삼각형의 외심을 배운 뒤 공학 도구로 아홉 점이 한 원 위에 있는지 확인해 보세요.","art":"euclid","event":"1832년 오늘, 갈루아가 결투에서 총상을 입었고 다음 날 세상을 떠났어요.","born":[{"year":"1423","name":"Georg Peurbach","slug":"Peurbach"},{"year":"1800","name":"Karl Feuerbach","slug":"Feuerbach"},{"year":"1814","name":"Eugène Catalan","slug":"Catalan"},{"year":"1874","name":"Beatrice Mabel Cave-Browne-Cave","slug":"Cave-Browne-Cave_Beatrice"},{"year":"1875","name":"Charlotte Pengra","slug":"Pengra"},{"year":"1925","name":"Olli Lehto","slug":"Lehto"},{"year":"1927","name":"Joan Sylvia Lyttle Birman","slug":"Birman"}],"died":[{"year":"1926","name":"Vladimir A Steklov","slug":"Steklov"},{"year":"1933","name":"Semyon Aranovich Gershgorin","slug":"Gershgorin"},{"year":"1943","name":"Anderson McKendrick","slug":"McKendrick"},{"year":"1964","name":"Theodor Angheluță","slug":"Angheluta"},{"year":"1989","name":"Gianfranco Cimmino","slug":"Cimmino"},{"year":"1992","name":"Antoni Zygmund","slug":"Zygmund"},{"year":"2008","name":"Gilbert Hunt","slug":"Hunt"},{"year":"2016","name":"Henri Cabannes","slug":"Cabannes"}]},{"date":"05-31","slug":"Kemeny","kind":"born","year":"1926","life":"1926–1992","name":"John Kemeny","nameKo":"존 케메니","title":"프로그래밍 언어 베이식을 만든 케메니","body":"존 케메니는 헝가리 출신의 미국 수학자이자 컴퓨터 과학자예요. 1963년 토머스 커츠와 함께 학생들이 쉽게 컴퓨터를 쓸 수 있도록 베이식(BASIC) 언어를 만들었어요. 대학원생 시절에는 아인슈타인의 수학 조수였는데, 긴 계산에서는 누구나 실수하기 때문에 아인슈타인에게도 조수가 필요했다고 회고했어요.","unit":"공통","classroom":"코딩 활동 전에 '누구나 쓸 수 있는 언어'를 꿈꾼 케메니의 베이식 이야기를 들려주세요.","art":"turing","event":"1941년 오늘, 슈타인하우스가 나치군이 리비우에 들어오기 며칠 전 '스코틀랜드 책'에 마지막 문제를 적었어요.","born":[{"year":"1801","name":"Antoine Meyer","slug":"Meyer_Antoine"},{"year":"1861","name":"William Peddie","slug":"Peddie"},{"year":"1903","name":"Alan Broadbent","slug":"Broadbent"},{"year":"1907","name":"Hermann Arthur Jahn","slug":"Jahn"},{"year":"1910","name":"Nikolai Vladimirovich Efimov","slug":"Efimov"},{"year":"1926","name":"John Kemeny","slug":"Kemeny"}],"died":[{"year":"1832","name":"Évariste Galois","slug":"Galois"},{"year":"1841","name":"George Green","slug":"Green"},{"year":"1907","name":"Francesco Siacci","slug":"Siacci"},{"year":"1931","name":"Eugène Cosserat","slug":"Cosserat"},{"year":"1991","name":"Robert Schlapp","slug":"Schlapp"},{"year":"1992","name":"Marian Țarină","slug":"Tarina"},{"year":"1998","name":"Michio Suzuki","slug":"Suzuki_Michio"},{"year":"2000","name":"Erich Kähler","slug":"Kahler"},{"year":"2008","name":"Detlef Gromoll","slug":"Gromoll"},{"year":"2019","name":"Margaret Rayner","slug":"Rayner"}]}]