name":"Leslie Ellis","slug":"Ellis"},{"year":"1927","name":"Giuseppe Bagnera","slug":"Bagnera"},{"year":"1952","name":"George Lidstone","slug":"Lidstone"},{"year":"1977","name":"Joseph Dennis","slug":"Dennis"},{"year":"2021","name":"Ubiratan D'Ambrosio","slug":"DAmbrosio"}]},{"date":"05-13","slug":"Mascheroni","kind":"born","year":"1750","life":"1750–1800","name":"Lorenzo Mascheroni","nameKo":"로렌초 마스케로니","title":"컴퍼스 하나로 모든 작도를 해낸 마스케로니","body":"로렌초 마스케로니는 이탈리아의 사제이자 수학자, 시인이에요. 1797년 『컴퍼스의 기하학』에서 자와 컴퍼스로 할 수 있는 모든 작도를 컴퍼스만으로 할 수 있음을 증명했고, 이 책을 나폴레옹에게 시로 헌정했어요. 다만 같은 결과를 125년 전 덴마크의 게오르그 모르가 먼저 증명해 두었어요.","unit":"중1 작도","classroom":"작도 수업에서 '자 없이 컴퍼스만으로 작도할 수 있을까?'를 도전 과제로 내 보세요.","art":"euclid","event":"1673년 오늘, 제임스 그레고리가 깃털로 햇빛을 통과시키는 회절 실험을 뉴턴에게 전해 달라는 편지를 썼어요.","born":[{"year":"1750","name":"Lorenzo Mascheroni","slug":"Mascheroni"},{"year":"1753","name":"Lazare Carnot","slug":"Carnot"},{"year":"1899","name":"Pelageia Polubarinova Kochina","slug":"Kochina"},{"year":"1926","name":"Franz Kahn","slug":"Kahn"},{"year":"1931","name":"András Hajnal","slug":"Hajnal"},{"year":"1938","name":"Detlef Gromoll","slug":"Gromoll"}],"died":[{"year":"1734","name":"Giovanni Ceva","slug":"Ceva_Giovanni"},{"year":"1826","name":"Christian Kramp","slug":"Kramp"},{"year":"1866","name":"Nikolai Dmetrievich Brashman","slug":"Brashman"},{"year":"1868","name":"Jean-Baptiste Brasseur","slug":"Brasseur"},{"year":"1915","name":"Morgan Crofton","slug":"Crofton"},{"year":"1919","name":"Eugen Netto","slug":"Netto"},{"year":"1939","name":"Stanisław Leśniewski","slug":"Lesniewski"},{"year":"1944","name":"William Berwick","slug":"Berwick"},{"year":"1957","name":"Michael Fekete","slug":"Fekete"},{"year":"1965","name":"Thomas Arnold Brown","slug":"Brown_Thomas"},{"year":"1984","name":"Stan Ulam","slug":"Ulam"},{"year":"2001","name":"Donald Eperson","slug":"Eperson"},{"year":"2005","name":"George Dantzig","slug":"Dantzig_George"}]},{"date":"05-14","slug":"Fields","kind":"born","year":"1863","life":"1863–1932","name":"John Charles Fields","nameKo":"존 찰스 필즈","title":"필즈상을 만든 캐나다 수학자 필즈","body":"존 찰스 필즈는 대수함수를 연구한 캐나다의 수학자로, 수학계를 조직하는 일에 특히 뛰어났어요. 그가 내놓은 기금으로 '수학의 노벨상'이라 불리는 국제 메달, 곧 필즈상이 만들어졌어요. 학창 시절 부모를 잇달아 잃었지만 토론토 대학교를 수학 금메달을 받으며 졸업했어요.","unit":"공통","classroom":"수학에는 노벨상이 없는 대신 어떤 상이 있는지 물으며 필즈상과 그 이름의 주인공을 소개해 보세요.","art":"medal","event":"1979년 오늘, 이본 쇼케-브뤼아가 여성 최초로 프랑스 과학아카데미 정회원이 되었어요.","born":[{"year":"1701","name":"William Emerson","slug":"Emerson"},{"year":"1832","name":"Rudolf Lipschitz","slug":"Lipschitz"},{"year":"1863","name":"John Charles Fields","slug":"Fields"},{"year":"1875","name":"Beppo Levi","slug":"Levi_Beppo"},{"year":"1878","name":"Roland Richardson","slug":"Richardson_Roland"},{"year":"1888","name":"Archie Alexander","slug":"Alexander_Archie"},{"year":"1917","name":"William Tutte","slug":"Tutte"}],"died":[{"year":"1761","name":"Thomas Simpson","slug":"Simpson"},{"year":"1797","name":"Giovanni Fagnano","slug":"Fagnano_Giovanni"},{"year":"1887","name":"Johann Rosenhain","slug":"Rosenhain"},{"year":"1893","name":"Eduard Kummer","slug":"Kummer"},{"year":"1909","name":"Giovanni Vailati","slug":"Vailati"},{"year":"1927","name":"Woolsey Johnson","slug":"Johnson_Woolsey"},{"year":"1984","name":"Emilio Baiada","slug":"Baiada"},{"year":"2014","name":"Murray Macbeath","slug":"Macbeath"},{"year":"2021","name":"Wang Yuan","slug":"Wang_Yuan"}]},{"date":"05-15","slug":"Schooten","kind":"born","year":"1615","life":"1615–1660","name":"Frans van Schooten","nameKo":"프란스 판 스호턴","title":"데카르트의 좌표기하를 퍼뜨린 판 스호턴","body":"프란스 판 스호턴은 데카르트의 좌표기하학을 널리 퍼뜨리는 데 앞장선 네덜란드의 수학자예요. 데카르트가 『방법서설』과 그 부록 『기하학』을 펴내기 전, 데카르트의 부탁으로 그림 작업을 도왔어요. 그림 솜씨도 뛰어나 몇 점 남지 않은 데카르트의 초상화 가운데 하나를 그리기도 했어요.","unit":"중1 좌표평면과 그래프","classroom":"좌표평면을 처음 배울 때 데카르트 곁에서 그림을 그려 준 조력자 판 스호턴을 함께 소개해 보세요.","art":"coordinates","event":"1961년 오늘, 아르헨티나 최초의 컴퓨터 '클레멘티나'가 부에노스아이레스 대학교에서 가동을 시작했어요.","born":[{"year":"1615","name":"Frans van Schooten","slug":"Schooten"},{"year":"1637","name":"Valentin Heins","slug":"Heins"},{"year":"1801","name":"Joseph Raabe","slug":"Raabe"},{"year":"1835","name":"Émile Mathieu","slug":"Mathieu_Emile"},{"year":"1857","name":"Hermann Wiener","slug":"Wiener_Hermann"},{"year":"1857","name":"Mina Fleming","slug":"Fleming"},{"year":"1865","name":"Alice Everett","slug":"Everett"},{"year":"1900","name":"Ida Rhodes","slug":"Rhodes"},{"year":"1939","name":"Brian Hartley","slug":"Hartley"},{"year":"1964","name":"Sijue Wu","slug":"Wu"}],"died":[{"year":"1821","name":"John Bonnycastle","slug":"Bonnycastle"},{"year":"1907","name":"Anne Bosworth","slug":"Bosworth"},{"year":"1975","name":"Taira Honda","slug":"Honda"},{"year":"1989","name":"Orymbek Zhautykov","slug":"Zhautykov"},{"year":"1991","name":"Andreas Floer","slug":"Floer"},{"year":"2016","name":"Jacques Neveu","slug":"Neveu"},{"year":"2019","name":"Dionisio Gallarati","slug":"Gallarati"},{"year":"2021","name":"M S Narasimhan","slug":"Narasimhan_M_S"}]},{"date":"05-16","slug":"Agnesi","kind":"born","year":"1718","life":"1718–1799","name":"Maria Agnesi","nameKo":"마리아 가에타나 아녜시","title":"'아녜시의 마녀' 곡선으로 이름난 아녜시","body":"마리아 가에타나 아녜시는 미분학 연구로 이름난 이탈리아의 수학자예요. 지금 '아녜시의 마녀'라고 불리는 삼차곡선을 다룬 것으로 유명해요. 어려서부터 라틴어, 그리스어, 히브리어를 익혔고, 아버지가 연 모임에서 뉴턴의 철학을 놓고 라틴어로 토론해 손님들을 놀라게 했어요.","unit":"고 미분","classroom":"미분을 이용한 그래프 그리기를 연습할 때 '아녜시의 마녀' 곡선을 함께 그려 보세요.","art":"cubic","event":"2005년 오늘, 레노어 블룸이 여학생들에게 과학 진로를 열어 준 공로로 미국 대통령 멘토링상 수상자로 발표되었어요.","born":[{"year":"1718","name":"Maria Agnesi","slug":"Agnesi"},{"year":"1814","name":"Daniel da Silva","slug":"Da_Silva"},{"year":"1821","name":"Pafnuty Chebyshev","slug":"Chebyshev"},{"year":"1878","name":"Leon Lichtenstein","slug":"Lichtenstein"},{"year":"1909","name":"Werner Romberg","slug":"Romberg"},{"year":"1909","name":"Hidegorô Nakano","slug":"Nakano"},{"year":"1911","name":"Eizens Arins","slug":"Arins"},{"year":"1911","name":"Jack Todd","slug":"Todd_John"},{"year":"1934","name":"Roy Kerr","slug":"Kerr_Roy"}],"died":[{"year":"1830","name":"Joseph Fourier","slug":"Fourier"},{"year":"1935","name":"Hector Macdonald","slug":"Macdonald"},{"year":"1939","name":"Sidney Luxton Loney","slug":"Loney"},{"year":"1943","name":"Roberto Marcolongo","slug":"Marcolongo"},{"year":"1983","name":"Édouard Zeckendorf","slug":"Zeckendorf"},{"year":"1988","name":"Zofia Krygowska","slug":"Krygowska_Zofia"},{"year":"1989","name":"Ernst Mohr","slug":"Mohr_Ernst"},{"year":"2012","name":"Hideo Tanaka","slug":"Tanaka"},{"year":"2025","name":"Peter Lax","slug":"Lax_Peter"}]},{"date":"05-17","slug":"Hronec","kind":"born","year":"1881","life":"1881–1959","name":"Jur Hronec","nameKo":"유르 흐로네츠","title":"슬로바키아 고등 수학의 개척자 흐로네츠","body":"유르 흐로네츠는 슬로바키아에 고등 수학이 뿌리내리게 하고 여러 대학을 세우는 데 앞장선 수학자예요. 아홉 살 때부터 집안의 제철소 일을 도우며 숯과 광석을 날랐고, 초등학교 선생님은 의사가 되고 싶다는 그를 비웃었어요. 어머니가 황소를 팔아 책을 사 준 덕에 중등학교에 진학했고, 수학과 물리에 빠져 수학 과외로 학비를 벌었어요.","unit":"공통","classroom":"꿈을 비웃음당하고도 공부를 이어 간 흐로네츠 이야기로 학생들의 학습 동기를 북돋아 보세요.","art":"textbook","event":"1861년 오늘, 맥스웰이 왕립연구소에서 타탄 리본을 찍은 삼원색 컬러 사진을 선보였어요.","born":[{"year":"1693","name":"Johann Penther","slug":"Penther"},{"year":"1881","name":"Jur Hronec","slug":"Hronec"},{"year":"1928","name":"Eric Milner","slug":"Milner"},{"year":"1942","name":"Steve Rallis","slug":"Rallis"}],"died":[{"year":"1729","name":"Samuel Clarke","slug":"Clarke"},{"year":"1765","name":"Alexis Clairaut","slug":"Clairaut"},{"year":"1913","name":"Heinrich Weber","slug":"Weber_Heinrich"},{"year":"1916","name":"Mary Everest Boole","slug":"Boole_Mary"},{"year":"2001","name":"Jacques-Louis Lions","slug":"Lions_Jacques-Louis"}]},{"date":"05-18","slug":"Khayyam","kind":"born","year":"1048","life":"1048–1131","name":"Omar Khayyam","nameKo":"오마르 하이얌","title":"포물선과 원으로 삼차방정식을 푼 하이얌","body":"오마르 하이얌은 페르시아의 수학자이자 천문학자, 그리고 시인이에요. 포물선과 원의 교점을 이용해 삼차방정식을 기하학적으로 푸는 방법을 찾았어요. 1079년에는 여덟 명의 학자 중 한 명으로 달력 개혁에 참여했어요. 이름 '하이얌'은 '천막 만드는 사람'이라는 뜻이에요.","unit":"고 방정식","classroom":"포물선과 원을 함께 그려 교점을 찾는 활동으로 하이얌의 삼차방정식 풀이를 체험해 보세요.","art":"cubic","event":"1787년 오늘, 라그랑주가 20년 넘게 일한 베를린을 떠나 파리 과학아카데미로 향했어요.","born":[{"year":"1048","name":"Omar Khayyam","slug":"Khayyam"},{"year":"1711","name":"Ruggero Giuseppe Boscovich","slug":"Boscovich"},{"year":"1850","name":"Oliver Heaviside","slug":"Heaviside"},{"year":"1852","name":"Samuel Saunder","slug":"Saunder"},{"year":"1853","name":"Albert Badoureau","slug":"Badoureau"},{"year":"1872","name":"Bertrand Russell","slug":"Russell"},{"year":"1914","name":"Stefan Schwarz","slug":"Schwarz_Stefan"},{"year":"1937","name":"Horace Mochizuki","slug":"Mochizuki"},{"year":"1937","name":"V S Varadarajan","slug":"Varadarajan"},{"year":"1944","name":"James Arthur","slug":"Arthur_James"},{"year":"1946","name":"Celia Hoyles","slug":"Hoyles"}],"died":[{"year":"1924","name":"Corrado Segre","slug":"Segre_Corrado"},{"year":"1954","name":"Selig Brodetsky","slug":"Brodetsky"},{"year":"1965","name":"Eduard Jan Dijksterhuis","slug":"Dijksterhuis"},{"year":"1971","name":"Aleksandr G Kurosh","slug":"Kurosh"},{"year":"2024","name":"Tom Blyth","slug":"Blyth"}]},{"date":"05-19","slug":"Mei_Juecheng","kind":"born","year":"1681","life":"1681–1763","name":"Mei Juecheng","nameKo":"메이줴청","title":"청나라 수학 백과를 엮은 메이줴청","body":"메이줴청은 할아버지 메이원딩의 저작을 엮고 넓힌 청나라의 수학자예요. 강희제에게서 서양 대수학 책을 받아 읽고, 그 방법이 원나라 학자들이 쓰던 중국 전통의 '천원술'과 사실상 같다고 주장했어요. 1712년 궁정 수학자가 되었고, 수학 백과 『수리정온』의 책임 편집자로 일했어요.","unit":"중1 문자와 식","classroom":"문자로 식을 세우는 방법이 동양과 서양 모두에 있었다는 이야기로 대수 단원을 열어 보세요.","art":"algebra","event":"1782년 오늘, 국왕의 연금을 받게 된 윌리엄 허셜이 바스의 예배당에서 음악가로서 마지막 연주를 했어요.","born":[{"year":"1681","name":"Mei Juecheng","slug":"Mei_Juecheng"},{"year":"1832","name":"Edmond Bour","slug":"Bour"},{"year":"1862","name":"Gino Loria","slug":"Loria"},{"year":"1865","name":"Flora Philip","slug":"Philip_Flora"},{"year":"1876","name":"James Gray","slug":"Gray_James"},{"year":"1919","name":"Georgii Dmitrievich Suvorov","slug":"Suvorov"},{"year":"1927","name":"Serge Lang","slug":"Lang"},{"year":"1930","name":"Rudolf Kalman","slug":"Kalman"},{"year":"1931","name":"Stanisław Knapowski","slug":"Knapowski"},{"year":"1962","name":"Richard Taylor","slug":"Taylor_Richard"}],"died":[{"year":"804","name":"Alcuin","slug":"Alcuin"},{"year":"1824","name":"Francis Maseres","slug":"Maseres"},{"year":"1940","name":"Philipp Furtwängler","slug":"Furtwangler"},{"year":"1942","name":"Joseph Larmor","slug":"Larmor"},{"year":"1979","name":"Ralph James","slug":"James_Ralph"}]},{"date":"05-20","slug":"Euwe","kind":"born","year":"1901","life":"1901–1981","name":"Machgielis Euwe","nameKo":"막스 외버","title":"세계 체스 챔피언이 된 수학 교사 외버","body":"막스 외버는 1935년부터 1937년까지 세계 체스 챔피언이었던 네덜란드의 수학자예요. 암스테르담의 여학교에서 14년간 수학을 가르쳤어요. 1929년 논문에서는 0과 1로 이루어진 특별한 무한 수열을 만들어, 당시 규칙으로는 체스가 영원히 끝나지 않을 수도 있음을 보였어요.","unit":"고 수열","classroom":"같은 덩어리가 세 번 연달아 반복되지 않는 0과 1의 수열을 만들어 보게 하며 외버의 체스 이야기를 꺼내 보세요.","art":"graph","event":"1608년 오늘, 마리노 게탈디가 클라비우스에게 자신의 포물면 거울이 납뿐 아니라 은까지 녹인다고 편지했어요.","born":[{"year":"1861","name":"Henry White","slug":"White"},{"year":"1870","name":"Robert de Montessus","slug":"Montessus"},{"year":"1874","name":"Friedrich Hartogs","slug":"Hartogs"},{"year":"1901","name":"Machgielis Euwe","slug":"Euwe"},{"year":"1908","name":"Hannes Alfvén","slug":"Alfven"},{"year":"1946","name":"George Lusztig","slug":"Lusztig"},{"year":"1951","name":"Jonathan Borwein","slug":"Borwein_Jonathan"}],"died":[{"year":"1677","name":"John Kersey","slug":"Kersey"},{"year":"1782","name":"William Emerson","slug":"Emerson"},{"year":"1798","name":"Erland Bring","slug":"Bring"},{"year":"1943","name":"Henry White","slug":"White"},{"year":"1975","name":"Jacy Monteiro","slug":"Monteiro"},{"year":"2010","name":"Walter Rudin","slug":"Rudin_Walter"}]},{"date":"05-21","slug":"Durer","kind":"born","year":"1471","life":"1471–1528","name":"Albrecht Dürer","nameKo":"알브레히트 뒤러","title":"기하학을 그림에 담은 판화가 뒤러","body":"알브레히트 뒤러는 판화로 유명한 독일의 화가예요. 그가 세상을 떠난 1528년에 나온 인체 비례에 관한 책은 화법기하학의 기초를 놓은 것으로 평가받아요. 집안의 원래 성은 헝가리어로 '문'을 뜻하는 아이토시였는데, 독일로 오면서 독일어 '문'과 소리가 비슷한 이름으로 바꾸었대요.","unit":"중2 닮음","classroom":"닮음과 비 단원에서 뒤러가 연구한 인체 비례를 직접 재 보는 