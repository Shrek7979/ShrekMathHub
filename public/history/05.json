[{"date":"05-01","slug":"Wilkins_Ernest","kind":"died","year":"2011","life":"1923–2011","name":"J Ernest Wilkins","nameKo":"J. 어니스트 윌킨스 주니어","title":"13살에 대학에 들어간 수학자 윌킨스","body":"J. 어니스트 윌킨스 주니어는 아프리카계 미국인 수학자이자 원자력 과학자예요. 1936년 겨우 13살에 시카고 대학교에 입학해 그 대학 역사상 가장 어린 학생이 되었고, 19번째 생일 며칠 뒤에 박사 학위를 받았어요. 순수수학뿐 아니라 원자로 공학과 광학 연구에도 힘을 쏟았어요.","unit":"공통","classroom":"나이와 배경의 벽을 넘어 수학의 길을 연 사례로, 진로 수업에서 윌킨스의 이야기를 들려주세요.","art":"conic","event":"1631년 오늘, 법률가로 일하며 수학을 연구한 페르마가 오를레앙 대학교에서 민법 학사 학위를 받았어요.","born":[{"year":"1583","name":"Orazio Grassi","slug":"Grassi"},{"year":"1793","name":"Jakob Kulik","slug":"Kulik"},{"year":"1825","name":"Johann Balmer","slug":"Balmer"},{"year":"1863","name":"Luigi Berzolari","slug":"Berzolari"},{"year":"1891","name":"Louis Melville Milne-Thomson","slug":"Milne-Thomson"},{"year":"1908","name":"Morris Kline","slug":"Kline"},{"year":"1908","name":"Hans Schubert","slug":"Schubert_Hans"},{"year":"1911","name":"Orymbek Zhautykov","slug":"Zhautykov"},{"year":"1924","name":"Evelyn Boyd Granville","slug":"Granville"},{"year":"1926","name":"Peter Lax","slug":"Lax_Peter"},{"year":"1942","name":"Jane Wadsworth","slug":"Wadsworth"},{"year":"1956","name":"Laila Soueif","slug":"Soueif"}],"died":[{"year":"1870","name":"Gabriel Lamé","slug":"Lame"},{"year":"1916","name":"Adolf Weiler","slug":"Weiler"},{"year":"2011","name":"Steven Orszag","slug":"Orszag"},{"year":"2011","name":"J Ernest Wilkins","slug":"Wilkins_Ernest"}]},{"date":"05-02","slug":"Leonardo","kind":"died","year":"1519","life":"1452–1519","name":"Leonardo da Vinci","nameKo":"레오나르도 다빈치","title":"기하학에 푹 빠졌던 화가 레오나르도 다빈치","body":"레오나르도 다빈치는 그림으로 유명하지만 역학, 광학, 수학까지 두루 연구했고 그중 기하학을 가장 사랑했어요. 유클리드와 파치올리의 책을 공부했고, 파치올리의 책 『신성한 비례』에 삽화를 그렸어요. 기하학에 몰두하느라 그림을 소홀히 했다는 이야기도 전해요.","unit":"중2 닮음","classroom":"황금비를 소개할 때 다빈치가 삽화를 그린 『신성한 비례』 이야기로 수업을 열어 보세요.","art":"golden","event":"1736년 오늘, 자오선 1도의 길이를 재려고 모페르튀이가 이끄는 원정대가 됭케르크를 떠나 라플란드로 향했어요.","born":[{"year":"1588","name":"Étienne Pascal","slug":"Pascal_Etienne"},{"year":"1860","name":"D'Arcy Thompson","slug":"Thompson_DArcy"},{"year":"1866","name":"William McFadden Orr","slug":"Orr"},{"year":"1884","name":"John Raymond Wilton","slug":"Wilton"},{"year":"1885","name":"Mauro Picone","slug":"Picone"},{"year":"1901","name":"Édouard Zeckendorf","slug":"Zeckendorf"},{"year":"1902","name":"Kazimierz Zarankiewicz","slug":"Zarankiewicz"},{"year":"1903","name":"Gladys Mackenzie","slug":"Mackenzie"},{"year":"1921","name":"Walter Rudin","slug":"Rudin_Walter"},{"year":"1928","name":"Jacques-Louis Lions","slug":"Lions_Jacques-Louis"},{"year":"1940","name":"Luc Illusie","slug":"Illusie"}],"died":[{"year":"1519","name":"Leonardo da Vinci","slug":"Leonardo"},{"year":"1833","name":"William Morgan","slug":"Morgan_William"},{"year":"1967","name":"Robert Carmichael","slug":"Carmichael"},{"year":"1982","name":"Salomon Bochner","slug":"Bochner"},{"year":"2002","name":"William Tutte","slug":"Tutte"},{"year":"2004","name":"John Hammersley","slug":"Hammersley"},{"year":"2010","name":"Donald Greenspan","slug":"Greenspan_Donald"},{"year":"2010","name":"Clive William Kilmister","slug":"Kilmister"}]},{"date":"05-03","slug":"Volterra","kind":"born","year":"1860","life":"1860–1940","name":"Vito Volterra","nameKo":"비토 볼테라","title":"적분방정식 연구로 이름난 볼테라","body":"비토 볼테라는 편미분방정식과 특히 적분방정식 연구로 유명한 이탈리아의 수학자예요. 태어난 지 석 달쯤 되었을 때 포탄이 가까이 떨어져 요람이 부서졌지만 기적처럼 살아남았대요. 11살에 르장드르의 기하학 책으로 수학을 시작했고, 13살에는 시간을 잘게 나누는 방법으로 삼체 문제에 도전했어요.","unit":"고 적분","classroom":"구분구적법을 배울 때 시간을 잘게 쪼개 문제를 푼 13살 볼테라의 아이디어를 소개해 보세요.","art":"riemann","event":"1849년 오늘, 아서 케일리가 변호사가 되었는데, 그는 14년 동안 법조인으로 일하면서도 수학 논문을 300편 가까이 썼어요.","born":[{"year":"1842","name":"Otto Stolz","slug":"Stolz"},{"year":"1857","name":"Alexander Yule Fraser","slug":"Fraser"},{"year":"1860","name":"Vito Volterra","slug":"Volterra"},{"year":"1916","name":"Aryeh Dvoretzky","slug":"Dvoretzky"},{"year":"1924","name":"Isadore Singer","slug":"Singer"}],"died":[{"year":"1885","name":"Ferdinand Minding","slug":"Minding"},{"year":"1988","name":"Lev Pontryagin","slug":"Pontryagin"},{"year":"1988","name":"Abraham Seidenberg","slug":"Seidenberg"},{"year":"2019","name":"Goro Shimura","slug":"Shimura"},{"year":"2023","name":"Vicky Neale","slug":"Neale"}]},{"date":"05-04","slug":"Barrow","kind":"died","year":"1677","life":"1630–1677","name":"Isaac Barrow","nameKo":"아이작 배로","title":"미분과 적분이 역연산임을 알아본 배로","body":"아이작 배로는 미적분에 매우 가까운 방법으로 접선을 구하는 법을 만든 영국의 수학자예요. 특히 미분과 적분이 서로 거꾸로 된 연산이라는 사실을 처음 알아차린 사람으로 꼽혀요. 유클리드의 『원론』을 쉽게 다듬은 판을 펴냈는데, 반세기 동안 표준 교과서로 쓰였어요.","unit":"고 적분","classroom":"미적분의 기본정리를 배울 때 '미분과 적분은 서로 역연산'임을 처음 알아본 배로를 소개해 보세요.","art":"tangent","event":"1935년 오늘, 아인슈타인이 뉴욕타임스에 편지를 보내 3주 전 세상을 떠난 에미 뇌터를 가장 뛰어난 창조적 수학 천재로 기렸어요.","born":[{"year":"1733","name":"Jean-Charles de Borda","slug":"Borda"},{"year":"1840","name":"Jakob Rebstein","slug":"Rebstein"},{"year":"1845","name":"William Clifford","slug":"Clifford"},{"year":"1876","name":"Heinrich Jung","slug":"Jung"},{"year":"1888","name":"Raymond Butchart","slug":"Butchart"},{"year":"1916","name":"Elliott Montroll","slug":"Montroll"},{"year":"1918","name":"George Carrier","slug":"Carrier"},{"year":"1932","name":"J Edward Nelson","slug":"Nelson_Edward"}],"died":[{"year":"1615","name":"Adriaan van Roomen","slug":"Roomen"},{"year":"1677","name":"Isaac Barrow","slug":"Barrow"},{"year":"1768","name":"Charles-Étienne Camus","slug":"Camus"},{"year":"1859","name":"Joseph Gergonne","slug":"Gergonne"},{"year":"1936","name":"Alfred Dixon","slug":"Dixon"},{"year":"1961","name":"Herbert Turnbull","slug":"Turnbull"},{"year":"1974","name":"Otton Nikodym","slug":"Nikodym"},{"year":"1974","name":"Marceli Stark","slug":"Stark"}]},{"date":"05-05","slug":"Faulhaber","kind":"born","year":"1580","life":"1580–1635","name":"Johann Faulhaber","nameKo":"요한 파울하버","title":"거듭제곱의 합 공식을 파고든 파울하버","body":"요한 파울하버는 직조공으로 일하다 수학 실력을 인정받아 울름시의 수학자이자 측량사가 된 독일 사람이에요. 브리그스의 로그표를 독일어로 처음 펴냈고, 자연수의 거듭제곱의 합 연구로 유명해요. 1631년 책에서 $N=\\frac{n(n+1)}{2}$을 이용해 홀수 거듭제곱의 합을 17제곱