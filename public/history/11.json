[{"date":"11-01","slug":"Porta","kind":"born","year":"1535","life":"1535–1615","name":"Giambattista della Porta","nameKo":"잠바티스타 델라 포르타","title":"암호와 광학을 연구한 델라 포르타","body":"델라 포르타는 이탈리아 나폴리의 학자로, 암호와 광학을 연구했어요. 스물세 살에 펴낸 『자연 마술』에서 자석, 카메라 옵스큐라(바늘구멍 사진기의 원리) 같은 다양한 주제를 다뤘어요. 망원경을 자기가 먼저 발명했다고 주장했지만, 갈릴레이보다 먼저 만든 흔적은 없다고 해요.","unit":"공통","classroom":"글자를 몇 칸씩 밀어 쓰는 간단한 암호를 만들고 풀어 보며, 규칙 찾기도 수학적 사고임을 느끼게 해 보세요.","art":"letter","event":"1884년 오늘, 국제 자오선 회의에서 경도 15°마다 놓인 24개의 표준 자오선으로 시각의 기준을 정했어요.","born":[{"year":"1535","name":"Giambattista della Porta","slug":"Porta"},{"year":"1864","name":"Ludwig Schlesinger","slug":"Schlesinger"},{"year":"1874","name":"Robert d'Adhémar","slug":"DAdhemar"},{"year":"1913","name":"Andrzej Mostowski","slug":"Mostowski"},{"year":"1919","name":"Hermann Bondi","slug":"Bondi"},{"year":"1920","name":"Ambrose Rogers","slug":"Rogers"},{"year":"1926","name":"James Serrin","slug":"Serrin"},{"year":"1942","name":"Vitaly Vitalievich Fedorchuk","slug":"Fedorchuk"}],"died":[{"year":"1922","name":"Fritz (Friedrich) Bützberger","slug":"Butzberger"},{"year":"1962","name":"Thomas MacRobert","slug":"MacRobert"},{"year":"1971","name":"Leonard Jimmie Savage","slug":"Savage"},{"year":"2000","name":"Ruth Michler","slug":"Michler"},{"year":"2022","name":"Geoffrey Howson","slug":"Howson"}]},{"date":"11-02","slug":"Boole","kind":"born","year":"1815","life":"1815–1864","name":"George Boole","nameKo":"조지 불","title":"논리를 대수 계산으로 바꾼 조지 불","body":"조지 불은 논리를 간단한 대수 계산으로 바꿔 수학 안으로 끌어들인 영국 수학자예요. 구두 수선공의 아들로 대학에 가지 못했지만 언어와 수학을 독학했고, 열여섯 살부터 보조 교사로 일했어요. 1849년 아일랜드 코크의 퀸스 칼리지 첫 수학 교수가 되어 평생 헌신적인 교사로 존경받았어요.","unit":"고 집합과 명제","classroom":"'그리고·또는·아니다'를 참은 1, 거짓은 0으로 두고 계산해 보며 명제와 컴퓨터 회로의 연결을 보여 주세요.","art":"godel","event":"1933년 오늘, 나치 동조자 타이히뮐러가 란다우의 강의 거부를 이끌었고, 결국 란다우는 괴팅겐을 떠나야 했어요.","born":[{"year":"1815","name":"George Boole","slug":"Boole"},{"year":"1826","name":"Henry Smith","slug":"Smith"},{"year":"1871","name":"Poul Heegaard","slug":"Heegaard"},{"year":"1885","name":"Harlow Shapley","slug":"Shapley_Harlow"},{"year":"1892","name":"Tadija Pejovic","slug":"Pejovic"},{"year":"1898","name":"K K Weatherhead","slug":"Weatherhead"},{"year":"1903","name":"Viktor Kupradze","slug":"Kupradze"},{"year":"1911","name":"Raphael Robinson","slug":"Robinson_Raphael"}],"died":[{"year":"1914","name":"Heinrich Burkhardt","slug":"Burkhardt"},{"year":"1954","name":"Henri Fehr","slug":"Fehr"},{"year":"1970","name":"Abram Samoilovitch Besicovitch","slug":"Besicovitch"},{"year":"1993","name":"Đuro Kurepa","slug":"Kurepa"},{"year":"2010","name":"Enrico Magenes","slug":"Magenes"},{"year":"2012","name":"Shreeram Shankar Abhyankar","slug":"Abhyankar"},{"year":"2017","name":"Francis Allotey","slug":"Allotey"}]},{"date":"11-03","slug":"Boyer","kind":"born","year":"1906","life":"1906–1976","name":"Carl Boyer","nameKo":"칼 보이어","title":"미적분 개념의 역사를 쓴 수학사가 보이어","body":"칼 보이어는 미국의 수학사가예요. 원래 고향 근처 고등학교에서 수학과 물리를 가르치는 교사를 꿈꿨고, 대학원에 다니면서도 낮과 밤에 걸쳐 많은 수업을 맡아 가르쳤어요. 1939년 박사 논문을 책으로 펴낸 『미적분의 개념』으로 이름을 알렸고, 이후 다양한 수학사 논문을 썼어요.","unit":"고 미분","classroom":"미분을 처음 배울 때, 이 개념이 오랜 시간에 걸쳐 다듬어졌다는 수학사 이야기를 곁들여 보세요.","art":"textbook","event":"1726년 오늘, 제임스 스털링이 뉴턴의 추천을 받아 왕립학회 회원으로 선출되었어요.","born":[{"year":"1867","name":"Wilhelm Kutta","slug":"Kutta"},{"year":"1878","name":"Arthur Coble","slug":"Coble"},{"year":"1890","name":"Eugenio Togliatti","slug":"Togliatti"},{"year":"1896","name":"Raymond Wilder","slug":"Wilder"},{"year":"1906","name":"Carl Boyer","slug":"Boyer"}],"died":[{"year":"1643","name":"Paul Guldin","slug":"Guldin"},{"year":"1832","name":"John Leslie","slug":"Leslie"},{"year":"1911","name":"George Chrystal","slug":"Chrystal"},{"year":"1918","name":"Aleksandr Mikhailovich Lyapunov","slug":"Lyapunov"},{"year":"1967","name":"Alec Aitken","slug":"Aitken"},{"year":"1972","name":"Sigekatu Kuroda","slug":"Kuroda"},{"year":"1980","name":"Bronisław Knaster","slug":"Knaster"},{"year":"2012","name":"Vasilii Sergeevich Vladimirov","slug":"Vladimirov"}]},{"date":"11-04","slug":"Gleason","kind":"born","year":"1921","life":"1921–2008","name":"Andrew Gleason","nameKo":"앤드루 글리슨","title":"힐베르트 제5문제를 푼 글리슨","body":"앤드루 글리슨은 힐베르트의 제5문제 해결에 핵심 역할을 한 미국 수학자예요. 예일대를 졸업한 뒤 해군에서 일본군 암호를 해독하는 팀에서 일했고, 박사 논문 없이 하버드 교수가 되었어요. 마지막 강의까지 기본 정의를 꼼꼼히 다루는 친절한 강의로 학생들에게 큰 영감을 주었어요.","unit":"공통","classroom":"정의를 정확히 쓰는 습관이 왜 중요한지, 글리슨의 꼼꼼한 마지막 강의 이야기로 수업을 시작해 보세요.","art":"hilbert","event":"1833년 오늘, 해밀턴이 복소수를 실수 두 개의 순서쌍으로 나타내는 논문을 아일랜드 왕립학술원에서 발표했어요.","born":[{"year":"1744","name":"Johann(III) Bernoulli","slug":"Bernoulli_Johann(III)"},{"year":"1765","name":"Pierre-Simon Girard","slug":"Girard_Pierre"},{"year":"1908","name":"Viktor Vladimirovich Vagner","slug":"Vagner"},{"year":"1921","name":"Andrew Gleason","slug":"Gleason"}],"died":[{"year":"1652","name":"Jan-Karel della Faille","slug":"La_Faille"},{"year":"1698","name":"Erasmus Bartholin","slug":"Bartholin"},{"year":"1954","name":"Archibald Richardson","slug":"Richardson_Archibald"},{"year":"1958","name":"Gilbert Walker","slug":"Walker_Gilbert"},{"year":"1986","name":"Kurt Hirsch","slug":"Hirsch"},{"year":"2000","name":"Ian Sneddon","slug":"Sneddon"}]},{"date":"11-05","slug":"Glaisher","kind":"born","year":"1848","life":"1848–1928","name":"James Whitbread Lee Glaisher","nameKo":"제임스 글레이셔","title":"수표 계산과 수학사를 연구한 글레이셔","body":"제임스 글레이셔는 케임브리지에서 평생 가르친 영국의 수학자이자 천문학자예요. 천문학, 수치표 계산, 정수론, 수학사에 관해 400편이 넘는 글을 썼어요. 특히 십진 소수와 로그가 처음 등장한 역사, 그리고 덧셈·뺄셈 기호 +, −의 역사를 연구했고, 정수를 제곱수의 합으로 나타내는 문제도 다뤘어요.","unit":"중1 정수와 유리수","classroom":"+, − 기호가 처음부터 있던 게 아니라는 이야기로 정수의 덧셈과 뺄셈 단원을 열어 보세요.","art":"log","event":"1828년 오늘, 22살의 드모르간이 런던 대학교 첫 수학 교수로서 첫 강의를 했어요.","born":[{"year":"1848","name":"James Whitbread Lee Glaisher","slug":"Glaisher"},{"year":"1866","name":"Alfred Tauber","slug":"Tauber"},{"year":"1872","name":"John Meiklejohn","slug":"Meiklejohn"},{"year":"1899","name":"Karl Dörge","slug":"Dorge"},{"year":"1916","name":"Edmund Hlawka","slug":"Hlawka"},{"year":"1930","name":"Frank Adams","slug":"Adams_Frank"},{"year":"1952","name":"Bob Thomason","slug":"Thomason"}],"died":[{"year":"1526","name":"Scipione del Ferro","slug":"Ferro"},{"year":"1800","name":"Jesse Ramsden","slug":"Ramsden"},{"year":"1879","name":"James Clerk Maxwell","slug":"Maxwell"},{"year":"1934","name":"Walther von Dyck","slug":"Von_Dyck"},{"year":"1981","name":"Stanisław Mazur","slug":"Mazur"},{"year":"1995","name":"Bob Thomason","slug":"Thomason"},{"year":"2009","name":"Chandra Kintala","slug":"Kintala"}]},{"date":"11-06","slug":"Lehmer_Emma","kind":"born","year":"1906","life":"1906–2007","name":"Emma Lehmer","nameKo":"에마 레머","title":"정수론의 상호법칙을 연구한 에마 레머","body":"에마 레머는 러시아에서 태어나 미국에서 활동한 수학자로, 대수적 정수론의 상호법칙 연구로 알려져 있어요. 버클리 대학에서 공학을 공부하다 수학으로 바꾸었고, 남편 데릭 레머와 함께 수를 연구했어요. 부부가 같은 학과에서 가르칠 수 없다는 규정 때문에 오랫동안 강단에 서지 못했어요.","unit":"중1 소인수분해","classroom":"여성 수학자가 마주한 제도의 벽을 소개하고, 오늘날 무엇이 달라졌는지 학생들과 이야기해 보세요.","art":"primes","event":"1936년 오늘, 마주르가 '스코틀랜드 책'에 153번 문제를 적으며 상품으로 살아 있는 거위를 걸었어요.","born":[{"year":"1781","name":"Giovanni Plana","slug":"Plana"},{"year":"1869","name":"Arthur Bowley","slug":"Bowley"},{"year":"1906","name":"Emma Lehmer","slug":"Lehmer_Emma"},{"year":"1918","name":"Jacy Monteiro","slug":"Monteiro"},{"year":"1943","name":"Eberhard Knobloch","slug":"Knobloch"},{"year":"1966","name":"Laurent Lafforgue","slug":"Lafforgue"}],"died":[{"year":"1656","name":"Jean-Baptiste Morin","slug":"Morin_Jean-Baptiste"},{"year":"1880","name":"Giusto Bellavitis","slug":"Bellavitis"},{"year":"1921","name":"Eduard Gubler","slug":"Gubler"},{"year":"1934","name":"James Gray","slug":"Gray_James"},{"year":"1946","name":"Dunham Jackson","slug":"Jackson_Dunham"},{"year":"1966","name":"Frieda Nugel","slug":"Nugel"},{"year":"1979","name":"Alexander Weinstein","slug":"Weinstein"},{"year":"1993","name":"Georges Reeb","slug":"Reeb"},{"year":"2010","name":"Peter Hilton","slug":"Hilton"},{"year":"2010","name":"Zofia Szmydt","slug":"Szmydt"},{"year":"2025","name":"Bhama Srinivasan","slug":"Srinivasan"}]},{"date":"11-07","slug":"Lagny","kind":"born","year":"1660","life":"1660–1734","name":"Thomas Fantet de Lagny","nameKo":"토마 드 라니","title":"원주율을 120자리까지 계산한 라니","body":"토마 드 라니는 계산 수학으로 이름난 프랑스 수학자예요. 원주율 π를 소수점 아래 120자리까지 계산했고, 사용한 급수가 얼마나 빨리 수렴하는지도 살폈어요. 제곱근과 세제곱근을 빠르게 구하는 방법, 방정식의 근을 차례로 어림해 가는 방법도 연구했어요.","unit":"중3 제곱근과 실수","classroom":"계산기 없이 π를 120자리까지 구했다는 이야기로 무리수의 '끝없이 이어지는 소수'를 실감하게 해 보세요.","art":"pi-digits","event":"1677년 오늘, 핼리가 세인트헬레나섬에서 수성의 태양면 통과를 처음으로 완전히 관측했어요.","born":[{"year":"1660","name":"Thomas Fantet de Lagny","slug":"Lagny"},{"year":"1799","name":"Karl Gräffe","slug":"Graffe"},{"year":"1843","name":"Heinrich Friedrich Weber","slug":"Weber_Heinrich_F"},{"year":"1898","name":"Raphaël Salem","slug":"Salem"},{"year":"1906","name":"Jean Leray","slug":"Leray"},{"year":"1915","name":"Boris Khvedelidze","slug":"Khvedelidze"},{"year":"1918","name":"Mario Fiorentini","slug":"Fiorentini"}],"died":[{"year":"1872","name":"Alfred Clebsch","slug":"Clebsch"},{"year":"1918","name":"Artemas Martin","slug":"Martin"},{"year":"1936","name":"Gury Vasilievich Kolosov","slug":"Kolosov"},{"year":"1939","name":"Ralph Sampson","slug":"Sampson"},{"year":"1944","name":"C Wilhelm Oseen","slug":"Oseen"},{"year":"1968","name":"Aleksandr Osipovich Gelfond","slug":"Gelfond"},{"year":"2016","name":"Wolfgang Gaschütz","slug":"Gaschutz"}]},{"date":"11-08","slug":"Dantzig_George","kind":"born","year":"1914","life":"1914–2005","name":"George Dantzig","nameKo":"조지 댄치그","title":"선형계획법의 심플렉스법을 만든 댄치그","body":"조지 댄치그는 선형계획법을 푸는 심플렉스 알고리즘을 만든 미국 수학자예요. 대학원 시절 수업에 늦게 와 칠판의 두 문제를 숙제로 알고 풀어 냈는데, 알고 보니 통계학의 유명한 미해결 문제였어요. 고등학생 때 아버지가 내 준 수천 개의 기하 문제가 큰 힘이 되었다고 해요.","unit":"고 부등식의 영역","classroom":"부등식의 영역에서 최댓값·최솟값을 구하기 전에, 칠판 숙제를 착각해 난제를 푼 댄치그 일화를 들려주세요.","art":"coordinates","event":"1824년 오늘, 가우스는 삼각형 내각의 합이 180°보다 작다고 가정해도 모순 없는 기하가 생긴다고 편지에 썼어요.","born":[{"year":"1656","name":"Edmond Halley","slug":"Halley"},{"year":"1843","name":"Moritz Pasch","slug":"Pasch"},{"year":"1846","name":"Eugenio Bertini","slug":"Bertini"},{"year":"1848","name":"Gottlob Frege","slug":"Frege"},{"year":"1854","name":"Johannes Robert Rydberg","slug":"Rydberg"},{"year":"1868","name":"Felix Hausdorff","slug":"Hausdorff"},{"year":"1904","name":"William Edge","slug":"Edge"},{"year":"1912","name":"Elgy Johnson","slug":"Johnson_Elgy"},{"year":"1914","name":"George Dantzig","slug":"Dantzig_George"},{"year":"1919","name":"Leopold Schmetterer","slug":"Schmetterer"}],"died":[{"year":"1633","name":"Xu Guang-qi","slug":"Xu_Guangqi"},{"year":"1719","name":"Michel Rolle","slug":"Rolle"},{"year":"1832","name":"Amélie Harlay","slug":"Harlay"},{"year":"1858","name":"George Peacock","slug":"Peacock"},{"year":"1940","name":"Andrei Petrovich Kiselev","slug":"Kiselev"},{"year":"1952","name":"Gino Fano","slug":"Fano"},{"year":"1992","name":"Tatsujiro Shimizu","slug":"Shimizu"},{"year":"2001","name":"Albrecht Fröhlich","slug":"Frohlich"},{"year":"2006","name":"Ernst Selmer","slug":"Selmer"}]},{"date":"11-09","slug":"Banneker","kind":"born","year":"1731","life":"1731–1806","name":"Benjamin Banneker","nameKo":"벤저민 배네커","title":"독학으로 천문 연감을 펴낸 배네커","body":"벤저민 배네커는 천문 연감으로 잘 알려진 미국의 흑인 과학자예요. 스물두 살에 빌린 회중시계를 본떠 나무 시계를 만들었는데, 평생 제대로 종을 쳤다고 해요. 쉰일곱 살에 대수·기하·로그·삼각법을 독학해 일식을 예측했고, 연감 원고를 제퍼슨에게 보내며 노예제 반대를 호소했어요.","unit":"중3 삼각비","classroom":"쉰일곱 살에 삼각법을 독학한 배네커 이야기로, 배움에 늦은 때는 없다고 학생들을 격려해 보세요.","art":"earth","event":"1752년 오늘, 윌리엄 브레이큰리지가 왕립학회 회원이 되었어요.","born":[{"year":"1731","name":"Benjamin Banneker","slug":"Banneker"},{"year":"1842","name":"Giuseppe Basso","slug":"Basso"},{"year":"1846","name":"Mór Réthy","slug":"Rethy"},{"year":"1847","name":"Alberto Castigliano","slug":"Castigliano"},{"year":"1869","name":"Virgil Snyder","slug":"Snyder"},{"year":"1885","name":"Theodor Kaluza","slug":"Kaluza"},{"year":"1885","name":"Hermann Weyl","slug":"Weyl"},{"year":"1889","name":"Izabela Abramowicz","slug":"Abramowicz_Izabela"},{"year":"1905","name":"A Adrian Albert","slug":"Albert_Abraham"},{"year":"1906","name":"Yaroslav Borisovich Lopatynsky","slug":"Lopatynsky"},{"year":"1922","name":"Imre Lakatos","slug":"Lakatos"}],"died":[{"year":"1890","name":"Alexander Yule Fraser","slug":"Fraser"},{"year":"1906","name":"Dorothea Beale","slug":"Beale"},{"year":"1907","name":"Georg Sidler","slug":"Sidler"},{"year":"1942","name":"Graciano Ricalde","slug":"Ricalde"},{"year":"1954","name":"F F P Bisacre","slug":"Bisacre"},{"year":"1966","name":"Daniel Rutherford","slug":"Rutherford"},{"year":"1981","name":"Lois Griffiths","slug":"Griffiths_Lois"},{"year":"1984","name":"Hans Petersson","slug":"Petersson"},{"year":"2012","name":"Serge Mikhalovich Nikolski","slug":"Nikolskii"}]},{"date":"11-10","slug":"Pawlak","kind":"born","year":"1926","life":"1926–2006","name":"Zdzisław Pawlak","nameKo":"즈지스와프 파브와크","title":"폴란드 첫 컴퓨터 개발에 참여한 파브와크","body":"즈지스와프 파브와크는 폴란드의 수학자이자 컴퓨터 과학자예요. 대학 1학년 때 컴퓨터를 설계했고, 폴란드 첫 컴퓨터를 만드는 연구팀에서 일했어요. 전자 회로 부품인 플립플롭으로 0과 1을 같은 확률로 만들어 내는 난수 생성 방법을 연구했고, 이 논문은 폴란드인이 국제 학술지에 낸 첫 컴퓨터 과학 논문으로 꼽혀요.","unit":"중2 확률","classroom":"동전 던지기로 0과 1의 난수표를 만들어 보고, 컴퓨터는 난수를 어떻게 만들지 함께 생각해 보세요.","art":"dice","event":"1618년 오늘, 데카르트는 해석기하학을 떠올리게 한 여러 꿈 가운데 첫 꿈을 꾸었어요.","born":[{"year":"1829","name":"Elwin Christoffel","slug":"Christoffel"},{"year":"1846","name":"Achsah Ely","slug":"Ely"},{"year":"1891","name":"James Cassels","slug":"Cassels_James"},{"year":"1896","name":"Heinz Prüfer","slug":"Prufer"},{"year":"1899","name":"Tomás Rodríguez Bachiller","slug":"Bachiller"},{"year":"1902","name":"Thomas Room","slug":"Room"},{"year":"1926","name":"Zdzisław Pawlak","slug":"Pawlak"}],"died":[{"year":"1683","name":"John Collins","slug":"Collins"},{"year":"1931","name":"Charlotte Angas Scott","slug":"Scott"},{"year":"1970","name":"Heinz Rutishauser","slug":"Rutishauser"},{"year":"1988","name":"Otto Haupt","slug":"Haupt"},{"year":"1990","name":"Mário Schenberg","slug":"Schenberg"},{"year":"1998","name":"Jean Leray","slug":"Leray"},{"year":"2008","name":"Kiyosi Ito","slug":"Ito"},{"year":"2015","name":"Klaus Roth","slug":"Roth_Klaus"},{"year":"2023","name":"William Coppel","slug":"Coppel"}]},{"date":"11-11","slug":"Celsius","kind":"born","year":"1701","life":"1701–1744","name":"Anders Celsius","nameKo":"안데르스 셀시우스","title":"섭씨온도의 주인공 셀시우스","body":"안데르스 셀시우스는 스웨덴의 천문학자이자 물리학자, 수학자예요. 우리가 쓰는 섭씨온도(℃)는 그가 제안한 온도 눈금에서 이름을 따왔어요. 할아버지도 웁살라 대학의 천문학 교수였고, 그 자신은 모페르튀이의 라플란드 원정대에 참여해 위도 1도의 길이를 재는 일에 함께했어요.","unit":"중2 일차함수","classroom":"섭씨를 화씨로 바꾸는 식 $F=1.8C+32$를 일차함수로 보고 기울기와 절편의 뜻을 해석해 보세요.","art":"earth","event":"1675년 오늘, 라이프니츠가 dx, dy, dy/dx 기호를 처음으로 썼어요.","born":[{"year":"1701","name":"Anders Celsius","slug":"Celsius"},{"year":"1729","name":"Louis-Antoine de Bougainville","slug":"Bougainville"},{"year":"1851","name":"Jacques Bertillon","slug":"Bertillon"},{"year":"1904","name":"Henry Whitehead","slug":"Whitehead_Henry"},{"year":"1905","name":"Sigekatu Kuroda","slug":"Kuroda"},{"year":"1911","name":"Caleb Gattegno","slug":"Gattegno"},{"year":"1911","name":"Enzo Martinelli","slug":"Martinelli"}],"died":[{"year":"1933","name":"Mineo Chini","slug":"Chini"},{"year":"1954","name":"Horatio Carslaw","slug":"Carslaw"},{"year":"1957","name":"Ugo Amaldi","slug":"Amaldi"},{"year":"1967","name":"Lester R Ford","slug":"Ford"},{"year":"1985","name":"Mary Simpson","slug":"Simpson_Mary"},{"year":"1992","name":"Alfonso Nápoles Gándara","slug":"Gandara"},{"year":"1997","name":"Menahem Schiffer","slug":"Schiffer"},{"year":"2003","name":"Andrei Andreevich Bolibrukh","slug":"Bolibrukh"}]},{"date":"11-12","slug":"Hua","kind":"born","year":"1910","life":"1910–1985","name":"Hua Loo-Keng","nameKo":"화뤄겅","title":"독학으로 중국 수학을 이끈 화뤄겅","body":"화뤄겅은 정수론에 큰 업적을 남긴 중국 수학자예요. 가난했고 장티푸스 후유증으로 왼쪽 다리가 불편했지만, 독학으로 실력을 쌓아 정식 학위 없이 칭화대학에 초빙되었어요. 영국 케임브리지에서 하디 학파와 함께 워링 문제를 연구했고, 이후 50년 동안 중국 수학을 이끌었어요.","unit":"중1 소인수분해","classroom":"자연수를 제곱수 몇 개의 합으로 나타낼 수 있는지 직접 찾아보며 워링 문제의 맛을 보게 해 보세요.","art":"primes","event":"1936년 오늘, 튜링 기계를 처음 소개한 앨런 튜링의 논문 「계산 가능한 수에 대하여」가 출판되었어요.","born":[{"year":"1825","name":"Mikhail Egorovich Vashchenko-Zakharchenko","slug":"Vashchenko"},{"year":"1835","name":"Charles Méray","slug":"Meray"},{"year":"1842","name":"John William Strutt","slug":"Rayleigh"},{"year":"1901","name":"William Whyburn","slug":"Whyburn_William"},{"year":"1910","name":"Hua Loo-Keng","slug":"Hua"},{"year":"1920","name":"Georges Reeb","slug":"Reeb"},{"year":"1927","name":"Yutaka Taniyama","slug":"Taniyama"},{"year":"1928","name":"Manuel Valdivia","slug":"Valdivia"},{"year":"1948","name":"Gerard Murphy","slug":"Murphy_Gerard"},{"year":"1949","name":"Martin Harvey","slug":"Harvey"}],"died":[{"year":"1944","name":"George Birkhoff","slug":"Birkhoff"},{"year":"2000","name":"Wim Cohen","slug":"Cohen_Wim"}]},{"date":"11-13","slug":"Dehn","kind":"born","year":"1878","life":"1878–1952","name":"Max Dehn","nameKo":"막스 덴","title":"힐베르트 문제를 처음 푼 막스 덴","body":"막스 덴은 힐베르트의 문제들 가운데 가장 먼저 풀린 제3문제를 해결한 독일 수학자예요. 부피가 같은 두 다면체라도 한쪽을 유한 개 조각으로 잘라 다른 쪽으로 다시 맞추는 것이 늘 가능하지는 않다는 것을 보였어요. 위상수학을 체계적으로 정리한 초기의 글도 함께 썼어요.","unit":"중1 입체도형","classroom":"넓이가 같은 다각형은 잘라 붙여 서로 바꿀 수 있지만 입체는 다르다는 점을 칠교놀이와 비교해 보세요.","art":"hilbert","event":"1845년 오늘, 패러데이가 빛과 자기, 전기가 연결되어 있다는 확신을 담은 편지를 존 허셜에게 보냈어요.","born":[{"year":"1786","name":"James Thomson","slug":"Thomson_James"},{"year":"1876","name":"Ernest Wilczynski","slug":"Wilczynski"},{"year":"1878","name":"Max Dehn","slug":"Dehn"},{"year":"1906","name":"Hans Fitting","slug":"Fitting"},{"year":"1920","name":"Kollagunta Ramanathan","slug":"Ramanathan"},{"year":"1922","name":"Ambros Speiser","slug":"Speiser"},{"year":"1927","name":"Albert Bharucha-Reid","slug":"Bharucha-Reid"},{"year":"1950","name":"David Broomhead","slug":"Broomhead"},{"year":"1959","name":"Lene Vestergaard Hau","slug":"Hau"}],"died":[{"year":"1942","name":"Robert Remak","slug":"Remak"},{"year":"1944","name":"Otto Blumenthal","slug":"Blumenthal"},{"year":"2002","name":"Frederick Atkinson","slug":"Atkinson"},{"year":"2013","name":"Gilberto Loibel","slug":"Loibel"},{"year":"2014","name":"Alexander Grothendieck","slug":"Grothendieck"}]},{"date":"11-14","slug":"Apery","kind":"born","year":"1916","life":"1916–1994","name":"Roger Apéry","nameKo":"로제 아페리","title":"ζ(3)이 무리수임을 증명한 아페리","body":"로제 아페리는 $\\zeta(3)=1+\\frac{1}{2^3}+\\frac{1}{3^3}+\\cdots$ 이 무리수임을 증명해 이름을 남긴 프랑스 수학자예요. 어릴 때 또래보다 두 학년이나 앞서 공부할 만큼 뛰어났고, 평생 기하학을 무척 좋아했어요. 무한히 더한 합이 분수로 나타낼 수 없는 수가 된다는 점이 흥미로운 결과예요.","unit":"중3 제곱근과 실수","classroom":"무리수를 배울 때 $\\sqrt2$ 말고도 무한히 더한 합이 무리수가 되는 예로 아페리의 결과를 소개해 보세요.","art":"sum","event":"1673년 오늘, 크리스토퍼 렌이 기사 작위를 받았어요.","born":[{"year":"1845","name":"Ulisse Dini","slug":"Dini"},{"year":"1865","name":"Giuseppe Bagnera","slug":"Bagnera"},{"year":"1882","name":"Robert Lee Moore","slug":"Moore_Robert"},{"year":"1896","name":"Bertram Wilson","slug":"Wilson_Bertram"},{"year":"1916","name":"Roger Apéry","slug":"Apery"},{"year":"1919","name":"Paulette Libermann","slug":"Libermann"},{"year":"1932","name":"Jacques Neveu","slug":"Neveu"}],"died":[{"year":"1716","name":"Gottfried Leibniz","slug":"Leibniz"},{"year":"1798","name":"Naonobu Ajima","slug":"Ajima"},{"year":"1954","name":"Ernst Fischer","slug":"Fischer"},{"year":"1971","name":"Hanna Neumann","slug":"Neumann_Hanna"},{"year":"2006","name":"Gustave Choquet","slug":"Choquet"},{"year":"2014","name":"Evgenii B Dynkin","slug":"Dynkin"}]},{"date":"11-15","slug":"Herschel_William","kind":"born","year":"1738","life":"1738–1822","name":"William Herschel","nameKo":"윌리엄 허셜","title":"음악가에서 천왕성 발견자가 된 허셜","body":"윌리엄 허셜은 독일에서 태어나 영국에서 활동한 음악가 출신 천문학자로, 천왕성을 발견한 것으로 유명해요. 군악대 음악가로 영국에 건너와 악보 필사와 연주로 생계를 꾸렸고, 바스의 교회 오르간 연주자가 되었어요. 음악 이론을 공부하다 수학에 빠져들어, 점점 남는 시간을 수학 공부에 쏟았어요.","unit":"공통","classroom":"음악 이론에서 수학으로 넘어간 허셜처럼, 음의 높이와 줄 길이의 비 사이의 관계를 찾아보는 활동을 해 보세요.","art":"earth","event":"","born":[{"year":"1688","name":"Louis Castel","slug":"Castel"},{"year":"1738","name":"William Herschel","slug":"Herschel_William"},{"year":"1793","name":"Michel Chasles","slug":"Chasles"},{"year":"1794","name":"Franz Adolph Taurinus","slug":"Taurinus"},{"y