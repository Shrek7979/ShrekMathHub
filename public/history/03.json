[{"date":"03-01","slug":"Pell","kind":"born","year":"1611","life":"1611–1685","name":"John Pell","nameKo":"존 펠","title":"펠 방정식에 이름만 남긴 펠","body":"존 펠은 책보다 수많은 편지와 학자들과의 교류로 더 큰 발자취를 남긴 17세기 영국 수학자예요. $y^2=ax^2+1$ 꼴의 '펠 방정식'은 사실 브라마굽타와 바스카라 2세가 먼저 연구했고, 오일러가 이름을 잘못 붙였다는 말도 있어요. 1668년에는 100000까지 모든 정수의 인수표를 펴냈어요.","unit":"중1 소인수분해","classroom":"작은 수로 소인수분해표를 직접 만들어 본 뒤, 펠이 10만까지 인수표를 만든 수고를 상상해 보게 하세요.","art":"primes","event":"1950년 오늘, 클라우스 푹스가 원자폭탄 기밀을 소련에 넘긴 혐의로 런던 법정에 섰어요.","born":[{"year":"1597","name":"Jan-Karel della Faille","slug":"La_Faille"},{"year":"1611","name":"John Pell","slug":"Pell"},{"year":"1864","name":"George Bryan","slug":"Bryan"},{"year":"1879","name":"Robert Carmichael","slug":"Carmichael"},{"year":"1904","name":"Paul Dubreil","slug":"Dubreil"},{"year":"1912","name":"Kentaro Yano","slug":"Yano"},{"year":"1915","name":"Gustave Choquet","slug":"Choquet"},{"year":"1950","name":"Milojica Jacimovic","slug":"Jacimovic"}],"died":[{"year":"1862","name":"Peter Barlow","slug":"Barlow"},{"year":"1884","name":"Isaac Todhunter","slug":"Todhunter"},{"year":"1908","name":"Heinrich Maschke","slug":"Maschke"},{"year":"1913","name":"Robert Philip","slug":"Philip"},{"year":"1913","name":"Mario Pieri","slug":"Pieri"},{"year":"1978","name":"Kiyoshi Oka","slug":"Oka"},{"year":"2015","name":"Georg Kreisel","slug":"Kreisel"}]},{"date":"03-02","slug":"Matiyasevich","kind":"born","year":"1947","life":"1947–","name":"Yuri Vladimirovich Matiyasevich","nameKo":"유리 마티야세비치","title":"힐베르트의 10번 문제를 푼 마티야세비치","body":"마티야세비치는 러시아의 수학자이자 컴퓨터 과학자예요. 1900년 힐베르트가 내놓은 23개 문제 중 10번째, 곧 '정수 계수 다항방정식이 정수해를 갖는지 판정하는 일반적인 방법이 있는가'에 그런 방법은 없다는 답을 내놓았어요. 학부생 때 이미 중요한 논문을 여러 편 발표했어요.","unit":"공통","classroom":"$2x+3y=12$의 자연수 해를 찾게 한 뒤, 모든 방정식에 통하는 판정법이 있을지 토론해 보세요.","art":"hilbert","event":"1427년 오늘, 알카시가 사마르칸트 학생들을 위한 교과서 『산술의 열쇠』를 완성했어요.","born":[{"year":"1759","name":"Pietro Paoli","slug":"Paoli"},{"year":"1862","name":"Robert Allardice","slug":"Allardice"},{"year":"1910","name":"Charles Pisot","slug":"Pisot"},{"year":"1912","name":"Hugh Dowker","slug":"Dowker"},{"year":"1947","name":"Yuri Vladimirovich Matiyasevich","slug":"Matiyasevich"}],"died":[{"year":"1885","name":"Joseph Serret","slug":"Serret"},{"year":"1962","name":"Charles de la Vallée Poussin","slug":"Vallee_Poussin"},{"year":"1978","name":"Edward Begle","slug":"Begle"},{"year":"2009","name":"Jacob T Schwartz","slug":"Schwartz_Jacob"},{"year":"2020","name":"Vera Pless","slug":"Pless"}]},{"date":"03-03","slug":"Cantor","kind":"born","year":"1845","life":"1845–1918","name":"Georg Cantor","nameKo":"게오르크 칸토어","title":"무한에도 크기가 있음을 보인 칸토어","body":"칸토어는 집합론을 세우고 무한의 크기를 비교하는 길을 연 수학자예요. 1873년 유리수를 자연수와 일대일로 짝지을 수 있음을 보였고, 곧이어 실수는 그렇게 짝지을 수 없다는 것을 증명했어요. 박사 학위를 받은 뒤 한동안 베를린의 여학교에서 가르치기도 했어요.","unit":"고 집합","classroom":"자연수와 짝수를 일대일로 짝지어 보며 '부분과 전체의 개수가 같을 수 있을까?'를 함께 생각해 보세요.","art":"infinity","event":"1702년 오늘, 열네 살 로버트 심슨이 글래스고 대학에 입학했고, 훗날 이곳의 수학 교수가 되었어요.","born":[{"year":"1838","name":"George Hill","slug":"Hill"},{"year":"1845","name":"Georg Cantor","slug":"Cantor"},{"year":"1872","name":"Wilhelm Ahrens","slug":"Ahrens"},{"year":"1878","name":"Georgios Remoundos","slug":"Remoundos"},{"year":"1882","name":"Kazimierz Bartel","slug":"Bartel"},{"year":"1898","name":"Emil Artin","slug":"Artin"},{"year":"1901","name":"Otto Schreier","slug":"Schreier"},{"year":"1912","name":"Andy Guinand","slug":"Guinand"},{"year":"1916","name":"Paul Halmos","slug":"Halmos"},{"year":"1916","name":"Hans Samelson","slug":"Samelson"},{"year":"1919","name":"Aleksei Vasilevich Pogorelov","slug":"Pogorelov"}],"died":[{"year":"1703","name":"Robert Hooke","slug":"Hooke"},{"year":"1879","name":"William Clifford","slug":"Clifford"},{"year":"1954","name":"Hendrik de Vries","slug":"De_Vries_Hendrik"},{"year":"1988","name":"Sewall Green Wright","slug":"Wright_Sewall"},{"year":"1991","name":"Bill Penney","slug":"Penney"}]},{"date":"03-04","slug":"Lissajous","kind":"born","year":"1822","life":"1822–1880","name":"Jules Lissajous","nameKo":"쥘 리사주","title":"두 사인파로 그린 리사주 도형","body":"리사주는 두 사인파를 합쳐 만든 '리사주 도형'으로 잘 알려진 프랑스 수학자예요. 소리굽쇠에 작은 거울을 붙이고 빛을 반사시켜 진동하는 모습을 화면에 그려 보였어요. 서로 직각으로 떨리는 두 소리굽쇠에 차례로 빛을 반사시키면 아름다운 곡선이 나타났어요.","unit":"고 삼각함수","classroom":"그래핑 도구로 $x=\\sin 2t$, $y=\\sin 3t$를 그려 보며 두 사인파가 만드는 곡선을 관찰하게 하세요.","art":"graph","event":"1675년 오늘, 영국 왕 찰스 2세가 플램스티드를 왕실 천문 관측자로 임명했어요.","born":[{"year":"1822","name":"Jules Lissajous","slug":"Lissajous"},{"year":"1866","name":"Eugène Cosserat","slug":"Cosserat"},{"year":"1871","name":"Boris G Galerkin","slug":"Galerkin"},{"year":"1888","name":"Kazimierz Abramowicz","slug":"Abramowicz"},{"year":"1916","name":"Gilbert Hunt","slug":"Hunt"},{"year":"1962","name":"Claire Voisin","slug":"Voisin"}],"died":[{"year":"1832","name":"Jean-François Champollion","slug":"Champollion"},{"year":"1897","name":"Lajos Martin","slug":"Martin_Lajos"},{"year":"1967","name":"Michel Plancherel","slug":"Plancherel"},{"year":"2000","name":"Hermann Brück","slug":"Bruck"},{"year":"2008","name":"Aleksei Alekseevich Dezin","slug":"Dezin"}]},{"date":"03-05","slug":"Oughtred","kind":"born","year":"1574","life":"1574–1660","name":"William Oughtred","nameKo":"윌리엄 오트레드","title":"곱셈 기호 ×를 만든 오트레드","body":"오트레드는 초기 형태의 계산자(슬라이드 룰)를 발명한 영국의 목사이자 수학자예요. 곱셈 기호 ×와 비례를 나타내는 :: 같은 새로운 기호도 많이 만들었어요. 케임브리지 시절 잠을 줄여 가며 수학을 독학했고, 1631년 귀족 제자를 위해 쓴 『수학의 열쇠』를 펴냈어요.","unit":"중1 문자와 식","classroom":"문자식에서 곱셈 기호를 생략하는 규칙을 배울 때, 이 × 기호를 처음 만든 사람이 오트레드라고 소개해 보세요.","art":"log","event":"1616년 오늘, 가톨릭 교회가 코페르니쿠스의 지동설을 틀린 주장이라고 선언하는 포고를 내렸어요.","born":[{"year":"1512","name":"Gerard Mercator","slug":"Mercator_Gerardus"},{"year":"1574","name":"William Oughtred","slug":"Oughtred"},{"year":"1624","name":"John Collins","slug":"Collins"},{"year":"1779","name":"Benjamin Gompertz","slug":"Gompertz"},{"year":"1817","name":"Angelo Genocchi","slug":"Genocchi"},{"year":"1842","name":"Heinrich Weber","slug":"Weber_Heinrich"},{"year":"1872","name":"Gustave Dumas","slug":"Dumas"},{"year":"1880","name":"Sergei Bernstein","slug":"Bernstein_Sergi"},{"year":"1885","name":"Pauline Sperry","slug":"Sperry"},{"year":"1887","name":"Otto Haupt","slug":"Haupt"},{"year":"1915","name":"Laurent Schwartz","slug":"Schwartz"},{"year":"1917","name":"István Fenyő","slug":"Fenyo"},{"year":"1924","name":"Ottó Steinfeld","slug":"Steinfeld"},{"year":"1931","name":"Vera Pless","slug":"Pless"},{"year":"1937","name":"Ron Book","slug":"Book"},{"year":"1957","name":"David Donoho","slug":"Donoho"},{"year":"1960","name":"'Mamphono Khaketla","slug":"Khaketla"}],"died":[{"year":"1827","name":"Pierre-Simon Laplace","slug":"Laplace"},{"year":"1875","name":"Claude-Louis Mathieu","slug":"Mathieu_Claude"},{"year":"1925","name":"Johan Ludwig Jensen","slug":"Jensen"},{"year":"1927","name":"Franz Mertens","slug":"Mertens"},{"year":"1930","name":"Christine Ladd-Franklin","slug":"Ladd-Franklin"},{"year":"1954","name":"Julian Coolidge","slug":"Coolidge"},{"year":"1973","name":"Margaret Hilary Ashworth Millington","slug":"Millington"},{"year":"1990","name":"Edgar Raymond Lorch","slug":"Lorch_Ray"},{"year":"2013","name":"James Clunie","slug":"Clunie"},{"year":"2018","name":"Clarence Francis Stephens","slug":"Stephens"}]},{"date":"03-06","slug":"Arzela","kind":"born","year":"1847","life":"1847–1912","name":"Cesare Arzelà","nameKo":"체사레 아르첼라","title":"함수의 급수와 적분을 다듬은 아르첼라","body":"아르첼라는 실변수 함수론을 연구한 이탈리아 수학자예요. 1880년 볼로냐 대학 미적분학 교수가 되어, 교수가 모자라 수학 학위도 줄 수 없던 그곳의 수학 교육을 끌어올렸어요. 연속함수들의 급수가 연속함수로 수렴할 조건을 밝히고, 급수를 항별로 적분하는 정리를 증명했어요.","unit":"고 적분","classroom":"정적분을 배운 뒤 '여러 함수를 더한 다음 적분한 값과, 하나씩 적분해서 더한 값이 같을까?'를 물어보세요.","art":"riemann","event":"1689년 오늘, 에드먼드 핼리가 바퀴 네 개 달린 이동식 잠수종 구상을 처음 글로 남겼어요.","born":[{"year":"1847","name":"Cesare Arzelà","slug":"Arzela"},{"year":"1866","name":"Ettore Bortolotti","slug":"Bortolotti"},{"year":"1875","name":"Edward Blades","slug":"Blades"},{"year":"1897","name":"Annie Hutton Numbers","slug":"Numbers"},{"year":"1901","name":"Naum Il'ich Akhiezer","slug":"Akhiezer"},{"year":"1935","name":"Helge Tverberg","slug":"Tverberg"}],"died":[{"year":"1866","name":"William Whewell","slug":"Whewell"},{"year":"1939","name":"Ferdinand von Lindemann","slug":"Lindemann"},{"year":"1944","name":"Aleksandr P Kotelnikov","slug":"Kotelnikov"},{"year":"2005","name":"Hans Bethe","slug":"Bethe"}]},{"date":"03-07","slug":"Herschel","kind":"born","year":"1792","life":"1792–1871","name":"John Herschel","nameKo":"존 허셜","title":"천문학과 사진술을 넘나든 존 허셜","body":"존 허셜은 천왕성을 발견한 윌리엄 허셜의 아들로, 천문학과 초기 사진술을 연구한 영국 과학자예요. 대학 시절 피콕, 배비지와 함께 '해석학회'를 만들어 유럽 대륙의 미적분 방법을 영국 대학에 들여오려 했어요. 1813년 졸업 시험에서 1등을 했고, 뒤에 아버지의 천체 관측을 이어받았어요.","unit":"고 미분","classroom":"$\\frac{dy}{dx}$ 같은 미분 기호를 소개하며, 허셜과 친구들이 왜 대륙의 방법을 들여오려 했는지 이야기해 보세요.","art":"earth","event":"1737년 오늘, 오일러가 연분수에 관한 논문을 상트페테르부르크 학술원에 발표했어요.","born":[{"year":"1792","name":"John Herschel","slug":"Herschel"},{"year":"1824","name":"Delfino Codazzi","slug":"Codazzi"},{"year":"1870","name":"Ernst Lindelöf","slug":"Lindelof"},{"year":"1886","name":"Geoffrey Taylor","slug":"Taylor_Geoffrey"},{"year":"1893","name":"Anna Mullikin","slug":"Mullikin"},{"year":"1895","name":"Wilhelm Süss","slug":"Suss"},{"year":"1899","name":"Maximilian Herzberger","slug":"Herzberger"},{"year":"1899","name":"Henri Mineur","slug":"Mineur"},{"year":"1905","name":"John Whittaker","slug":"Whittaker_John"},{"year":"1919","name":"Lars Gårding","slug":"Garding"},{"year":"1922","name":"Olga Alexandrovna Ladyzhenskaya","slug":"Ladyzhenskaya"},{"year":"1928","name":"Norman Routledge","slug":"Routledge"}],"died":[{"year":"1889","name":"Angelo Genocchi","slug":"Genocchi"},{"year":"1922","name":"Axel Thue","slug":"Thue"},{"year":"1943","name":"Patrick Hardie","slug":"Hardie_Patrick"},{"year":"1958","name":"John Womersley","slug":"Womersley"},{"year":"1964","name":"Samuel Wilks","slug":"Wilks"},{"year":"1966","name":"Georg Faber","slug":"Faber"},{"year":"1984","name":"Charles Pisot","slug":"Pisot"},{"year":"2008","name":"David Gale","slug":"Gale"},{"year":"2011","name":"Mikhail Iosiphovich Kadets","slug":"Kadets"},{"year":"2015","name":"Daniel Akyeampong","slug":"Akyeampong"}]},{"date":"03-08","slug":"Chrystal","kind":"born","year":"1851","life":"1851–1911","name":"George Chrystal","nameKo":"조지 크리스털","title":"명저 『대수학』을 쓴 크리스털","body":"크리스털은 1889년에 완성한 두 권짜리 『대수학』으로 오늘날까지 기억되는 스코틀랜드 수학자예요. 케임브리지에서 맥스웰의 지도를 받으며 옴의 법칙을 실험으로 검증하는 연구도 했어요. 평생 교육 개혁에 힘써 스코틀랜드의 교육 제도를 세우는 데 큰 역할을 했어요.","unit":"공통","classroom":"좋은 교과서의 조건을 학생들과 이야기하며, 한 권의 대수학 책이 오랫동안 교사들의 길잡이가 된 예로 소개해 보세요.","art":"textbook","event":"","born":[{"year":"1566","name":"Giuseppe Biancani","slug":"Biancani"},{"year":"1788","name":"William Hamilton","slug":"Hamilton_William"},{"year":"1851","name":"George Chrystal","slug":"Chrystal"},{"year":"1865","name":"Ernest Vessiot","slug":"Vessiot"},{"year":"1920","name":"George Batchelor","slug":"Batchelor"},{"year":"1928","name":"Martin Davis","slug":"Davis"},{"year":"1938","name":"Don Carlson","slug":"Carlson"},{"year":"1967","name":"Ruth Michler","slug":"Michler"}],"died":[{"year":"1688","name":"Honoré Fabri","slug":"Fabri"},{"year":"1949","name":"Jules Drach","slug":"Drach"},{"year":"1974","name":"Olive Clio Hazlett","slug":"Hazlett"},{"year":"1985","name":"Louis Goodstein","slug":"Goodstein"},{"year":"1988","name":"George McVittie","slug":"McVittie"},{"year":"2002","name":"George Carrier","slug":"Carrier"}]},{"date":"03-09","slug":"Lovasz","kind":"born","year":"1948","life":"1948–","name":"Laszlo Lovász","nameKo":"라슬로 로바스","title":"조합론으로 아벨상을 받은 로바스","body":"로바스는 조합론 연구로 2021년 아벨상을 받은 헝가리 수학자예요. 열네 살 때 에르되시의 글을 스무 번 넘게 읽을 만큼 빠져들었고, 1964년부터 3년 연속 국제수학올림피아드 금메달을 땄어요. 열일곱 살에 그래프 이론에 관한 첫 논문을 발표했어요.","unit":"고 경우의 수","classroom":"한붓그리기 문제를 풀게 하면서, 점과 선으로 이루어진 그래프를 평생 연구한 수학자로 로바스를 소개해 보세요.","art":"graph","event":"1736년 오늘, 오일러가 단치히 시장에게서 쾨니히스베르크 다리 문제를 풀어 달라는 편지를 받았어요.","born":[{"year":"1818","name":"Ferdinand Joachimsthal","slug":"Joachimsthal"},{"year":"1840","name":"Olaus Henrici","slug":"Henrici"},{"year":"1852","name":"Constantin Le Paige","sl